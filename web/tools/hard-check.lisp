; REL.1e: механическая проверка уровня «сложно» — сработал ли нетривиальный алгоритм
; и сколько задача считается (медиана 3 повторов в прогретом процессе).
; Вызывается из web/tools/check-hard.ts; печатает строки "@@id ok|fail причина время".

(define (hc-rules e acc)
  (cond ((not (list? e)) acc)
        ((and (= (length e) 8) (string? (nth e 1)) (symbol? (car e)))
         (hc-rules (nth e 6) (cons (to-string (car e)) acc)))
        (else (foldl (lambda (a x) (hc-rules x a)) acc e))))

(define (hc-once s)
  (try (capture-step-log (lambda () (math-eval s)) 'full) (lambda (err) #f)))

(define (hc-ms s)
  (math-reset)
  (let ((t0 (clock-us)))
    (math-eval s)
    (quotient (- (clock-us) t0) 1000)))

(define (hc-median3 s)
  (let* ((a (hc-ms s)) (b (hc-ms s)) (c (hc-ms s)))
    (cond ((and (<= a b) (<= b c)) b)
          ((and (<= b a) (<= a c)) a)
          ((and (<= a c) (<= c b)) c)
          ((and (<= c a) (<= a b)) a)
          ((and (<= b c) (<= c a)) c)
          (else b))))

(define (hc-rule-prefix? rules prefixes)
  (any? (lambda (r) (any? (lambda (p) (and (>= (string-length r) (string-length p))
                                           (equal? (substring r 0 (string-length p)) p)))
                          prefixes))
        rules))

; --- условия на вход ---
(define (hc-probe-raw id s)
  (display "@@") (display id) (display " ")
  (let ((t0 (clock-us)))
    (let ((lg (hc-once s)))
      (display (quotient (- (clock-us) t0) 1000)) (display " ")
      (display (if lg (hc-rules lg '()) 'err)) (newline))))

(define (hc-ast s) (math-read s))
(define (hc-head s) (let ((a (hc-ast s))) (and (pair? a) (car a))))
(define (hc-vars e)
  (cond ((symbol? e) (list e))
        ((pair? e) (foldl (lambda (a x) (hc-union a (hc-vars x))) '() e))
        (else '())))
(define (hc-union a b) (foldl (lambda (acc x) (if (member? x acc) acc (cons x acc))) a b))
(define (hc-main-var s)
  (let ((vs (filter (lambda (v) (not (member? v '(+ - * / ^ = < > <= >= m-vector list)))) (hc-vars (hc-ast s)))))
    (cond ((member? 'x vs) 'x) ((null? vs) 'x) (else (car vs)))))
(define (hc-digits n)
  (if (number? n) (string-length (to-string (abs (simplify n)))) 0))

; период цепной дроби √n (n не квадрат)
(define (hc-cf-period n)
  (let* ((a0 (integer-root n))
         (start (list 0 1 a0 0)))
    (if (= (* a0 a0) n) 0
        (let loop ((m 0) (d 1) (a a0) (k 0))
          (let* ((m1 (- (* d a) m))
                 (d1 (quotient (- n (* m1 m1)) d))
                 (a1 (quotient (+ a0 m1) d1))
                 (k1 (+ k 1)))
            (if (= a1 (* 2 a0)) k1 (loop m1 d1 a1 k1)))))))

(define (integer-root n)
  (let loop ((x n))
    (let ((y (quotient (+ x (quotient n x)) 2)))
      (if (< y x) (loop y) x))))

; --- проверки ---
(define (hc-ok id ms) (display "@@") (display id) (display " ok ") (display ms) (newline))
(define (hc-bad id why) (display "@@") (display id) (display " fail ") (display why) (newline))

(define (hc-rule id input prefixes)
  (let* ((lg (hc-once input)))
    (if (not lg)
        (hc-bad id "не вычислилось")
        (let ((rules (hc-rules lg '())))
          (if (not (hc-rule-prefix? rules prefixes))
              (hc-bad id (string-append "нет правила " (to-string prefixes) " в " (to-string rules)))
              (let ((ms (hc-median3 input)))
                (if (< ms 30)
                    (hc-bad id (string-append "быстро " (to-string ms) " мс"))
                    (hc-ok id ms))))))))

(define (hc-head-only id input head)
  (if (not (equal? (hc-head input) head))
      (hc-bad id (string-append "не та голова " (to-string (hc-head input))))
      (let ((ms (hc-median3 input)))
        (if (< ms 30)
            (hc-bad id (string-append "быстро " (to-string ms) " мс"))
            (hc-ok id ms)))))

(define (hc-head-digits id input head need)
  (if (not (equal? (hc-head input) head))
      (hc-bad id "не та голова")
      (let* ((ast (hc-ast input))
             (n (simplify (nth ast 1)))
             (dg (hc-digits n)))
        (if (< dg need)
            (hc-bad id (string-append "цифр " (to-string dg) " < " (to-string need)))
            (let ((ms (hc-median3 input)))
              (if (< ms 30)
                  (hc-bad id (string-append "быстро " (to-string ms) " мс"))
                  (hc-ok id ms)))))))

(define (hc-head-degree id input head need)
  (if (not (equal? (hc-head input) head))
      (hc-bad id "не та голова")
      (let* ((ast (hc-ast input))
             (arg (nth ast 1))
             (v (hc-main-var input))
             (dg (try (degree arg v) (lambda (e) 0))))
        (if (< dg need)
            (hc-bad id (string-append "степень " (to-string dg) " < " (to-string need)))
            (let ((ms (hc-median3 input)))
              (if (< ms 30)
                  (hc-bad id (string-append "быстро " (to-string ms) " мс"))
                  (hc-ok id ms)))))))

(define (hc-head-period id input head need)
  (if (not (equal? (hc-head input) head))
      (hc-bad id "не та голова")
      (let* ((ast (hc-ast input))
             (n (simplify (nth ast 1)))
             (per (hc-cf-period n)))
        (if (< per need)
            (hc-bad id (string-append "период " (to-string per) " < " (to-string need)))
            (let ((ms (hc-median3 input)))
              (if (< ms 30)
                  (hc-bad id (string-append "быстро " (to-string ms) " мс"))
                  (hc-ok id ms)))))))

; ST.3а-1: шаги ОДУ первого порядка — классификация, метод с данными, проверка и отказ.

(define (ost-text thunk level)
  (let ((r (capture-step-log thunk level 'ru)))
    (steps-text (cadr r) (caddr r) 'ru)))
(define (ost-lines s) (+ 1 (length (filter (lambda (c) (equal? c "\n")) (string->list s)))))
(define (ost-has? s sub) (string-contains? s sub))
(define (ost-rules thunk) (step-rules (cadr (capture-step-log thunk))))
(define (ost-method r) (nth r 12))

(deftest "ОДУ 1-го порядка: y′ + y = x — линейное, μ и реальная проверка"
  (let* ((eq '(= (+ (diff y x) y) x))
         (eq* '(= (+ (diff (y x) x) (y x)) x))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ode-status r) 'ok)
    (assert-equal (ost-method r) 'linear)
    (assert-equal (nth r 14) #t)
    (assert-true (member? 'ode-classify rs))
    (assert-true (member? 'ode-fo-linear rs))
    (assert-true (member? 'ode-check rs))
    (assert-true (ost-has? s "линейное по y и производным"))
    (assert-true (ost-has? s "∫P dx"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))
    (assert-equal (dsolve-check eq* (car (ode-solutions r)) '(y x)) #t)
    ; подделка решения отвергается
    (assert-equal (dsolve-check eq* '(= (y x) (* x (exp (* -1 x)))) '(y x)) #f)))

(deftest "ОДУ 1-го порядка: y′ = y² — Бернулли, автономное, особое y = 0 проверено"
  (let* ((eq '(= (diff y x) (^ y 2)))
         (eq* '(= (diff (y x) x) (^ (y x) 2)))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'bernoulli)
    (assert-equal (length (ode-solutions r)) 1)
    (assert-equal (nth r 8) (list '(= (y x) 0)))
    (assert-true (member? 'ode-fo-bernoulli rs))
    (assert-true (member? 'ode-fo-singular rs))
    (assert-true (ost-has? s "автономное"))
    (assert-true (ost-has? s "Уравнение Бернулли"))
    (assert-true (ost-has? s "n = 2"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))
    (assert-equal (dsolve-check eq* (car (nth r 8)) '(y x)) #t)))

(deftest "ОДУ 1-го порядка: y′ = x/y — разделение переменных и интегралы"
  (let* ((r (dsolve '(= (diff y x) (/ x y)) '(y x)))
         (s (ost-text (lambda () (dsolve '(= (diff y x) (/ x y)) '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve '(= (diff y x) (/ x y)) '(y x))))))
    (assert-equal (ost-method r) 'separable)
    (assert-equal (length (ode-solutions r)) 2)
    (assert-true (member? 'ode-fo-separable rs))
    (assert-true (ost-has? s "Разделение переменных"))
    (assert-true (ost-has? s "g = x"))
    (assert-true (ost-has? s "∫dy/h(y)"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ 1-го порядка: (2xy + 1) + (x² + 2y)y′ = 0 — обе производные и потенциал"
  (let* ((eq '(= (+ (+ (* 2 x y) 1) (* (+ (^ x 2) (* 2 y)) (diff y x))) 0))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'exact)
    (assert-true (member? 'ode-ex-exact rs))
    (assert-true (ost-has? s "Точное уравнение"))
    (assert-true (ost-has? s "M_y ="))
    (assert-true (ost-has? s "N_x ="))
    (assert-true (ost-has? s "F_x = M, F_y = N — проверено"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ 1-го порядка: Клеро y = xy′ + (y′)² — общее и особое с проверкой"
  (let* ((eq '(= y (+ (* x (diff y x)) (^ (diff y x) 2))))
         (eq* '(= (y x) (+ (* x (diff (y x) x)) (^ (diff (y x) x) 2))))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'clairaut)
    (assert-equal (nth r 8) (list '(= (y x) (* -1/4 (^ x 2)))))
    (assert-true (member? 'ode-ex-clairaut rs))
    (assert-true (ost-has? s "Уравнение Клеро"))
    (assert-true (ost-has? s "φ(p) = p"))
    (assert-true (ost-has? s "особое"))
    (assert-true (<= (ost-lines s) 15))
    ; огибающая проверяется подстановкой, подделка отвергается
    (assert-equal (dsolve-check eq* '(= (y x) (* -1/4 (^ x 2))) '(y x)) #t)
    (assert-equal (dsolve-check eq* '(= (y x) (* -1/3 (^ x 2))) '(y x)) #f)))

(deftest "ОДУ 1-го порядка: y′ = sin(xy) — отказ с методами и причиной"
  (let* ((eq '(= (diff y x) (sin (* x y))))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ode-status r) 'unknown)
    (assert-equal (ode-solutions r) '())
    (assert-true (member? 'ode-refuse rs))
    (assert-true (ost-has? s "Решение не найдено"))
    (assert-true (ost-has? s "пробованы"))
    (assert-true (ost-has? s "M_y − N_x"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ: журнал шагов не меняет ответ"
  (let ((eq '(= (+ (diff y x) y) (* (^ y 2) x)))
        (eq2 '(= (+ (diff (diff y x) x) (* -3 (diff y x)) (* 2 y)) (exp x))))
    (assert-equal (dsolve eq '(y x))
                  (car (capture-step-log (lambda () (dsolve eq '(y x))))))
    (assert-equal (dsolve eq '(y x))
                  (car (capture-step-log (lambda () (dsolve eq '(y x))) 'brief 'ru)))
    (assert-equal (dsolve eq2 '(y x))
                  (car (capture-step-log (lambda () (dsolve eq2 '(y x))))))))

; ---------- ST.3а-2: линейные высших порядков, Эйлер, понижение ----------

(deftest "ОДУ 2-го порядка: y″ + y = 0 — характеристический многочлен и ФСР"
  (let* ((eq '(= (+ (diff (diff y x) x) y) 0))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'const-coeff)
    (assert-equal (nth r 14) #t)
    (assert-true (member? 'ode-lo-hom rs))
    (assert-true (ost-has? s "P(λ) = 1 + λ^2"))
    (assert-true (ost-has? s "ФСР: cos(x), sin(x)"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ 2-го порядка: y″ − 3y′ + 2y = eˣ — резонанс, кратность 1"
  (let* ((eq '(= (+ (diff (diff y x) x) (* -3 (diff y x)) (* 2 y)) (exp x)))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'undetermined)
    (assert-true (member? 'ode-lo-undet rs))
    (assert-true (ost-has? s "Метод неопределённых коэффициентов"))
    (assert-true (ost-has? s "λ = 1 (кратность 1 ⇒ резонанс)"))
    (assert-true (ost-has? s "пробное: A*exp(x) + B*x*exp(x)"))
    (assert-true (ost-has? s "- x*exp(x)"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ 2-го порядка: y″ + y = sin x — резонанс, четыре неизвестных"
  (let* ((eq '(= (+ (diff (diff y x) x) y) (sin x)))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief)))
    (assert-equal (ost-method r) 'undetermined)
    (assert-true (ost-has? s "неизвестных коэффициентов: 4"))
    (assert-true (ost-has? s "- 1/2*x*cos(x)"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ 3-го порядка: y‴ − y = 0 — кубический характеристический многочлен"
  (let* ((eq '(= (- (diff (diff (diff y x) x) x) y) 0))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief)))
    (assert-equal (ost-method r) 'const-coeff)
    (assert-equal (length (ode-solutions r)) 1)
    (assert-true (ost-has? s "P(λ) = -1 + λ^3"))
    (assert-true (ost-has? s "ФСР"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ: x²y″ + xy′ − y = 0 — Эйлер–Коши, замена x = e^t"
  (let* ((eq '(= (- (- (* (^ x 2) (diff (diff y x) x)) (* -1 (* x (diff y x)))) y) 0))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'euler)
    (assert-true (member? 'ode-eu-subst rs))
    (assert-true (ost-has? s "замена x = e^t"))
    (assert-true (ost-has? s "R(r) = -1 + r^2"))
    (assert-true (ost-has? s "C2/x"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ: y″ = (y′)² — уравнение без y, замена p = y′"
  (let* ((eq '(= (diff (diff y x) x) (^ (diff y x) 2)))
         (r (dsolve eq '(y x)))
         (s (ost-text (lambda () (dsolve eq '(y x))) 'brief))
         (rs (ost-rules (lambda () (dsolve eq '(y x))))))
    (assert-equal (ost-method r) 'drop-y)
    (assert-true (member? 'ode-re-drop-y rs))
    (assert-true (ost-has? s "Уравнение без y"))
    (assert-true (ost-has? s "p-уравнение"))
    (assert-true (ost-has? s "y = ∫p dx + C2"))
    (assert-true (ost-has? s "подстановка в уравнение даёт 0"))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ: понижение порядка при известном y₁ = eˣ — формула Абеля"
  (let* ((eq '(= (- (diff (diff (y x) x) x) (y x)) 0))
         (r (reduce-order eq '(y x) '(exp x)))
         (s (ost-text (lambda () (reduce-order eq '(y x) '(exp x))) 'brief))
         (rs (ost-rules (lambda () (reduce-order eq '(y x) '(exp x))))))
    (assert-equal (ost-method r) 'reduction)
    (assert-true (member? 'ode-re-known rs))
    (assert-true (ost-has? s "Понижение порядка"))
    (assert-true (ost-has? s "p = a₁/a₂ = 0"))
    (assert-true (ost-has? s "W(y₁, y₂) = 1"))
    (assert-true (dsolve-check eq (car (ode-solutions r)) '(y x)))
    (assert-true (<= (ost-lines s) 15))))

(deftest "ОДУ 2-го порядка: y″ + y′/x + y³ = 0 — отказ с причиной"
  (let* ((eq '(= (+ (diff (diff y x) x) (/ (diff y x) x) (^ y 3)) 0))

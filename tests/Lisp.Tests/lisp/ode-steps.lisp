    (assert-true (<= (ost-lines s) 15))))

; ---------- ST.3а-3: задача Коши, системы, ряды, Лаплас ----------

(deftest "Коши: y″ + y = 0, y(0) = 1, y′(0) = 0 — константы и проверка условий"
  (let* ((eq '(= (+ (diff (diff (y x) x) x) (y x)) 0))
         (conds (list '(= (y 0) 1) '(= (at (diff (y x) x) (= x 0)) 0)))
         (r (apply dsolve (append (list eq '(y x)) conds)))
         (s (ost-text (lambda () (apply dsolve (append (list eq '(y x)) conds))) 'brief))
         (rs (ost-rules (lambda () (apply dsolve (append (list eq '(y x)) conds))))))
    (assert-equal (ode-status r) 'ok)
    (assert-equal (nth r 12) 'const-coeff)
    (assert-true (member? 'ode-ca-consts rs))
    (assert-true (member? 'ode-ca-check rs))
    (assert-true (ost-has? s "Константы из начальных условий"))
    (assert-true (ost-has? s "Проверка начальных условий"))
    (assert-true (ost-has? s "cos(x)"))
    (assert-true (<= (ost-lines s) 15))
    ; подделка решения не проходит проверку условий
    (assert-equal (dsolve-conditions-check eq '(= (y x) (sin x)) '(y x) conds) #f)))

(deftest "Система: x′ = y, y′ = −x — матрица, λ = ±i и ФСР"
  (let* ((eqs '((= (diff (x t) t) (y t)) (= (diff (y t) t) (* -1 (x t)))))
         (r (dsolve-system eqs '(x y) 't))
         (s (ost-text (lambda () (dsolve-system eqs '(x y) 't)) 'brief))
         (rs (ost-rules (lambda () (dsolve-system eqs '(x y) 't)))))
    (assert-equal (ode-status r) 'ok)
    (assert-true (member? 'ode-sy-matrix rs))
    (assert-true (member? 'ode-sy-basis rs))
    (assert-true (member? 'ode-sy-solution rs))
    (assert-true (member? 'ode-sy-check rs))
    (assert-true (ost-has? s "Матрица системы"))
    (assert-true (ost-has? s "λ = i (кратность 1)"))
    (assert-true (ost-has? s "Решение системы"))
    (assert-true (ost-has? s "Проверка решения системы"))
    (assert-true (ost-has? s "cos(t)"))
    (assert-true (<= (ost-lines s) 15))
    (assert-true (dsolve-system-check eqs (ode-solutions r) '(x y) 't))
    ; подделка (x = cos t, y = sin t) не решает x′ = y — отвергается
    (assert-equal (dsolve-system-check eqs '((= (x t) (cos t)) (= (y t) (sin t))) '(x y) 't) #f)))

(deftest "Система: x′ = x + y, y′ = y — кратное λ = 1, жорданова клетка"
  (let* ((eqs '((= (diff (x t) t) (+ (x t) (y t))) (= (diff (y t) t) (y t))))
         (r (dsolve-system eqs '(x y) 't))
         (s (ost-text (lambda () (dsolve-system eqs '(x y) 't)) 'brief)))
    (assert-equal (ode-status r) 'ok)
    (assert-true (ost-has? s "λ = 1 (кратность 2)"))
    (assert-true (ost-has? s "t*exp(t)"))
    (assert-true (dsolve-system-check eqs (ode-solutions r) '(x y) 't))
    (assert-true (<= (ost-lines s) 15))))

(deftest "Система неоднородная: x′ = y, y′ = −x + 1 — частное и общее"
  (let* ((eqs '((= (diff (x t) t) (y t)) (= (diff (y t) t) (+ (* -1 (x t)) 1))))
         (r (dsolve-system eqs '(x y) 't))
         (s (ost-text (lambda () (dsolve-system eqs '(x y) 't)) 'brief)))
    (assert-equal (ode-status r) 'ok)
    (assert-true (ost-has? s "неоднородная"))
    (assert-true (ost-has? s "x_p"))
    (assert-true (ost-has? s "x(t) = 1 + C1*cos(t)"))
    (assert-true (dsolve-system-check eqs (ode-solutions r) '(x y) 't))
    (assert-true (<= (ost-lines s) 15))))

(deftest "Ряд: Эйри y″ − xy = 0 в обыкновенной точке — Тейлор и сертификат"
  (let* ((eq '(= (- (diff (diff (y x) x) x) (* x (y x))) 0))
         (r (dsolve-series eq '(y x) 0 8))
         (s (ost-text (lambda () (dsolve-series eq '(y x) 0 8)) 'brief))
         (rs (ost-rules (lambda () (dsolve-series eq '(y x) 0 8)))))
    (assert-equal (nth r 12) 'series)
    (assert-true (member? 'ode-se-point rs))
    (assert-true (ost-has? s "обыкновенная"))
    (assert-true (ost-has? s "Ряд Тейлора"))
    (assert-true (ost-has? s "радиус сходимости"))
    (assert-true (member? 'ode-se-recurrence rs))
    (assert-true (ost-has? s "O(u^5)"))
    (assert-true (<= (ost-lines s) 15))
    (assert-true (ode-series-check eq (car (ode-solutions r)) '(y x)))
    ; подделка 2eˣ не решает уравнение Эйри — отвергается
    (assert-equal (ode-series-check eq '(= (y x) (* 2 (exp x))) '(y x)) #f)))

(deftest "Ряд: Бессель ν = 0 — регулярная особая точка, Фробениус с log x"
  (let* ((eq '(= (+ (* (^ x 2) (diff (diff (y x) x) x)) (* x (diff (y x) x)) (* (^ x 2) (y x))) 0))
         (r (dsolve-series eq '(y x) 0 8))
         (s (ost-text (lambda () (dsolve-series eq '(y x) 0 8)) 'brief))
         (rs (ost-rules (lambda () (dsolve-series eq '(y x) 0 8)))))
    (assert-equal (nth r 12) 'frobenius)
    (assert-true (member? 'ode-se-point rs))
    (assert-true (member? 'ode-se-indicial rs))
    (assert-true (ost-has? s "регулярная особая"))
    (assert-true (ost-has? s "Определяющее уравнение"))
    (assert-true (ost-has? s "Ряд Фробениуса"))
    (assert-true (<= (ost-lines s) 15))
    (assert-true (ode-series-check eq (car (ode-solutions r)) '(y x)))))

(deftest "Лаплас: y″ + y = θ(x − 1) — изображение, обратное и проверка"
  (let* ((eq '(= (+ (diff (diff (y x) x) x) (y x)) (heaviside (- x 1))))
         (r (dsolve eq '(y x) :method 'laplace '(= (y 0) 0) '(= (at (diff (y x) x) (= x 0)) 0)))
         (s (ost-text (lambda ()
                        (dsolve eq '(y x) :method 'laplace '(= (y 0) 0)
                                '(= (at (diff (y x) x) (= x 0)) 0)))
                      'brief))
         (rs (ost-rules (lambda ()
                          (dsolve eq '(y x) :method 'laplace '(= (y 0) 0)
                                  '(= (at (diff (y x) x) (= x 0)) 0))))))
    (assert-equal (ode-status r) 'ok)
    (assert-equal (nth r 12) 'laplace)
    (assert-true (member? 'ld-transform rs))
    (assert-true (member? 'ld-ys rs))
    (assert-true (member? 'ld-inverse rs))
    (assert-true (ost-has? s "Преобразованное уравнение"))
    (assert-true (ost-has? s "Изображение Y(s)"))
    (assert-true (ost-has? s "Обратное преобразование"))
    (assert-true (ost-has? s "heaviside"))
    (assert-true (<= (ost-lines s) 15))))

; ST.3а-4: пояснения шагов — формулы входного языка, без внутренних списков и имён
(define (ost-clean? s)
  (not (any? (lambda (t) (ost-has? s t))
             '("%l" "rr" "odK" "%i" "(+ " "(* "))))

(deftest "ST.3а-4: в brief нет внутренних форм: %l, rr, odK, (+ , (* "
  (let* ((ss (map (lambda (th) (ost-text th 'brief))
                  (list
                   (lambda () (dsolve '(= (+ (diff y x) y) x) '(y x)))
                   (lambda () (dsolve '(= (diff y x) (^ y 2)) '(y x)))
                   (lambda () (dsolve '(= (diff y x) (/ x y)) '(y x)))
                   (lambda () (dsolve '(= (+ (+ (* 2 x y) 1) (* (+ (^ x 2) (* 2 y)) (diff y x))) 0) '(y x)))
                   (lambda () (dsolve '(= (diff y x) (+ (^ y 2) 1 (* -1 (^ x 2)))) '(y x)))
                   (lambda () (dsolve '(= y (+ (* x (diff y x)) (^ (diff y x) 2))) '(y x)))
                   (lambda () (dsolve '(= y (+ (* 2 x (diff y x)) (^ (diff y x) 2))) '(y x)))
                   (lambda () (dsolve '(= (+ (diff (diff (y x) x) x) (* -3 (diff (y x) x)) (* 2 (y x))) (exp x)) '(y x)))
                   (lambda () (dsolve '(= (+ (diff (diff (y x) x) x) (y x)) (sin x)) '(y x)))
                   (lambda () (dsolve '(= (+ (diff (diff (y x) x) x) (* -2 (diff (y x) x)) (y x)) (/ (exp x) x)) '(y x)))
                   (lambda () (dsolve '(= (+ (* (^ x 2) (diff (diff (y x) x) x)) (* x (diff (y x) x)) (y x)) 0) '(y x)))
                   (lambda () (reduce-order '(= (+ (- (* x x (diff (diff (y x) x) x)) (* 3 x (diff (y x) x))) (* 4 (y x))) 0) '(y x) '(^ x 2)))
                   (lambda () (dsolve '(= (+ (diff (diff (y x) x) x) (y x)) 0) '(y x) '(= (y 0) 1) '(= (at (diff (y x) x) (= x 0)) 0)))
                   (lambda () (dsolve-series '(= (+ (* (^ x 2) (diff (diff (y x) x) x)) (* x (diff (y x) x)) (* (^ x 2) (y x))) 0) '(y x) 0 8))
                   (lambda () (dsolve-system '((= (diff (x t) t) (y t)) (= (diff (y t) t) (* -1 (x t)))) '(x y) 't))))))
    (assert-true (every? (lambda (s) (ost-clean? s)) ss))
    ; формулы печатаются, а не отбрасываются
    (let ((lin (nth ss 0)) (und (nth ss 7)) (ca (nth ss 12)) (ser (nth ss 13)))
      (assert-true (ost-has? lin "P = 1"))
      (assert-true (ost-has? und "λ = 1 (кратность 1"))
      (assert-true (ost-has? und "пробное: A*exp(x)"))
      (assert-true (ost-has? und "ФСР: exp(x), exp(2x)"))
      (assert-true (ost-has? ca "y′(0) = 0"))
      (assert-true (ost-has? ser "I(r) = r^2")))))


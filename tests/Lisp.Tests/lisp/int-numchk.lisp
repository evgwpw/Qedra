; Шаг INT.NUMCHK: int-check проверяет САМ ответ F численной производной (центральная разность в вещественных
; точках x = 3/10, 71/100 и −3/10), а не только формальную производную int-diff: тождества √(u²) = u,
; √(−a)·√(−b) = √(a·b), верные алгебраически, пропускали ответы, неверные как функции.
; Ответы «г-пилот» — research/intown/numchk-wrong.tsv (движок коммита 73aeacb, как его видел INT.OWN.B13CHK):
; 1500/1495 неверны (у эллиптического члена знак √(−A)√(−B) вместо √A√B), 235/49 — верны.
; Ответы с elliptic-f численной проверкой F не судятся (eval-num берёт главное значение F(φ|m), а формулы Rubi —
; продолжение по периодам): для них 'skip, а неверные отклоняет формальная проверка (она у них 'bad).

(define nr-f1500 '(^ (+ 1 (^ x 8)) -1/2))
(define nr-f1495 '(* (^ x 10) (^ (+ 1 (^ x 8)) -1/2)))
(define nr-f235 '(^ (- a (* b (^ (sinh (+ c (* d x))) 4))) -1))
(define nr-f49 '(* (+ d (* e1 x) (* f (^ x 2)) (* g (^ x 3)) (* h (^ x 4))) (^ (+ 1 (^ x 2) (^ x 4)) -3)))

(define nr-a1500 '(+ (* 1/2 (^ x 3) (^ (+ 1 (^ x 2)) -1) (elliptic-f (asin (* 1/2 (sqrt (* -1 (^ x -2) (+ (^ 2 1/2) (* -2 (^ x 2)) (* (^ 2 1/2) (^ x 4))))))) (^ (* -2 (+ 1 (* -1 (^ 2 1/2)))) 1/2)) (sqrt (* -1 (^ x -2) (^ (+ -1 (* -1 (^ x 2))) 2))) (sqrt (* (^ x -4) (+ 1 (^ x 8)))) (^ (sqrt (+ 1 (^ x 8))) -1) (^ (sqrt (+ 2 (^ 2 1/2))) -1)) (* -1/2 (^ x 3) (^ (+ 1 (* -1 (^ x 2))) -1) (elliptic-f (asin (* 1/2 (sqrt (* (^ x -2) (+ (^ 2 1/2) (* 2 (^ x 2)) (* (^ 2 1/2) (^ x 4))))))) (^ (* -2 (+ 1 (* -1 (^ 2 1/2)))) 1/2)) (sqrt (* (^ x -4) (+ 1 (^ x 8)))) (sqrt (* (^ x -2) (^ (+ -1 (^ x 2)) 2))) (^ (sqrt (+ 1 (^ x 8))) -1) (^ (sqrt (+ 2 (^ 2 1/2))) -1))))

(define nr-a1495 '(+ (* 1/7 (^ x 3) (^ (+ 1 (^ x 8)) 1/2)) (* -3/7 (+ (* -1/2 (^ x 3) (^ (+ 1 (^ x 2)) -1) (elliptic-f (asin (* 1/2 (sqrt (* -1 (^ x -2) (+ (^ 2 1/2) (* -2 (^ x 2)) (* (^ 2 1/2) (^ x 4))))))) (^ (* -2 (+ 1 (* -1 (^ 2 1/2)))) 1/2)) (sqrt (* -1 (^ x -2) (^ (+ -1 (* -1 (^ x 2))) 2))) (sqrt (* (^ x -4) (+ 1 (^ x 8)))) (^ (sqrt (+ 1 (^ x 8))) -1) (^ (sqrt (+ 2 (^ 2 1/2))) -1)) (* -1/2 (^ x 3) (^ (+ 1 (* -1 (^ x 2))) -1) (elliptic-f (asin (* 1/2 (sqrt (* (^ x -2) (+ (^ 2 1/2) (* 2 (^ x 2)) (* (^ 2 1/2) (^ x 4))))))) (^ (* -2 (+ 1 (* -1 (^ 2 1/2)))) 1/2)) (sqrt (* (^ x -4) (+ 1 (^ x 8)))) (sqrt (* (^ x -2) (^ (+ -1 (^ x 2)) 2))) (^ (sqrt (+ 1 (^ x 8))) -1) (^ (sqrt (+ 2 (^ 2 1/2))) -1))))))

(define nr-a235 '(* -1 %i (^ d -1) (+ (* (+ 1/2 (* -1/4 (^ a -1/2) (^ b -1/2) (+ (* -2 a) (* 2 (+ a (* -1 b)))))) (^ (+ a (* -1 b)) -1/2) (^ (+ a (* (^ a 1/2) (^ b 1/2))) -1/2) (atan (* %i (^ (+ a (* -1 b)) 1/2) (^ (+ a (* (^ a 1/2) (^ b 1/2))) -1/2) (^ (cosh (+ c (* d x))) -1) (sinh (+ c (* d x)))))) (* (+ 1/2 (* 1/4 (^ a -1/2) (^ b -1/2) (+ (* -2 a) (* 2 (+ a (* -1 b)))))) (^ (+ a (* -1 (^ a 1/2) (^ b 1/2))) -1/2) (^ (+ a (* -1 b)) -1/2) (atan (* %i (^ (+ a (* -1 (^ a 1/2) (^ b 1/2))) -1/2) (^ (+ a (* -1 b)) 1/2) (^ (cosh (+ c (* d x))) -1) (sinh (+ c (* d x)))))))))

(define nr-a49 '(+ (* 1/12 x (^ (+ 1 (^ x 2) (^ x 4)) -2) (+ d f (* -2 h) (* -1 (^ x 2) (+ d (* -1 h) (* -2 (+ f (* -1 h))))))) (* 1/12 (+ (* -1/6 x (^ (+ 1 (^ x 2) (^ x 4)) -1) (+ (* -6 d) (* -9 f) (* 3 h) (* (^ x 2) (+ (* 11 d) (* -1 f) (* 2 h) (* -2 (+ (* -5 d) (* 10 f) (* -5 h))))))) (* 1/6 (+ (* 1/2 (+ (* (+ (* -1/6 (^ 3 1/2) %i (+ (* -16 d) (* 11 f) (* -7 h) (* 2 (+ (* -5 d) (* 10 f) (* -5 h))) (* 2 (+ (* 5 d) (* -10 f) (* 5 h) (* 5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* -5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* 1/2 (+ (* -16 d) (* 11 f) (* -7 h) (* 2 (+ (* -5 d) (* 10 f) (* -5 h))) (* -5 (+ (* 11 d) (* -1 f) (* 2 h)))))) (log (+ 1/2 (* -1 x) (* 1/2 (^ 3 1/2) %i)))) (* (+ (* 1/6 (^ 3 1/2) %i (+ (* -16 d) (* 11 f) (* -7 h) (* 2 (+ (* -5 d) (* 10 f) (* -5 h))) (* 2 (+ (* 5 d) (* -10 f) (* 5 h) (* 5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* -5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* 1/2 (+ (* -16 d) (* 11 f) (* -7 h) (* 2 (+ (* -5 d) (* 10 f) (* -5 h))) (* -5 (+ (* 11 d) (* -1 f) (* 2 h)))))) (log (+ 1/2 (* -1 x) (* -1/2 (^ 3 1/2) %i)))))) (* 1/2 (+ (* (+ (* -1/6 (^ 3 1/2) %i (+ (* -16 d) (* 11 f) (* -7 h) (* 2 (+ (* -5 d) (* 10 f) (* -5 h))) (* 2 (+ (* 5 d) (* -10 f) (* 5 h) (* 5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* -5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* 1/2 (+ (* 16 d) (* -11 f) (* 7 h) (* -2 (+ (* -5 d) (* 10 f) (* -5 h))) (* 5 (+ (* 11 d) (* -1 f) (* 2 h)))))) (log (+ 1/2 x (* -1/2 (^ 3 1/2) %i)))) (* (+ (* 1/6 (^ 3 1/2) %i (+ (* -16 d) (* 11 f) (* -7 h) (* 2 (+ (* -5 d) (* 10 f) (* -5 h))) (* 2 (+ (* 5 d) (* -10 f) (* 5 h) (* 5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* -5 (+ (* 11 d) (* -1 f) (* 2 h))))) (* 1/2 (+ (* 16 d) (* -11 f) (* 7 h) (* -2 (+ (* -5 d) (* 10 f) (* -5 h))) (* 5 (+ (* 11 d) (* -1 f) (* 2 h)))))) (log (+ 1/2 x (* 1/2 (^ 3 1/2) %i)))))))))) (* 1/2 (+ (* 1/6 (^ (+ 1 (^ x 2) (^ x 4)) -2) (+ e1 (* -2 g) (* (^ x 2) (+ (* 2 e1) (* -1 g))))) (* 1/2 (+ (* 4/9 (^ 3 1/2) (atan (* 1/3 (^ 3 1/2) (+ 1 (* 2 (^ x 2)))))) (* 1/3 (^ (+ 1 (^ x 2) (^ x 4)) -1) (+ 1 (* 2 (^ x 2))))) (+ (* 2 e1) (* -1 g)))))))

; F′ = f численно (проверка самого F) — 'ok / 'bad / 'skip
(define (nr-status F f) (integrate::int-check-F-status F f 'x))

(deftest "int-numchk: неверные ответы г-пилот (ветвь √(−A)√(−B)) отклоняются"
  ; эллиптические: численная проверка F их не судит (продолжение по периодам), отклоняет формальная
  (assert-equal (nr-status nr-a1500 nr-f1500) 'skip)
  (assert-equal (nr-status nr-a1495 nr-f1495) 'skip)
  (assert-equal (integrate::int-check-rubi-formal nr-a1500 nr-f1500 'x) 'bad)
  (assert-equal (integrate::int-check-rubi-formal nr-a1495 nr-f1495 'x) 'bad)
  (assert-true (not (int-check-rubi nr-a1500 nr-f1500 'x)))
  (assert-true (not (int-check-rubi nr-a1495 nr-f1495 'x))))

(deftest "int-numchk: верные ответы г-пилот с %i·atanh и с рациональной частью принимаются"
  (assert-equal (nr-status nr-a235 nr-f235) 'ok)
  (assert-equal (nr-status nr-a49 nr-f49) 'ok)
  (assert-true (int-check-rubi nr-a235 nr-f235 'x))
  (assert-true (int-check-rubi nr-a49 nr-f49 'x)))

(deftest "int-numchk: константа-сдвиг принимается, смена знака члена — отклоняется"
  (let ((f '(^ (+ 1 (^ x 2)) -1)) (F '(atan x)))
    (assert-true (int-check F f 'x))
    (assert-true (int-check (list '+ F 1) f 'x))
    (assert-true (not (int-check (list '* -1 F) f 'x)))))

(deftest "int-numchk: флаг *check-numeric-F* — 'risky (по умолчанию), #f и #t"
  (assert-equal integrate::*check-numeric-F* 'risky)
  (let ((f '(^ (+ 1 (^ x 2)) -1)) (wrong '(* 2 (atan x))) (old integrate::*check-numeric-F*))
    (assert-equal (nr-status wrong f) 'bad)            ; 'risky: голова atan — ветвящаяся
    (set! integrate::*check-numeric-F* #f)
    (assert-equal (nr-status wrong f) 'skip)
    (set! integrate::*check-numeric-F* #t)
    (assert-equal (nr-status wrong f) 'bad)
    (set! integrate::*check-numeric-F* old))
  ; без ветвящихся голов (полином) при 'risky проверка не запускается
  (assert-equal (nr-status '(* 1/2 (^ x 2)) 'x) 'skip))

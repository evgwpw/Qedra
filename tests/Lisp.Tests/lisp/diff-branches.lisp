;; Шаг DIFF.BR: производные обратных/ветвящихся функций совпадают с производной ГЛАВНОЙ ветви (eval-num)
;; во всей комплексной плоскости (кроме самих разрезов): центральная разность eval-num(f) против eval-num(diff f).

(define (dbr-sub e v)
  (cond ((equal? e 'x) v)
        ((pair? e) (map (lambda (t) (dbr-sub t v)) e))
        (else e)))
(define (dbr-re z)
  (cond ((number? z) z)
        ((and (pair? z) (equal? (car z) '+)) (+ (dbr-re (cadr z)) (dbr-re (caddr z))))
        ((and (pair? z) (equal? (car z) '*)) (if (equal? (caddr z) '%i) 0 (* (dbr-re (cadr z)) (dbr-re (caddr z)))))
        (else 0)))
(define (dbr-im z)
  (cond ((number? z) 0)
        ((and (pair? z) (equal? (car z) '+)) (+ (dbr-im (cadr z)) (dbr-im (caddr z))))
        ((and (pair? z) (equal? (car z) '*)) (if (equal? (caddr z) '%i) (cadr z) 0))
        (else 0)))
(define (dbr-pt a b) (list '+ a (list '* b '%i)))
(define dbr-complex-pts
  (list (dbr-pt 0.6 0.8) (dbr-pt -1.2 0.4) (dbr-pt 1.7 -0.9) (dbr-pt -0.5 -1.6) (dbr-pt 3.0 2.0) (dbr-pt -2.5 -0.7)))

;; число точек, где |числ. производная − eval-num(diff f)| / max(1, |.|) > 1e-6
(define (dbr-bad f reals)
  (let ((d (diff 'x f)) (bad 0))
    (for-each
      (lambda (p)
        (let* ((h 0.000001)
               (fp (eval-num (dbr-sub f (dbr-pt (+ (dbr-re p) h) (dbr-im p)))))
               (fm (eval-num (dbr-sub f (dbr-pt (- (dbr-re p) h) (dbr-im p)))))
               (nr (/ (- (dbr-re fp) (dbr-re fm)) (* 2 h)))
               (ni (/ (- (dbr-im fp) (dbr-im fm)) (* 2 h)))
               (a (eval-num (dbr-sub d p)))
               (ar (dbr-re a)) (ai (dbr-im a))
               (err (/ (sqrt (+ (^ (- nr ar) 2) (^ (- ni ai) 2))) (max 1.0 (sqrt (+ (* ar ar) (* ai ai)))))))
          (if (> err 0.000001) (set! bad (+ bad 1)))))
      (append dbr-complex-pts (map (lambda (r) (dbr-pt r 0.0)) reals)))
    bad))

(deftest "diff: главные ветви обратных функций (acosh)" (assert-equal (dbr-bad '(acosh x) '(-3.7 -1.8 2.5)) 0))
(deftest "diff: главные ветви обратных функций (asin)" (assert-equal (dbr-bad '(asin x) '(0.3 -0.4)) 0))
(deftest "diff: главные ветви обратных функций (acos)" (assert-equal (dbr-bad '(acos x) '(0.3 -0.4)) 0))
(deftest "diff: главные ветви обратных функций (atan)" (assert-equal (dbr-bad '(atan x) '(-3.7 2.5 0.3)) 0))
(deftest "diff: главные ветви обратных функций (asinh)" (assert-equal (dbr-bad '(asinh x) '(-3.7 2.5 0.3)) 0))
(deftest "diff: главные ветви обратных функций (atanh)" (assert-equal (dbr-bad '(atanh x) '(-3.7 2.5 0.3)) 0))
(deftest "diff: главные ветви обратных функций (acoth)" (assert-equal (dbr-bad '(acoth x) '(-3.7 2.5 0.3)) 0))
(deftest "diff: главные ветви обратных функций (acot)" (assert-equal (dbr-bad '(acot x) '(-3.7 2.5 0.3)) 0))
(deftest "diff: главные ветви обратных функций (asec)" (assert-equal (dbr-bad '(asec x) '(-3.7 -1.8 2.5)) 0))
(deftest "diff: главные ветви обратных функций (acsc)" (assert-equal (dbr-bad '(acsc x) '(-3.7 -1.8 2.5)) 0))
(deftest "diff: главные ветви обратных функций (asech)" (assert-equal (dbr-bad '(asech x) '(-3.7 -1.8 2.5)) 0))
(deftest "diff: главные ветви обратных функций (acsch)" (assert-equal (dbr-bad '(acsch x) '(-3.7 -0.4 2.5)) 0))
(deftest "diff: главные ветви (sqrt, log, степени)"
  (assert-equal (dbr-bad '(sqrt x) '(-3.7 2.5)) 0)
  (assert-equal (dbr-bad '(log x) '(-3.7 2.5)) 0)
  (assert-equal (dbr-bad '(^ x 1/3) '(-3.7 2.5)) 0)
  (assert-equal (dbr-bad '(^ x -1/2) '(-3.7 2.5)) 0)
  (assert-equal (dbr-bad '(^ x x) '(2.5)) 0)
  (assert-equal (dbr-bad '(sqrt (- 1 (^ x 2))) '(0.3)) 0))
(deftest "diff: acosh не сворачивается в 1/√(x²−1)"
  (assert-equal (diff 'x '(acosh x)) '(* (^ (sqrt (+ -1 x)) -1) (^ (sqrt (+ 1 x)) -1)))
  (assert-true (< (abs (- (dbr-re (eval-num (dbr-sub (diff 'x '(acosh x)) -3.0))) (- 0.0 (/ 1.0 (sqrt 8.0))))) 0.000001)))

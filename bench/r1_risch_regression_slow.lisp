; r1: регрессия алгоритма Риша по эталонным задачам (§1, §2, §10a, §11) — таблица классов и времени.
; Запуск как скрипт (печатает таблицу): src/Lisp.Host/bin/Debug/net10.0/Lisp.exe bench/r1_risch_regression_slow.lisp
; Класс: S — ответ без integrate, проверен int-check (SOLVED); P — частичный ответ (элементарная часть + неэлементарный остаток);
; N — неэлементарно доказано (CLAIMS-NE); U — не вычислено, без претензии на доказательство (UNKNOWN); W — ответ не проходит проверку (WRONG).
; Ожидание — множество допустимых классов; ложное «N» (ожидалось не N) и любое W печатаются с пометкой ***.
; Имя файла со словом slow: в --bench запускается только по явному фильтру (полный прогон — десятки секунд).

; (метка выражение переменная ожидание)
(define rr-cases
  '(
    ; --- §1: классические неэлементарные ---
    ("exp(x^2)" (exp (^ x 2)) x "N")
    ("exp(-x^2)" (exp (* -1 (^ x 2))) x "N")
    ("exp(x)/x" (/ (exp x) x) x "N")
    ("1/log(x)" (/ 1 (log x)) x "N")
    ("exp(exp(x))" (exp (exp x)) x "N")
    ("x^x" (^ x x) x "N")
    ("x^x*log(x)" (* (^ x x) (log x)) x "NP")
    ("x/(1+exp(x))" (/ x (+ 1 (exp x))) x "N")
    ("log(x)/log(1+x)" (/ (log x) (log (+ 1 x))) x "N")
    ("log(log(x))/log(x)" (/ (log (log x)) (log x)) x "N")
    ("exp(x^2)/(exp(x^2)+1)" (/ (exp (^ x 2)) (+ (exp (^ x 2)) 1)) x "NP")
    ("log(x)/(a x^2+b x^3+c x^4)" (/ (log x) (+ (* a (^ x 2)) (* b (^ x 3)) (* c (^ x 4)))) x "NPU")
    ("1/(a+x+log(x))" (/ 1 (+ a x (log x))) x "NU")
    ("erf(x)" (erf x) x "U")
    ("sin(x)/x" (/ (sin x) x) x "NU")
    ("cos(x)/x" (/ (cos x) x) x "NU")
    ("exp(x)/x^2" (/ (exp x) (^ x 2)) x "NP")
    ("exp(1/x)" (exp (/ 1 x)) x "SPNU")
    ; --- §2: элементарные с подвохом ---
    ("x*exp(x)" (* x (exp x)) x "S")
    ("exp(x)" (exp x) x "S")
    ("1+exp(-x)" (+ 1 (exp (* -1 x))) x "S")
    ("2 exp(x) exp(2exp(x))" (* 2 (exp x) (exp (* 2 (exp x)))) x "S")
    ("exp(x) exp(exp(x))" (* (exp x) (exp (exp x))) x "S")
    ("sinh(x) via exp" (+ (/ (exp x) 2) (* -1/2 (exp (* -1 x)))) x "S")
    ("log(x)" (log x) x "S")
    ("log(x^x)" (log (^ x x)) x "S")
    ("log(x^y)" (log (^ x y)) x "SU")
    ("log(sqrt(x))" (log (^ x 1/2)) x "S")
    ("x*x^x*log x + x^x + x*x^x" (+ (* x (^ x x) (log x)) (^ x x) (* x (^ x x))) x "S")
    ("-1/(x log x (log log x)^2)" (/ -1 (* x (log x) (^ (log (log x)) 2))) x "S")
    ("(2L^2-L-x^2)/(L^3-x^2 L), L=log x" (/ (- (* 2 (^ (log x) 2)) (log x) (^ x 2)) (- (^ (log x) 3) (* (^ x 2) (log x)))) x "P")
    ("(1+2x^2+x^4+2x^3 e^(2x^2))/((x^2+1)^2 e^(x^2))"
     (/ (+ 1 (* 2 (^ x 2)) (^ x 4) (* 2 (^ x 3) (exp (* 2 (^ x 2))))) (* (^ (+ (^ x 2) 1) 2) (exp (^ x 2)))) x "P")
    ("Example 6.2.1"
     (* (/ (+ (exp x) (* -1 (^ x 2)) (* 2 x)) (* (^ (+ (exp x) x) 2) (^ x 2)))
        (exp (+ (/ (- (^ x 2) 1) x) (/ 1 (+ (exp x) x))))) x "S")
    ("exp(x+exp(x)) + exp(x-exp(x))" (+ (exp (+ x (exp x))) (exp (- x (exp x)))) x "S")
    ("log(x exp(-x) + 1)" (log (+ 1 (* x (exp (* -1 x))))) x "P")
    ("t0*exp(x)" (* t0 (exp x)) x "S")
    ("0" 0 x "S")
    ("a^x" (^ a x) x "SU")
    ("exp(a x)" (exp (* a x)) x "S")
    ("x exp(a x)" (* x (exp (* a x))) x "S")
    ("x^2 exp(a x)" (* (^ x 2) (exp (* a x))) x "S")
    ("x^y+z (по y)" (+ (^ x y) z) y "SU")
    ("25t^6-... /(25t^6+35t^4+11t^2+1), t=e^x"
     (/ (+ (* 25 (exp (* 6 x))) (* -10 (exp (* 5 x))) (* 7 (exp (* 4 x))) (* -8 (exp (* 3 x))) (* 13 (exp (* 2 x))) (* 2 (exp x)) -1)
        (+ (* 25 (exp (* 6 x))) (* 35 (exp (* 4 x))) (* 11 (exp (* 2 x))) 1)) x "S")
    ; --- ISSAC'98 и прочие ---
    ("(x - tan x)/tan^2 x" (/ (- x (tan x)) (^ (tan x) 2)) x "SU")
    ("x/sqrt(1-x^3)" (/ x (^ (- 1 (^ x 3)) 1/2)) x "N")
    ("sqrt(x) exp(x)" (* (^ x 1/2) (exp x)) x "N")   ; R3.1: x = t², ∫2t²·exp(t²) — erfi
    ("exp(sqrt(x))" (exp (^ x 1/2)) x "SU")
    ("sqrt(log x)" (^ (log x) 1/2) x "N")
    ; --- §10a: контрпримеры ---
    ("exp(x) log(exp(x)+1)" (* (exp x) (log (+ (exp x) 1))) x "SPU")
    ("1/(x^2+1)" (/ 1 (+ (^ x 2) 1)) x "S")
    ("1/(2+cos x)" (/ 1 (+ 2 (cos x))) x "SU")
    ("sin x/(cos x+2)" (/ (sin x) (+ (cos x) 2)) x "SU")
    ("tan x" (tan x) x "SU")
    ("1/sin x" (/ 1 (sin x)) x "SU")
    ("exp(x)/(1+tan x)" (/ (exp x) (+ 1 (tan x))) x "NU")
    ; --- §11: предлагаемый набор ---
    ("x log x" (* x (log x)) x "S")
    ("log^2 x" (^ (log x) 2) x "S")
    ("1/(x log x)" (/ 1 (* x (log x))) x "S")
    ("1/(x log^2 x)" (/ 1 (* x (^ (log x) 2))) x "S")
    ("exp(x)/(1+exp(x))" (/ (exp x) (+ 1 (exp x))) x "S")
    ("1/(1+exp(x))" (/ 1 (+ 1 (exp x))) x "S")
    ("(1+2x^2) exp(x^2)" (* (+ 1 (* 2 (^ x 2))) (exp (^ x 2))) x "S")
    ("(x^2+2x) exp(x)" (* (+ (^ x 2) (* 2 x)) (exp x)) x "S")
    ("x exp(x^2)" (* x (exp (^ x 2))) x "S")
    ("(log x+1) x^x" (* (+ (log x) 1) (^ x x)) x "S")
    ("log(x)/x" (/ (log x) x) x "S")
    ("log(log x)" (log (log x)) x "P")
    ("exp(x) log x" (* (exp x) (log x)) x "NP")
    ("exp(x)/(x+1)" (/ (exp x) (+ x 1)) x "N")
    ("x^3 log x" (* (^ x 3) (log x)) x "S")
    ("log(x)^3" (^ (log x) 3) x "S")
    ("exp(2x)+2+exp(-2x)" (+ (exp (* 2 x)) 2 (exp (* -2 x))) x "S")
    ("exp(x)(log x + 1/x)" (* (exp x) (+ (log x) (/ 1 x))) x "S")
    ("exp(x)(x-1)/x^2 = (exp(x)/x)'" (/ (* (exp x) (+ x -1)) (^ x 2)) x "S")
    ("exp(x)(x^3-x^2+x+1)/(x^2+1)^2" (/ (* (exp x) (+ (^ x 3) (* -1 (^ x 2)) x 1)) (^ (+ (^ x 2) 1) 2)) x "S")
    ("exp(-x)/x" (/ (exp (* -1 x)) x) x "N")
    ("exp(x^2+x)" (exp (+ (^ x 2) x)) x "N")
    ("exp(x^3)" (exp (^ x 3)) x "N")
    ("exp(1/x)/x^2" (/ (exp (/ 1 x)) (^ x 2)) x "SPU")
    ("x^2 exp(x^2)" (* (^ x 2) (exp (^ x 2))) x "NP")
    ("log(x)^2/x^2" (/ (^ (log x) 2) (^ x 2)) x "S")
    ("1/(x log(x)^2 + x)" (/ 1 (+ (* x (^ (log x) 2)) x)) x "S")
    ("log(1+x)/x" (/ (log (+ 1 x)) x) x "NU")
    ("1/(exp(x)+exp(-x))" (/ 1 (+ (exp x) (exp (* -1 x)))) x "SU")
    ("exp(x)/(exp(x)+1)^2" (/ (exp x) (^ (+ (exp x) 1) 2)) x "S")
    ("x exp(x)/(x+1)^2" (/ (* x (exp x)) (^ (+ x 1) 2)) x "S")
    ("log(exp(x)+1)" (log (+ (exp x) 1)) x "NPU")
    ("1/log(x)^2" (/ 1 (^ (log x) 2)) x "P")
    ; --- слепой набор 21k.6 (ответы известны, ложное «N» недопустимо) ---
    ("(x+1) e^x/(x e^x+1) = d log(x e^x+1)" (/ (* (+ x 1) (exp x)) (+ (* x (exp x)) 1)) x "S")
    ("(x+1) e^x/(x e^x+1)^2 = d(-1/(x e^x+1))" (/ (* (+ x 1) (exp x)) (^ (+ (* x (exp x)) 1) 2)) x "S")
    ("2x^3 e^(x^2)/(1+x^2)^2 = d(e^(x^2)/(1+x^2))" (/ (* 2 (^ x 3) (exp (^ x 2))) (^ (+ 1 (^ x 2)) 2)) x "S")
    ("log(x)/(1+x)^2" (/ (log x) (^ (+ 1 x) 2)) x "S")
    ("1/(x log x log log x)" (/ 1 (* x (log x) (log (log x)))) x "S")
    ("e^(2x)/(1+e^x)" (/ (exp (* 2 x)) (+ 1 (exp x))) x "S")
    ("1/(e^x-1)" (/ 1 (- (exp x) 1)) x "S")
    ("(1-x) e^(-x) = d(x e^(-x))" (* (- 1 x) (exp (* -1 x))) x "S")
    ("x e^(-x^2)" (* x (exp (* -1 (^ x 2)))) x "S")
    ("tanh x" (/ (sinh x) (cosh x)) x "SU")
    ("x/(e^x-1)" (/ x (- (exp x) 1)) x "NPU")
    ("x e^x/(1+e^x)" (/ (* x (exp x)) (+ 1 (exp x))) x "NPU")
    ("(e^x-1)/x" (/ (- (exp x) 1) x) x "NP")
    ("e^x/x^3" (/ (exp x) (^ x 3)) x "NP")
    ("1/(x log(x)^2 log(log x))" (/ 1 (* x (^ (log x) 2) (log (log x)))) x "NPU")
    ("log(x)/(x+1)" (/ (log x) (+ x 1)) x "NU")
    ("x^x (log x)^2" (* (^ x x) (^ (log x) 2)) x "NPU")
    ))

(define (rr-has-int? e) (and (pair? e) (or (equal? (car e) 'integrate) (any? rr-has-int? (cdr e)))))

; → (класс результат мс)
(define (rr-run c)
  (let* ((e (nth c 1)) (v (nth c 2)) (t0 (clock-us)))
    (conditions-clear)
    (let* ((r (try (integrate e v) (lambda (err) 'error)))
           (ms (/ (- (clock-us) t0) 1000.0))
           (ne (any? (lambda (cd) (equal? (car (car cd)) 'risch-nonelementary)) (conditions))))
      (list (cond ((equal? r 'error) 'W)
                  ; piecewise (параметры, integrate/param.lisp) — сертификат int-piecewise-check
                  ((and (pair? r) (equal? (car r) 'piecewise)) (if (equal? (int-piecewise-check r e v) 'ok) 'S 'W))
                  ((not (rr-has-int? r)) (if (int-check r e v) 'S 'W))
                  ((equal? r (list 'integrate (simplify e) v)) (if ne 'N 'U))
                  (else (if (int-check r e v) 'P 'W)))
            r ms))))

(define (rr-main)
  (let ((counts '()) (bad '()) (total-ms 0))
    (map (lambda (c)
           (let* ((res (rr-run c)) (cls (car res)) (exp (nth c 3))
                  (ok (and (not (equal? cls 'W)) (string-contains? exp (to-string cls))))
                  (flag (if ok "" (if (equal? cls 'N) " *** ЛОЖНОЕ N?" " *** НЕ СОВПАЛО")))
                  (name (to-string cls)))
             (set! total-ms (+ total-ms (nth res 2)))
             (set! counts (cons cls counts))
             (if (not ok) (set! bad (cons (car c) bad)))
             (display (car c)) (display " | ") (display name) (display " (ожид. ") (display exp) (display ") | ")
             (display (floor (nth res 2))) (display " мс | ") (display (nth res 1)) (display flag) (newline)))
         rr-cases)
    (newline)
    (display "ИТОГО: ") (display (length rr-cases)) (display " примеров")
    (map (lambda (k) (display ", ") (display k) (display "=")
           (display (length (filter (lambda (c) (equal? c k)) counts))))
         '(S P N U W))
    (display ", время ") (display (floor (/ total-ms 1000))) (display " с") (newline)
    (display "расхождения: ") (display bad) (newline)))

(rr-main)

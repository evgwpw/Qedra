; r1: Риш, башни высоты 2 (risch-integrate: только алгоритм Риша, без прежнего каскада)
(risch-integrate '(* (+ 1 (log x)) (^ x x)) 'x)
(risch-integrate '(* (exp x) (exp (exp x))) 'x)
(risch-integrate '(+ (exp (+ x (exp x))) (exp (- x (exp x)))) 'x)
(risch-integrate '(* (+ (* 2 x) 1) (exp x) (exp (^ x 2))) 'x)
(risch-integrate '(* 2 (exp x) (exp (* 2 (exp x)))) 'x)
(risch-integrate '(/ (log (log x)) (log x)) 'x)
(risch-integrate '(/ (log x) (log (+ 1 x))) 'x)
(risch-integrate '(* (exp x) (+ (log x) (/ 1 x))) 'x)
(risch-integrate '(* (atan (exp x)) (exp x) (^ (+ 1 (exp (* 2 x))) -1)) 'x)
(risch-integrate '(/ (exp (^ x 2)) (+ (exp (^ x 2)) 1)) 'x)

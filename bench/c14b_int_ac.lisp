; c14b: интегралы, берущиеся строками int-ac-table (AC.4): (c + k u²)^(±3/2) с суммой параметров
(integrate '(^ (+ 1 (^ x 2)) -3/2) 'x)
(integrate '(^ (+ a b (* 3 (^ x 2))) -3/2) 'x)
(integrate '(^ (+ a b (* -1 (^ x 2))) -3/2) 'x)
(integrate '(^ (+ a b (^ x 2)) 3/2) 'x)
(integrate '(^ (+ 4 (* -1 (^ x 2))) 3/2) 'x)

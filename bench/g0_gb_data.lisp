; g0: системы для бенчмарков базисов Грёбнера (шаг 21i).
; Запускать вместе с задачами: --bench _gb (подстрока имени)
(define gb-katsura4 '((+ x0 (* 2 x1) (* 2 x2) (* 2 x3) -1)
                      (+ (^ x0 2) (* 2 (^ x1 2)) (* 2 (^ x2 2)) (* 2 (^ x3 2)) (* -1 x0))
                      (+ (* 2 x0 x1) (* 2 x1 x2) (* 2 x2 x3) (* -1 x1))
                      (+ (^ x1 2) (* 2 x0 x2) (* 2 x1 x3) (* -1 x2))))
(define gb-katsura5 '((+ x0 (* 2 x1) (* 2 x2) (* 2 x3) (* 2 x4) -1)
                      (+ (^ x0 2) (* 2 (^ x1 2)) (* 2 (^ x2 2)) (* 2 (^ x3 2)) (* 2 (^ x4 2)) (* -1 x0))
                      (+ (* 2 x0 x1) (* 2 x1 x2) (* 2 x2 x3) (* 2 x3 x4) (* -1 x1))
                      (+ (^ x1 2) (* 2 x0 x2) (* 2 x1 x3) (* 2 x2 x4) (* -1 x2))
                      (+ (* 2 x1 x2) (* 2 x0 x3) (* 2 x1 x4) (* -1 x3))))
(define gb-cyclic4 '((+ a b c d) (+ (* a b) (* b c) (* c d) (* d a)) (+ (* a b c) (* b c d) (* c d a) (* d a b))
                     (+ (* a b c d) -1)))
(define gb-cyclic5 '((+ a b c d e) (+ (* a b) (* b c) (* c d) (* d e) (* e a))
                     (+ (* a b c) (* b c d) (* c d e) (* d e a) (* e a b))
                     (+ (* a b c d) (* b c d e) (* c d e a) (* d e a b) (* e a b c)) (+ (* a b c d e) -1)))
(define gb-cyclic6 '((+ a b c d e f) (+ (* a b) (* b c) (* c d) (* d e) (* e f) (* f a))
                     (+ (* a b c) (* b c d) (* c d e) (* d e f) (* e f a) (* f a b))
                     (+ (* a b c d) (* b c d e) (* c d e f) (* d e f a) (* e f a b) (* f a b c))
                     (+ (* a b c d e) (* b c d e f) (* c d e f a) (* d e f a b) (* e f a b c) (* f a b c d))
                     (+ (* a b c d e f) -1)))
; раскраска графа в 3 цвета (бенчмарк раскраски): 12 вершин, 23 ребра (без последнего) — раскрашиваем
(define gb-col-vars '(x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12))
(define gb-coloring
  (append (map (lambda (x) (list '- (list '^ x 3) 1)) gb-col-vars)
          (map (lambda (e) (let ((a (nth gb-col-vars (- (car e) 1))) (b (nth gb-col-vars (- (cadr e) 1))))
                             (list '+ (list '^ a 2) (list '* a b) (list '^ b 2))))
               '((1 2) (2 3) (1 4) (1 6) (1 12) (2 5) (2 7) (3 8) (3 10) (4 11) (4 9) (5 6) (6 7) (7 8) (8 9)
                 (9 10) (10 11) (11 12) (5 12) (5 9) (6 10) (7 11) (8 12)))))

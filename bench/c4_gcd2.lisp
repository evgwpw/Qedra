; c4: двумерный НОД многочленов (модулярный НОД, шаг 21e): взаимно простые и с общим множителем
; (время файла включает раскрытие скобок — на нём основное время; сами два НОД: ≈ 160 → ≈ 16 мс)
(define c4-a (expand '(* (^ (+ x y 1) 5) (^ (+ x (* -1 y) 2) 3) (+ (* x y) 3))))
(define c4-b (expand '(* (^ (+ x y 2) 4) (^ (+ (* x y) 3) 3) (+ x 5))))
(define c4-g '(+ (^ x 4) (* 2 x (^ y 3)) (^ y 4) (* -3 x y) (* 7 x) 1))
(define c4-c (expand (list '* c4-g '(+ (^ x 3) (* x (^ y 2)) (^ y 3) (* 5 x) 1) '(+ (^ x 2) (* -2 x y) (* 3 y) 5))))
(define c4-d (expand (list '* c4-g '(+ (* x (^ y 2)) (^ y 3) (* -7 x) 2) '(+ (^ x 3) (* 3 x y) (^ y 2) 2))))
(list (poly-gcd c4-a c4-b) (poly-gcd c4-c c4-d))

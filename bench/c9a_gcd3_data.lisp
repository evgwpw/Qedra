; c9: НОД двух 3-мерных многочленов степени 8 с общим множителем степени 4 (шаг 21g).
; c9a — данные (раскрытие скобок), c9b — сам НОД; замер c9b не включает раскрытие. Запускать вместе: --bench c9
(define c9-g (expand '(^ (+ x (* 2 y) (* 3 z) 1) 4)))
(define c9-a (expand (list '* c9-g '(^ (+ x y (* -1 z) 2) 4))))
(define c9-b (expand (list '* c9-g '(^ (+ (* 2 x) (* -1 y) z 3) 4))))

; c12: проблема из шага 21f — НОД 4-мерных многочленов (gcd(p, p'), десятки секунд у Брауна): p = u²·v с кратным
; разреженным множителем u от 4 переменных (5 термов, степени до 16) (шаг 21g). Точный многочлен из 21f не сохранился —
; взят класс «кратный разреженный множитель высокой степени». c12a — данные, c12b — НОД(p, dp/dx) и НОД(p, dp/dy).
; Запускать вместе: --bench c12
(define c12-u '(+ (* (^ x 16) (^ y 4)) (* (^ y 15) (^ z 5)) (* (^ z 14) (^ w 6)) (* (^ w 13) (^ x 3)) 1))
(define c12-p (expand (list '* (list '^ c12-u 2) '(+ (^ x 3) (* y z) (^ w 2) 3))))
(define c12-dx (diff 'x c12-p))
(define c12-dy (diff 'y c12-p))

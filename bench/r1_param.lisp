; r1: Риш с параметрами (условие risch-generic)
(risch-integrate '(exp (* a x)) 'x)
(risch-integrate '(* x (exp (* a x))) 'x)
(risch-integrate '(* (^ x 2) (exp (* a x))) 'x)
(risch-integrate '(exp (* a (^ x 2))) 'x)
(risch-integrate '(* t0 (exp x)) 'x)
(risch-integrate '(/ (exp (* a x)) (+ 1 (exp (* a x)))) 'x)
(risch-integrate '(/ 1 (+ a x (log x))) 'x)
(risch-integrate '(log (^ x y)) 'x)

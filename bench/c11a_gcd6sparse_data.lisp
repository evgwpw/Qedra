; c11: разреженный 6-мерный НОД: G из 6 термов (цикл x1³x2 + x2⁴x3 + … + x5⁴x6 + 1, как в Monagan 2021) и два кофактора
; из 4–5 термов (шаг 21g). c11a — данные, c11b — НОД. Запускать вместе: --bench c11
(define c11-g '(+ (* (^ x1 3) x2) (* (^ x2 4) x3) (* (^ x3 4) x4) (* (^ x4 4) x5) (* (^ x5 4) x6) 1))
(define c11-a (expand (list '* c11-g '(+ (* x1 x3) (* x5 (^ x6 2)) (* 2 x2) 7))))
(define c11-b (expand (list '* c11-g '(+ (* x2 x4) (* x1 x6) (* x3 x5) (* -3 x1) 5))))

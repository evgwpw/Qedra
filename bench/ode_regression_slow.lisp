; ode_regression_slow.lisp — регрессия ОДУ (ODE.1): первый порядок.
; Запуск: src/Lisp.Host/bin/Debug/net10.0/Lisp.exe bench/ode_regression_slow.lisp
; S — решение найдено и прошло dsolve-check (для неявного — check из объекта);
; U — честный unknown; W — ответ есть, но проверка не прошла (ложный ответ; должно быть 0).

(define ode-reg-cases
  '(
    ("y'=x*y" (= (diff (y x) x) (* x (y x))))
    ("y'=x/y" (= (diff (y x) x) (/ x (y x))))
    ("y'=1+y^2" (= (diff (y x) x) (+ 1 (^ (y x) 2))))
    ("y'=y^2" (= (diff (y x) x) (^ (y x) 2)))
    ("y'=y-y^2" (= (diff (y x) x) (- (y x) (^ (y x) 2))))
    ("y'=2xy+x" (= (diff (y x) x) (+ (* 2 x (y x)) x)))
    ("y'+y=x" (= (+ (diff (y x) x) (y x)) x))
    ("y'+2y=e^-x" (= (+ (diff (y x) x) (* 2 (y x))) (exp (* -1 x))))
    ("y'=y/x" (= (diff (y x) x) (/ (y x) x)))
    ("y'=(x+y)/(x-y)" (= (diff (y x) x) (/ (+ x (y x)) (- x (y x)))))
    ("y'=(x^2+y^2)/(xy)" (= (diff (y x) x) (/ (+ (^ x 2) (^ (y x) 2)) (* x (y x)))))
    ("y'=e^(x^2)" (= (diff (y x) x) (exp (^ x 2))))
    ("y'=sin(x)/x" (= (diff (y x) x) (/ (sin x) x)))
    ("y'=x^2" (= (diff (y x) x) (^ x 2)))
    ("y'=cos(x)" (= (diff (y x) x) (cos x)))
    ("y'=1/(1+x^2)" (= (diff (y x) x) (/ 1 (+ 1 (^ x 2)))))
    ("y'=y cos(x)" (= (diff (y x) x) (* (y x) (cos x))))
    ("y'=y/(1+x^2)" (= (diff (y x) x) (/ (y x) (+ 1 (^ x 2)))))
    ("y'=x e^x" (= (diff (y x) x) (* x (exp x))))
    ("y'=1/x" (= (diff (y x) x) (/ 1 x)))
    ("y'=y^3" (= (diff (y x) x) (^ (y x) 3)))
    ("y'=sqrt(y)" (= (diff (y x) x) (sqrt (y x))))
    ("y'=x(1+y^2)" (= (diff (y x) x) (* x (+ 1 (^ (y x) 2)))))
    ("y'=(1+y^2)/(1+x^2)" (= (diff (y x) x) (/ (+ 1 (^ (y x) 2)) (+ 1 (^ x 2)))))
    ("y'=y log(x)" (= (diff (y x) x) (* (y x) (log x))))
    ("y'=x+y^2" (= (diff (y x) x) (+ x (^ (y x) 2))))
    ("y'=x^2+y^2" (= (diff (y x) x) (+ (^ x 2) (^ (y x) 2))))
    ("y'+y^2=x" (= (+ (diff (y x) x) (^ (y x) 2)) x))
    ("y'=sin(y)" (= (diff (y x) x) (sin (y x))))
    ("y'=e^(x+y)" (= (diff (y x) x) (exp (+ x (y x)))))
    ("y'=y/(x+1)" (= (diff (y x) x) (/ (y x) (+ x 1))))
    ("y'=x y^2" (= (diff (y x) x) (* x (^ (y x) 2))))
    ("y'=y^2/x^2" (= (diff (y x) x) (/ (^ (y x) 2) (^ x 2))))
    ; ODE.2: точные, интегрирующий множитель, Риккати, Клеро/Лагранж
    ("exact: (2xy+3)dx+(x²+4y)dy=0"
     (= (+ (+ (* 2 x (y x)) 3) (* (+ (^ x 2) (* 4 (y x))) (diff (y x) x))) 0))
    ("exact: (y+e^x)dx+x dy=0"
     (= (+ (+ (y x) (exp x)) (* x (diff (y x) x))) 0))
    ("mu(x): (x+y²)dx−2xy dy=0"
     (= (+ (+ x (^ (y x) 2)) (* -2 x (y x) (diff (y x) x))) 0))
    ("mu(y): y dx+(2x−y e^y)dy=0"
     (= (+ (y x) (* (+ (* 2 x) (* -1 (y x) (exp (y x)))) (diff (y x) x))) 0))
    ("mu(xy): y(1+xy)dx+x(1−xy)dy=0"
     (= (+ (* (y x) (+ 1 (* x (y x)))) (* x (- 1 (* x (y x))) (diff (y x) x))) 0))
    ("Riccati: y'=y²−2/x²" (= (diff (y x) x) (- (^ (y x) 2) (/ 2 (^ x 2)))))
    ("Riccati: y'=y²+1−x²" (= (diff (y x) x) (- (+ (^ (y x) 2) 1) (^ x 2))))
    ("Clairaut: y=xy'+y'²" (= (y x) (+ (* x (diff (y x) x)) (^ (diff (y x) x) 2))))
    ("Lagrange: y=2xy'+y'²" (= (y x) (+ (* 2 x (diff (y x) x)) (^ (diff (y x) x) 2))))
    ("y'=(x-y)/(x+y)" (= (diff (y x) x) (/ (- x (y x)) (+ x (y x)))))
    ("y'=2y/x+x^2" (= (diff (y x) x) (+ (* 2 (/ (y x) x)) (^ x 2))))
    ("y'+y tan(x)=sin 2x" (= (+ (diff (y x) x) (* (y x) (tan x))) (sin (* 2 x))))
    ("y'=1/(x y)" (= (diff (y x) x) (/ 1 (* x (y x)))))
    ("y'=x/y^2" (= (diff (y x) x) (/ x (^ (y x) 2))))
    ("y'=y e^x" (= (diff (y x) x) (* (y x) (exp x))))
    ("y'=cos(x) y^2" (= (diff (y x) x) (* (cos x) (^ (y x) 2))))
    ; Эйлер–Коши (ODE.4a)
    ("x^2y''-2xy'+2y=0" (= (+ (- (* x x (diff (diff (y x) x) x)) (* 2 x (diff (y x) x))) (* 2 (y x))) 0))
    ("x^2y''+xy'+y=0" (= (+ (+ (* x x (diff (diff (y x) x) x)) (* x (diff (y x) x))) (y x)) 0))
    ("x^2y''-xy'+y=0" (= (+ (- (* x x (diff (diff (y x) x) x)) (* x (diff (y x) x))) (y x)) 0))
    ("x^2y''+xy'=y" (= (+ (* x x (diff (diff (y x) x) x)) (* x (diff (y x) x))) (y x)))
    ; понижение порядка и автономные (ODE.5b)
    ("y''+y'=x (без y)" (= (+ (diff (diff (y x) x) x) (diff (y x) x)) x))
    ("y''=y'^2 (без y)" (= (diff (diff (y x) x) x) (^ (diff (y x) x) 2)))
    ("y''=1+y'^2 (без y)" (= (diff (diff (y x) x) x) (+ 1 (^ (diff (y x) x) 2))))
    ("y*y''=y'^2 (автономное)" (= (* (y x) (diff (diff (y x) x) x)) (^ (diff (y x) x) 2)))
    ("y''=y'^2 (автономное)" (= (diff (diff (y x) x) x) (^ (diff (y x) x) 2)))
    ("y''+y'^2=0 (автономное)" (= (+ (diff (diff (y x) x) x) (^ (diff (y x) x) 2)) 0))
    ; резонанс (ODE.5b / пробел ODE.3)
    ("y''+4y=sin 2x" (= (+ (diff (diff (y x) x) x) (* 4 (y x))) (sin (* 2 x))))
    ("y''+4y=cos 2x" (= (+ (diff (diff (y x) x) x) (* 4 (y x))) (cos (* 2 x))))
    ("y''-2y'+y=x^2 e^x" (= (+ (- (diff (diff (y x) x) x) (* 2 (diff (y x) x))) (y x))
                            (* (exp x) (^ x 2))))))

(define ode-reg-S 0)
(define ode-reg-U 0)
(define ode-reg-W 0)

(map (lambda (c)
       (let* ((label (car c))
              (eq (cadr c))
              (r (try (dsolve eq '(y x)) (lambda (e) #f))))
         (cond ((not r) (set! ode-reg-U (+ ode-reg-U 1)))
               ((equal? (ode-status r) 'unknown) (set! ode-reg-U (+ ode-reg-U 1)))
               (else
                (let ((ok (if (or (equal? (ode::ode-field r :type) 'implicit)
                                  (equal? (ode::ode-field r :type) 'parametric))
                              (ode::ode-field r :check)
                              (dsolve-check eq (car (ode-solutions r)) '(y x)))))
                  (if ok
                      (set! ode-reg-S (+ ode-reg-S 1))
                      (begin
                        (set! ode-reg-W (+ ode-reg-W 1))
                        (display "*** W: ") (display label) (newline))))))))
     ode-reg-cases)

; задачи Коши (ODE.4a): уравнение + условия; S — particular с точным сертификатом
(define ode-cauchy-cases
  '(
    ("y'=y, y(0)=2" (= (diff (y x) x) (y x)) ((= (y 0) 2)))
    ("y''+y=0, y(0)=1, y'(0)=0" (= (+ (diff (diff (y x) x) x) (y x)) 0)
     ((= (y 0) 1) (= (at (diff (y x) x) (= x 0)) 0)))
    ("y''-3y'+2y=0, y(0)=0, y'(0)=1"
     (= (+ (- (diff (diff (y x) x) x) (* 3 (diff (y x) x))) (* 2 (y x))) 0)
     ((= (y 0) 0) (= (at (diff (y x) x) (= x 0)) 1)))
    ("x^2y''-2xy'+2y=0, y(1)=3, y'(1)=5"
     (= (+ (- (* x x (diff (diff (y x) x) x)) (* 2 x (diff (y x) x))) (* 2 (y x))) 0)
     ((= (y 1) 3) (= (at (diff (y x) x) (= x 1)) 5)))
    ("y'=x/y, y(0)=1" (= (diff (y x) x) (/ x (y x))) ((= (y 0) 1)))
    ("y'=x/y, y(0)=-1" (= (diff (y x) x) (/ x (y x))) ((= (y 0) -1)))
    ("y==e^(-y^2), y(0)=0" (= (diff (y x) x) (exp (* -1 (^ (y x) 2)))) ((= (y 0) 0)))))

(map (lambda (c)
       (let* ((label (car c))
              (eq (cadr c))
              (conds (caddr c))
              (r (try (apply dsolve (append (list eq '(y x)) conds)) (lambda (e) #f))))
         (cond ((not r) (set! ode-reg-U (+ ode-reg-U 1)))
               ((not (equal? (ode-status r) 'ok)) (set! ode-reg-U (+ ode-reg-U 1)))
               ((not (equal? (ode::ode-field r :check) #t))
                (set! ode-reg-W (+ ode-reg-W 1))
                (display "*** W: ") (display label) (newline))
               (else (set! ode-reg-S (+ ode-reg-S 1))))))
     ode-cauchy-cases)

; ряды (ODE.7): S — сертификат остатка сошёлся, U — честный unknown, W — ложный ответ (должно быть 0)
(define ode-series-cases
  '(
    ("y''+y=0 (ряд)" (= (+ (diff (diff (y x) x) x) (y x)) 0) 0 10)
    ("y''-xy=0 (Эйри)" (= (- (diff (diff (y x) x) x) (* x (y x))) 0) 0 10)
    ("y''-2xy'+6y=0 (Эрмит n=3)" (= (+ (- (diff (diff (y x) x) x) (* 2 x (diff (y x) x))) (* 6 (y x))) 0) 0 10)
    ("(1-x^2)y''-2xy'+6y=0 (Лежандр)" (= (+ (- (* (- 1 (^ x 2)) (diff (diff (y x) x) x)) (* 2 x (diff (y x) x))) (* 6 (y x))) 0) 0 10)
    ("Бессель ν=0" (= (+ (* x x (diff (diff (y x) x) x)) (* x (diff (y x) x)) (* (^ x 2) (y x))) 0) 0 10)
    ("Бессель ν=1" (= (+ (* x (diff (diff (y x) x) x)) (diff (y x) x) (* x (y x))) 0) 0 10)
    ("x y''+y=0" (= (+ (* x (diff (diff (y x) x) x)) (y x)) 0) 0 10)
    ("иррегулярная x^2 y''+y=0" (= (+ (* (^ x 2) (diff (diff (y x) x) x)) (y x)) 0) 0 10)))

(map (lambda (c)
       (let* ((label (car c))
              (eq (cadr c))
              (x0 (caddr c))
              (n (nth c 3))
              (r (try (dsolve-series eq '(y x) x0 n) (lambda (e) #f))))
         (cond ((not r) (set! ode-reg-U (+ ode-reg-U 1)))
               ((not (equal? (ode-status r) 'ok)) (set! ode-reg-U (+ ode-reg-U 1)))
               ((not (ode-series-check eq (car (ode-solutions r)) '(y x)))
                (set! ode-reg-W (+ ode-reg-W 1))
                (display "*** W: ") (display label) (newline))
               (else (set! ode-reg-S (+ ode-reg-S 1))))))
     ode-series-cases)

(display "ODE regression: S=") (display ode-reg-S)
(display " U=") (display ode-reg-U)
(display " W=") (display ode-reg-W) (newline)

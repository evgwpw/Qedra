; r1.5: регрессия алгебраического Риша (корни): ответ известен или доказано «неэлементарен».
; Запуск: src/Lisp.Host/bin/Debug/net10.0/Lisp.exe bench/algebraic_regression_slow.lisp
; Классы: S — ответ без integrate и int-check; P — частичный ответ; N — доказано неэлементарен;
; U — не вычислено; W — ответ не проходит проверку (ложный). Ожидание — множество допустимых классов.
; Ложное N и любой W печатаются с ***.

(define ar-cases
  (list
    ; --- элементарные (производные, лог-части) ---
    (list "d sqrt(x^3+1)" (diff 'x '(^ (+ (^ x 3) 1) 1/2)) 'x "S")
    (list "d x*sqrt(x^3+1)" (diff 'x '(* x (^ (+ (^ x 3) 1) 1/2))) 'x "S")
    (list "d sqrt(x^5+1)" (diff 'x '(^ (+ (^ x 5) 1) 1/2)) 'x "S")
    (list "d cbrt(x^3+1)" (diff 'x '(^ (+ (^ x 3) 1) 1/3)) 'x "S")
    (list "d sqrt(x^3+1)/(x+1)" (diff 'x '(/ (^ (+ (^ x 3) 1) 1/2) (+ x 1))) 'x "S")
    (list "d cbrt(x^2(x-1))/x^2" (diff 'x '(/ (^ (* (^ x 2) (- x 1)) 1/3) (^ x 2))) 'x "S")
    (list "d (sqrt(x)+sqrt(x+1))/x" (diff 'x '(/ (+ (^ x 1/2) (^ (+ x 1) 1/2)) x)) 'x "S")
    (list "d log((y^2-2y-1)/(y^2+2y-1)), y=sqrt(x)+sqrt(x+1)"
          (diff 'x (list 'log (list '/ (list '- (list '^ (list '+ (list '^ 'x 1/2) (list '^ (list '+ 'x 1) 1/2)) 2)
                                                 (list '* 2 (list '+ (list '^ 'x 1/2) (list '^ (list '+ 'x 1) 1/2))) 1)
                                           (list '+ (list '^ (list '+ (list '^ 'x 1/2) (list '^ (list '+ 'x 1) 1/2)) 2)
                                                 (list '* 2 (list '+ (list '^ 'x 1/2) (list '^ (list '+ 'x 1) 1/2))) -1)))) 'x "S")
    (list "x^2/((x^3+1)^(2/3)((x^3+1)^(1/3)-1))"
          '(/ (^ x 2) (* (^ (+ (^ x 3) 1) 2/3) (- (^ (+ (^ x 3) 1) 1/3) 1))) 'x "S")
    (list "1/(x sqrt(x^3+1))" '(/ 1 (* x (^ (+ (^ x 3) 1) 1/2))) 'x "S")
    (list "1/(x sqrt(x^5+1))" '(/ 1 (* x (^ (+ (^ x 5) 1) 1/2))) 'x "S")
    (list "1/(x sqrt(x^8+1))" '(/ 1 (* x (^ (+ (^ x 8) 1) 1/2))) 'x "S")
    (list "d (x^2+1)*sqrt(x^3+1)" (diff 'x '(* (+ (^ x 2) 1) (^ (+ (^ x 3) 1) 1/2))) 'x "S")
    (list "d sqrt(x^3+1)/(x^2+1)" (diff 'x '(/ (^ (+ (^ x 3) 1) 1/2) (+ (^ x 2) 1))) 'x "S")
    (list "d (x+1)*cbrt(x^2(x-1))" (diff 'x '(* (+ x 1) (^ (* (^ x 2) (- x 1)) 1/3))) 'x "S")
    (list "d sqrt(x(x-1)(x+2))/x" (diff 'x '(/ (^ (* x (- x 1) (+ x 2)) 1/2) x)) 'x "S")
    (list "d log((y-1)/(y+1)), y^2=x^3+1" (diff 'x (list 'log (list '/ (list '- (list '^ (list '+ (^ 'x 3) 1) 1/2) 1)
                                                                  (list '+ (list '^ (list '+ (^ 'x 3) 1) 1/2) 1)))) 'x "S")
    (list "d log(y), y^2=x^3+1" (diff 'x (list 'log (list '^ (list '+ (^ 'x 3) 1) 1/2))) 'x "S")
    (list "d log(y), y^3=x^3+1" (diff 'x (list 'log (list '^ (list '+ (^ 'x 3) 1) 1/3))) 'x "S")
    (list "d y/x, y^2=x^3+1" (diff 'x '(/ (^ (+ (^ x 3) 1) 1/2) x)) 'x "S")
    (list "d sqrt(x^3+1)*x^2/(x^3+1)" (diff 'x '(* (^ (+ (^ x 3) 1) 1/2) (/ (^ x 2) (+ (^ x 3) 1)))) 'x "S")
    (list "d (x*sqrt(x^3+1))/(x^2+1)" (diff 'x '(/ (* x (^ (+ (^ x 3) 1) 1/2)) (+ (^ x 2) 1))) 'x "S")
    ; --- доказанно неэлементарные ---
    (list "1/sqrt(x^3+1)" '(/ 1 (^ (+ (^ x 3) 1) 1/2)) 'x "SN")
    (list "1/sqrt(x^4+1)" '(/ 1 (^ (+ (^ x 4) 1) 1/2)) 'x "N")
    (list "1/sqrt(x^5+1)" '(/ 1 (^ (+ (^ x 5) 1) 1/2)) 'x "N")
    (list "x/sqrt(x^3+1)" '(/ x (^ (+ (^ x 3) 1) 1/2)) 'x "N")
    (list "x/sqrt(x^5+1)" '(/ x (^ (+ (^ x 5) 1) 1/2)) 'x "N")
    (list "x^2/sqrt(x^5+1)" '(/ (^ x 2) (^ (+ (^ x 5) 1) 1/2)) 'x "N")
    (list "1/sqrt(x^3+x+1)" '(/ 1 (^ (+ (^ x 3) x 1) 1/2)) 'x "N")
    (list "x/sqrt(1-x^3)" '(/ x (^ (- 1 (^ x 3)) 1/2)) 'x "N")
    (list "x/sqrt(1-x^3)" '(/ x (^ (- 1 (^ x 3)) 1/2)) 'x "N")
    (list "1/((x-2)sqrt(x^3+1))" '(/ 1 (* (- x 2) (^ (+ (^ x 3) 1) 1/2))) 'x "N")
    (list "(1/(x-2)+1)/sqrt(x^3+1)" '(/ (+ (/ 1 (- x 2)) 1) (^ (+ (^ x 3) 1) 1/2)) 'x "N")
    (list "sqrt(x^3+1)" '(^ (+ (^ x 3) 1) 1/2) 'x "N")
    (list "x*sqrt(x^3+1)" '(* x (^ (+ (^ x 3) 1) 1/2)) 'x "N")
    (list "1/sqrt(x^6+1)" '(/ 1 (^ (+ (^ x 6) 1) 1/2)) 'x "N")
    (list "x^2/sqrt(x^6+1)" '(/ (^ x 2) (^ (+ (^ x 6) 1) 1/2)) 'x "S")
    ; --- неизвестные/частичные ---
    (list "1/sqrt(x^4+2)" '(/ 1 (^ (+ (^ x 4) 2) 1/2)) 'x "NU")
    (list "1/(sqrt(x)+sqrt(x+1))" '(/ 1 (+ (^ x 1/2) (^ (+ x 1) 1/2))) 'x "U")
    (list "1/((x+1)^2 sqrt(x^3+1))" '(/ 1 (* (^ (+ x 1) 2) (^ (+ (^ x 3) 1) 1/2))) 'x "NU")
    (list "sqrt(x^3+1)/(x^2+1)" '(/ (^ (+ (^ x 3) 1) 1/2) (+ (^ x 2) 1)) 'x "U")
    (list "1/(x^3 sqrt(x^3+1))" '(/ 1 (* (^ x 3) (^ (+ (^ x 3) 1) 1/2))) 'x "NU")
    (list "sqrt(x^4+1)/x^2" '(/ (^ (+ (^ x 4) 1) 1/2) (^ x 2)) 'x "NU")
    (list "(x^2+1)/sqrt(x^5+1)" '(/ (+ (^ x 2) 1) (^ (+ (^ x 5) 1) 1/2)) 'x "NU")))

(define (ar-has-int? e) (and (pair? e) (or (equal? (car e) 'integrate) (any? ar-has-int? (cdr e)))))

(define (ar-run c)
  (let* ((e (nth c 1)) (v (nth c 2)) (t0 (clock-us)))
    (conditions-clear)
    (let* ((r (try (integrate e v) (lambda (err) 'error)))
           (ms (/ (- (clock-us) t0) 1000.0))
           (ne (any? (lambda (cd) (equal? (car (car cd)) 'risch-nonelementary)) (conditions))))
      (list (cond ((equal? r 'error) 'W)
                  ((not (ar-has-int? r)) (if (int-check r e v) 'S 'W))
                  ((equal? r (list 'integrate (simplify e) v)) (if ne 'N 'U))
                  (else (if (int-check r e v) 'P 'W)))
            r ms))))

(define (ar-main)
  (let ((counts '()) (bad '()) (total-ms 0))
    (map (lambda (c)
           (let* ((res (ar-run c)) (cls (car res)) (exp (nth c 3))
                  (ok (and (not (equal? cls 'W)) (string-contains? exp (to-string cls))))
                  (flag (if ok "" (if (equal? cls 'N) " *** ЛОЖНОЕ N?" " *** НЕ СОВПАЛО")))
                  (name (to-string cls)))
             (set! total-ms (+ total-ms (nth res 2)))
             (set! counts (cons cls counts))
             (if (not ok) (set! bad (cons (car c) bad)))
             (display (car c)) (display " | ") (display name) (display " (ожид. ") (display exp) (display ") | ")
             (display (floor (nth res 2))) (display " мс | ") (display (nth res 1)) (display flag) (newline)))
         ar-cases)
    (newline)
    (display "ИТОГО: ") (display (length ar-cases)) (display " примеров")
    (map (lambda (k) (display ", ") (display k) (display "=")
           (display (length (filter (lambda (c) (equal? c k)) counts))))
         '(S P N U W))
    (display ", время ") (display (floor (/ total-ms 1000))) (display " с") (newline)
    (display "расхождения: ") (display bad) (newline)))

(ar-main)

// Численность с сертификатами (lib/interval.lisp, шаги CN.1–CN.3): ответ — интервал [lo, hi],
// в котором значение лежит ГАРАНТИРОВАННО. Точные функции возвращают дроби; в языке концы
// округлены наружу до 1e-12, чтобы печать оставалась читаемой.
interval(exp(-x^2), x, 0, 1)
certified_integral(exp(-x^2), x, 0, 1, 1/1000000)
certified_integral(1/x, x, 1, 2, 1/1000000)
certified_integral(sin(x), x, 0, pi, 1/1000000)
certified_roots(cos(x) - x, x, 0, 1, 1/1000000)
certified_roots(exp(x) - 3x, x, 0, 2, 1/1000000)
certified_roots(sin(x), x, 1, 7, 1/1000000)
certified_sum(1/k^2, k, 1, 1/1000)
certified_sum(1/k!, k, 0, 1/10^12)
certified_sum(1/2^k, k, 0, 1/1000000)

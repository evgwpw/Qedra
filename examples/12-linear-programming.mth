// Линейное и целочисленное программирование (lib/lp.lisp, шаг LP 3): lp_maximize, lp_solve,
// ilp_solve.  Ответы: (optimal x value y) с двойственными ценами, (infeasible y), (unbounded x d).
lp_maximize([3,5],[[1,0],[0,2],[3,2]],[4,12,18])
lp_solve("max", [3,5], [[1,0],[0,2],[3,2]], [4,12,18], ["<=","<=","<="])
lp_solve("min", [1,1], [[1,1],[1,-1]], [3,1], [">=","="])
ilp_solve("max", [7,9,11,13,15], [[4,4,4,4,4]], [15], ["<="], ["bin","bin","bin","bin","bin"])

// Демонстрация входного математического языка (Шаг 21).
// Запуск:  dotnet run --project src/Lisp.Host -- examples/demo.mth      (или построчно:  ... -- --math)
// Каждый оператор печатает своё значение. Операторы разделяются переводом строки или «;».

// ---------- Переменные и функции ----------
a := 5
f(x) := x^2 + sin(x)
f(a)
f(y + 1)

// ---------- Анализ ----------
integrate(f(x), x)
integrate(x^2, x, 0, 1)
diff(f(x), x)
diff(x^4, x, 2)
limit(sin(x)/x, x, 0)
limit((1 + 1/x)^x, x, ∞)
taylor(exp(x), x, 0, 4)
series(sin(x), x, 0, 6)

// ---------- Рекурсия и условия ----------
fact(n) := if(n = 0, 1, n*fact(n - 1))
fact(10)
fact(m)                // m — символ: if остаётся невычисленным
sgn(t) := if(t > 0, 1, if(t < 0, -1, 0))
sgn(-7)

// ---------- Уравнения ----------
solve(x^2 - 5x + 6 = 0, x)
solve(x^2 = 2, x)
solve([x + y = 3, x - y = 1], [x, y])

// ---------- Векторы и матрицы (индексы с 1) ----------
v := [1, 2, 3]
v[2]
2*v + [1, 1, 1]
m := [[1, 2], [3, 4]]
det(m)
inv(m)
m*m
m[2, 1]

// ---------- Множества и домены ----------
s := {1, 2, 3} ∪ {3, 4}
s ∩ {2, 4, 6}
s \ {1}
2 ∈ s
7 ∈ s
z :∈ ℝ
z ∈ ℝ
z ∈ ℤ
solve(z^2 + 1 = 0, z)
z :∈ ℤ
undeclare(z)           // декларации хранятся в символе и действуют на весь процесс — снимаем

// ---------- Очистка ----------
clear(a)
a

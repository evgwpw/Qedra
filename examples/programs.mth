// Небольшие программы на входном языке (Шаг 21a): блоки prog, циклы loop/exit, return,
// локальные переменные (параметры со значением по умолчанию), итераторы vector/sum/iterate/select.
// Запуск:  dotnet run --project src/Lisp.Host -- examples/programs.mth
// Локальные переменные объявляются параметрами по умолчанию: sieve(n, p := ..., r := []) — p и r
// существуют только на время вызова, глобальные одноимённые переменные не затрагиваются.

// ---------- 1. НОД по алгоритму Евклида ----------
gcd2(a, b, t := 0) := prog(
  loop(
    if(b = 0, exit),
    t := mod(a, b),
    a := b,
    b := t),
  a)
gcd2(1071, 462)

// ---------- 2. Метод Ньютона для sqrt(2): выход по точности ----------
newton_sqrt(c, x := 1.0, y := 0.0) := prog(
  loop(
    y := (x + c/x)/2,
    if(abs(y - x) < 0.000000001, exit),
    x := y),
  y)
newton_sqrt(2)

// то же через iterate: 5 шагов в точных рациональных числах
iterate(x/2 + 1/x, x, 1, 5)

// ---------- 3. Решето Эратосфена через vector/select ----------
// p — оставшиеся кандидаты, r — найденные простые: берём первое число и вычёркиваем его кратные
sieve(n, p := vector(k, k, 2, n), r := [], f := 0) := prog(
  loop(
    if(dimension(p) = 0, exit),
    f := first(p),
    r := append(r, [f]),
    p := select(mod(k, f) /= 0, k, rest(p))),
  r)
sieve(50)

// ---------- 4. Числа Фибоначчи ----------
fib(n, a := 0, b := 1, k := 0, t := 0) := prog(
  loop(
    if(k >= n, exit),
    t := a + b,
    a := b,
    b := t,
    k := k + 1),
  a)
fib(30)
iterates([x[2], x[1] + x[2]], x, [0, 1], 8)        // пары (F(k), F(k+1))

// ---------- 5. Метод Эйлера для y' = y, y(0) = 1 (ответ → e = 2.71828...) ----------
euler(n, h := 1.0/n, y := 1.0, k := 0) := prog(
  loop(
    if(k >= n, exit),
    y := y + h*y,
    k := k + 1),
  y)
euler(1000)

// ---------- 6. Таблица значений функции ----------
f(x) := x^2 - 2
vector([t, f(t)], t, 0, 4)
vector(f(t), t, 0, 2, 1/2)

// ---------- 7. Сумма ряда Тейлора и проверка через taylor ----------
partial(n) := sum(x^k/k!, k, 0, n)
partial(5)
expand(partial(5) - taylor(exp(x), x, 0, 6))         // 0: многочлены совпадают
sum(1.0/k!, k, 0, 15)                                 // e численно

// ---------- 8. Числа Коллатца: число шагов до единицы ----------
collatz(n, steps := 0) := prog(
  loop(
    if(n = 1, exit),
    n := if(mod(n, 2) = 0, n/2, 3*n + 1),
    steps := steps + 1),
  steps)
collatz(27)

// ---------- 9. Изменение элемента вектора: пузырьковая сортировка ----------
bubble(v, n := 0, i := 0, t := 0, swapped := true) := prog(
  n := dimension(v),
  loop(
    if(not swapped, exit),
    swapped := false,
    i := 1,
    loop(
      if(i >= n, exit),
      if(v[i] > v[i + 1], prog(t := v[i], v[i] := v[i + 1], v[i + 1] := t, swapped := true)),
      i := i + 1)),
  v)
bubble([5, 2, 9, 1, 7, 3])

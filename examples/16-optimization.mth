// Экстремумы и множители Лагранжа (lib/optimize.lisp, шаг OPT.1): critical_points, extrema,
// hessian, lagrange. Типы: min/max/saddle/unknown (вырожденный гессиан — unknown, не min).
critical_points(x^2+y^2, [x,y])
extrema(x^2+y^2, [x,y])
extrema(x^2-y^2, [x,y])
extrema(-x^2-2*y^2+4*y, [x,y])
extrema(x^3-3*x, [x])
extrema(x^4, [x])
extrema(x^4+y^4-4*x*y, [x,y])
hessian(x*y, [x,y])
lagrange(x+y, [x^2+y^2-1], [x,y])
lagrange(x*y, [x+y-10], [x,y])

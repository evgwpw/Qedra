// Теория чисел (шаги NT.1–NT.4): модулярная арифметика, КТО, простые числа, факторизация,
// уравнение Пелля, суммы двух квадратов, пифагоровы тройки и конечные поля GF(pⁿ).
// Каждый ответ библиотека проверяет сертификатом: ложный ответ — ошибка, а не результат.

// степени и обратные по модулю, китайская теорема об остатках (модули не обязаны быть взаимно простыми)
powmod(3, 12345, 1000000007)
invmod(3, 11)
crt([2, 3, 2], [3, 5, 7])

// простые числа, факторизация, функция Эйлера
isprime(2^31 - 1)
factorint(2^67 - 1)
totient(1000000)

// уравнение Пелля x² − 61y² = 1; первые решения (x + y√2)^k; отрицательный Пелль для D = 13
pell(61)
pell_solutions(2, 4)
pell_negative(13)

// сумма двух квадратов 2·5·13·17 и примитивные пифагоровы тройки с гипотенузой ≤ 30
sum_of_two_squares(2*5*13*17)
pythagorean_triples(30)

// линейное диофантово уравнение 3x + 5y = 7: частное решение и шаг
solve_linear_diophantine(3, 5, 7)

// конечное поле GF(2⁸) с m = x⁸+x⁴+x³+x+1 (AES): {53}⁻¹ = {CA} = 202
gf_to_int(gf(2, x^8 + x^4 + x^3 + x + 1, x), gf_inv(gf(2, x^8 + x^4 + x^3 + x + 1, x), 83))

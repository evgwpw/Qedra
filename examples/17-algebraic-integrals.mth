// Алгебраические и эллиптические интегралы (шаги A3′.1, A3′.3, A3′.5–A3′.7):
// теорема Чебышёва, эллиптические формы Лежандра F/E/K, Π третьего рода, башни ℚ(√d,√e).
// Невычисленная форма integrate(...) — честный отказ (в том числе доказанный nonelementary).

// Чебышёв: элементарные случаи (подстановки), ответ проверяется дифференцированием
integrate(x^3*sqrt(1+x^2), x)
integrate(1/(x*sqrt(1+x^3)), x)

// Чебышёв: доказанный отказ — первообразной нет (остаётся невычисленная форма)
integrate(sqrt(1+x^3), x)

// Эллиптика первого рода: ∫dx/√(1−x⁴) и ∫x²/√(1−x⁴) (F и E)
integrate(1/sqrt(1-x^4), x)
integrate(x^2/sqrt(1-x^4), x)

// Кубика x³+1: один вещественный корень — комплексный модуль Лежандра
integrate(1/sqrt(1-x^3), x)

// ∫dx/√((1−x²)(1−k²x²)) и ∫dx/√((x²+a²)(x²+b²))
integrate(1/sqrt((1-x^2)*(1-x^2/4)), x)
integrate(1/sqrt((x^2+4)*(x^2+1)), x)

// ∫dx/√((a²−x²)(b²−x²)) — второй род по форме, ответ через F
integrate(1/sqrt((4-x^2)*(1-x^2)), x)

// Π третьего рода: ∫dx/((1−n x²)√((1−x²)(1−k²x²)))
integrate(1/((1-x^2/2)*sqrt((1-x^2)*(1-x^2/4))), x)

// Башня ℚ(√2,√3): резольвента над ℚ(√3), коэффициенты требуют √(2∓√3)
integrate(1/(x^4+4*x^2+1), x)

// Эллиптические головы в языке: ввод и печать
EllipticF(x, 1/2)
EllipticK(1/2) + EllipticE(1/2)

<Project>

  <!-- Шаг 21h': NU1900 — «не удалось получить данные об уязвимостях пакетов» (внутренние источники NuGet недоступны
       без сети): предупреждение скрыто, сама проверка уязвимостей остаётся включённой -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <!-- REL.1a: версия релиза — единственное место, где она записана; ключ версии читает её из сборки -->
  <PropertyGroup>
    <Version>1.109.7.11</Version>
  </PropertyGroup>

</Project>

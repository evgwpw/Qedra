; integrate/ansatz.lisp — интегрирование анзацем («параллельный Риш», шаг INT.ANSATZ.1)
;
; Ответ ищется в виде  F = Σ cₘ · xⁱ · Πθₖ^eₖ / D  +  Σ cⱼ · log(vⱼ),  где
;   θₖ — «кирпичики» подынтегрального f: exp(u) (классы по рациональному отношению показателей, t = exp(база)),
;        log(u), u^(p/q) (одно подкоренное линейное по x: s = u^(1/Q)), sin/cos (один аргумент; sin²+cos² = 1),
;        спецфункции erf erfc erfi Ei li Si Ci atan и экспоненты/логарифмы их производных;
;   D — произведение знаменателей f (неприводимые множители над ℚ без параметров, степени как в f);
;   vⱼ — множители знаменателя f и знаменатели производных атангенса; суммарная степень кирпичиков ≤ d (d = 1, 2, …).
; Условие F′ = f проверяется НЕ разложением по мономам, а в случайных рациональных точках многообразия кирпичиков
; (x, θₖ — независимые рациональные числа, кроме связей √ и sin²+cos² = 1): каждая точка даёт линейное уравнение над ℚ на
; неизвестные cₘ (производные кирпичиков выражены через кирпичики), система решается точной арифметикой ℚ (Гаусс).
; Параметры f: коэффициент при мономе — c · Πpᵃ с целыми α (в точках параметры тоже случайные числа); константа
; erf (kp = 2/√π) — формальный параметр со степенями −1, 0, 1. Весовой фильтр (Б1): веса x и параметров подбираются из
; однородности f (аргументы функций — вес 0, слагаемые — одного веса); моном xⁱ·Πpᵃ·θᵉ допускается, только если его вес
; равен весу f плюс вес x при всех допустимых весах (вектор лежит в линейной оболочке ограничений). Нет решения при
; d ≤ d-max — честный отказ #f. Каждый ответ проходит int-check. Внутренние имена: an-.
; INT.ANSATZ.3: радикалы общего вида s = u^(1/Q) (u — многочлен от x и кирпичиков, Q = 2ᵃ3ᵇ, несколько независимых; показатели s
; от −(наибольшая отрицательная степень) до Q−1, бюджет d не тратят) — точки по модулю P ≡ 11 (mod 12) (√ и ∛ в F_P), без точного
; Гаусса над ℚ; кандидаты логарифмов log(s ± r), log(αx+β+s); комплексный анзац ℚ(i) для гауссовых показателей (an-gaussian).
(module integrate
  (export int-ansatz int-ansatz-stats without-ansatz))

(define int-ansatz-enabled #t)
(define int-ansatz-time-limit 3)
(define int-ansatz-d-max 3)
(define an-max-unknowns 130)
(define an-use-weights #t)

; ---------- состояние одного вызова ----------
(define an-x 'x)
(define an-fail #f)
(define an-deadline 0)
(define an-stats '())
(define an-params '())
(define an-kp-used #f)
(define an-raw-exps '())
(define an-raw-logs '())
(define an-raw-rads '())
(define an-raw-specs '())
(define an-raw-trig '())
(define an-raw-lbase '())
(define an-raw-pws '())      ; ((u n q k) …): u^(q·n + k), n — символ, k — целое
(define an-pw #f)             ; (u n q0 символ) — кирпичик θ = u^(q0·n)
(define an-z '())             ; знаменатели коэффициентов: (q·n + k + j)
(define an-exp-classes '())   ; ((база символ) …)
(define an-logs '())          ; ((u символ) …)
(define an-rad #f)            ; (u Q символ)
(define an-specs '())         ; (((голова u) символ D-сырое) …)
(define an-trig #f)           ; (база s c)
(define an-bricks '())        ; символы кирпичиков по порядку
(define an-kinds '())         ; символ -> 'signed | 'nonneg
(define an-seed 12345)
(define an-rads2 '())          ; ((u Q символ) …) — радикалы общего вида (u — многочлен от x и кирпичиков), точки по модулю P
(define an-mod? #f)            ; режим точек по модулю простого P ≡ 11 (mod 12): радикалы над F_P (√ и ∛ существуют/однозначны)
(define an-mp 2147483579)
(define an-rusyms '())         ; ((символ-радикала . подкоренное-в-символах) …)

(define (an-reset!)
  (set! an-rads2 '()) (set! an-mod? #f)
  (set! an-fail #f) (set! an-params '()) (set! an-kp-used #f)
  (set! an-raw-exps '()) (set! an-raw-logs '()) (set! an-raw-rads '()) (set! an-raw-specs '()) (set! an-raw-trig '())
  (set! an-raw-lbase '()) (set! an-raw-pws '()) (set! an-pw #f) (set! an-z '()) (set! an-exp-classes '()) (set! an-logs '()) (set! an-rad #f) (set! an-specs '())
  (set! an-trig #f) (set! an-bricks '()) (set! an-kinds '()) (set! an-seed 12345))

(define (an-bad! why) (if (not an-fail) (set! an-fail why)) #f)
(define (an-has-x? e) (contains-sym? e an-x))
(define (an-rat? v) (or (integer? v) (equal? (type-of v) 'rational)))
(define (an-add-new lst v) (if (member? v lst) lst (append lst (list v))))

(define (without-ansatz thunk)
  (let ((old int-ansatz-enabled))
    (set! int-ansatz-enabled #f)
    (unwind-protect (thunk) (set! int-ansatz-enabled old))))

; последняя статистика: ((d всего-без-фильтра неизвестных-после-фильтра вес?) …)
(define (int-ansatz-stats) an-stats)

; ---------- разбор подынтегрального: кирпичики ----------
(define (an-poly? u)
  (cond ((number? u) #t)
        ((symbol? u) (not (equal? u '%i)))
        ((and (op-expr? u) (member? (car u) '(+ *))) (every? an-poly? (cdr u)))
        ((and (op-expr? u) (equal? (car u) '^) (integer? (nth u 2))) (an-poly? (nth u 1)))
        (else #f)))

(define (an-const-ok? e)
  (cond ((number? e) #t)
        ((symbol? e) (if (equal? e '%i) (an-bad! "%i") #t))
        ((and (op-expr? e) (member? (car e) '(+ *))) (every? an-const-ok? (cdr e)))
        ((and (op-expr? e) (equal? (car e) '^) (integer? (nth e 2))) (an-const-ok? (nth e 1)))
        (else (an-bad! "функция от параметров"))))

(define an-spec-heads '(erf erfc erfi Ei li Si Ci atan))

; сырая производная спецфункции (в терминах exp/log/sin/cos и константы an-kp)
(define (an-spec-d head u)
  (let ((du (diff an-x u)))
    (cond ((equal? head 'erf) (set! an-kp-used #t) (list '* 'an-kp (list 'exp (list '* -1 (list '^ u 2))) du))
          ((equal? head 'erfc) (set! an-kp-used #t) (list '* -1 'an-kp (list 'exp (list '* -1 (list '^ u 2))) du))
          ((equal? head 'erfi) (set! an-kp-used #t) (list '* 'an-kp (list 'exp (list '^ u 2)) du))
          ((equal? head 'Ei) (list '* du (list 'exp u) (list '^ u -1)))
          ((equal? head 'li) (list '* du (list '^ (list 'log u) -1)))
          ((equal? head 'Si) (list '* du (list 'sin u) (list '^ u -1)))
          ((equal? head 'Ci) (list '* du (list 'cos u) (list '^ u -1)))
          (else (set! an-raw-lbase (an-add-new an-raw-lbase (simplify (list '+ 1 (list '^ u 2)))))
                (list '* du (list '^ (list '+ 1 (list '^ u 2)) -1))))))

; показатель r = q·n + k (один символ n, q и k рациональные) -> (n q k) либо #f
(define (an-pw-split r)
  (let ((syms (int-symbols r an-x)))
    (and (= (length syms) 1)
         (let* ((n (car syms)) (k (simplify (subst (list (list n 0)) r))) (q (simplify (diff n (simplify (list '- r k))))))
           (and (an-rat? k) (an-rat? q) (not (= q 0))
                (equal? (simplify (list '- r (list '+ k (list '* q n)))) 0)
                (list n q k))))))

(define (an-scan e)
  (cond ((not (an-has-x? e)) (an-const-ok? e))
        ((symbol? e) #t)
        ((not (op-expr? e)) #t)
        (else
         (let ((h (car e)) (args (cdr e)))
           (cond ((or (equal? h '+) (equal? h '*)) (for-each an-scan args) #t)
                 ((equal? h '^)
                  (let ((r (nth e 2)))
                    (cond ((integer? r) (an-scan (nth e 1)))
                          ((an-rat? r) (an-scan (nth e 1))
                                       (set! an-raw-rads (append an-raw-rads (list (cons (simplify (nth e 1)) r)))))
                          (else
                           (let ((sp (and (not (an-has-x? r)) (an-pw-split r))))
                             (if (and sp (integer? (nth sp 2)) (an-poly? (nth e 1)))
                                 (begin (an-scan (nth e 1))
                                        (set! an-raw-pws (an-add-new an-raw-pws (list (simplify (nth e 1)) (car sp) (cadr sp) (caddr sp)))))
                                 (an-bad! "степень с нечисловым показателем")))))))
                 ((equal? h 'exp)
                  (if (an-poly? (car args))
                      (set! an-raw-exps (an-add-new an-raw-exps (simplify (car args))))
                      (an-bad! "аргумент exp не многочлен")))
                 ((equal? h 'log)
                  (an-scan (car args))
                  (set! an-raw-logs (an-add-new an-raw-logs (simplify (car args)))))
                 ((member? h '(sin cos tan cot sec csc))
                  (if (an-poly? (car args))
                      (set! an-raw-trig (an-add-new an-raw-trig (simplify (car args))))
                      (an-bad! "аргумент тригонометрии не многочлен")))
                 ((member? h an-spec-heads)
                  (let ((u (simplify (car args))))
                    (if (an-poly? u)
                        (let ((key (list h u)))
                          (if (not (assoc key an-raw-specs))
                              (let ((d (an-spec-d h u)))
                                (set! an-raw-specs (append an-raw-specs (list (list key d))))
                                (an-scan d))))
                        (an-bad! "аргумент спецфункции не многочлен"))))
                 (else (an-bad! (to-string h))))))))

; ---------- построение классов кирпичиков ----------
(define (an-ratio u b) (simplify (list '* u (list '^ b -1))))

(define (an-build-exps)
  ; классы: ((b0 (отношения …)) …)
  (let ((cls '()))
    (for-each
     (lambda (u)
       (let ((hit (filter (lambda (c) (an-rat? (an-ratio u (car c)))) cls)))
         (if (null? hit)
             (set! cls (append cls (list (list u (list 1)))))
             (set! cls (map (lambda (c) (if (equal? c (car hit))
                                            (list (car c) (cons (an-ratio u (car c)) (cadr c)))
                                            c))
                            cls)))))
     an-raw-exps)
    (let ((i 0))
      (set! an-exp-classes
            (map (lambda (c)
                   (set! i (+ i 1))
                   (let ((L (foldl (lambda (acc r) (lcm acc (denom r))) 1 (cadr c))))
                     (list (simplify (list '* (car c) (list '^ L -1))) (string->symbol (string-append "an-e" (to-string i))))))
                 cls)))))

(define (an-build-all)
  (an-build-exps)
  (let ((i 0))
    (set! an-logs (map (lambda (u) (set! i (+ i 1)) (list u (string->symbol (string-append "an-l" (to-string i))))) an-raw-logs)))
  (let ((i 0))
    (set! an-specs (map (lambda (sd) (set! i (+ i 1)) (list (car sd) (string->symbol (string-append "an-f" (to-string i))) (cadr sd)))
                        an-raw-specs)))
  (if (pair? an-raw-rads)
      (let* ((u (car (car an-raw-rads)))
             (bases (foldl (lambda (acc p) (an-add-new acc (car p))) '() an-raw-rads))
             (Qof (lambda (b) (foldl (lambda (acc p) (if (equal? (car p) b) (lcm acc (denom (cdr p))) acc)) 1 an-raw-rads))))
        (if (and (= (length bases) 1) (an-poly? u) (not (an-has-x? (diff an-x u))) (not (equal? (diff an-x u) 0)))
            (set! an-rad (list u (Qof u) 'an-s))
            (let ((i 0))
              (if (any? (lambda (b) (not (member? (Qof b) '(2 3 4 6 8 9 12)))) bases)
                  (an-bad! "корень степени вне {2,3,4,6,8,9,12}")
                  (set! an-rads2 (map (lambda (b) (set! i (+ i 1)) (list b (Qof b) (string->symbol (string-append "an-r" (to-string i))))) bases)))))))
  (set! an-mod? (pair? an-rads2))
  (if (pair? an-raw-pws)
      (let ((u (car (car an-raw-pws))) (n (cadr (car an-raw-pws))))
        (if (not (every? (lambda (p) (and (equal? (car p) u) (equal? (cadr p) n))) an-raw-pws))
            (an-bad! "разные основания или показатели степеней")
            (let ((q0 (/ (foldl (lambda (g p) (gcd g (abs (numer (caddr p))))) 0 an-raw-pws)
                         (foldl (lambda (L p) (lcm L (denom (caddr p)))) 1 an-raw-pws))))
              (set! an-pw (list u n q0 'an-pn))
              (let* ((zj (lambda (j) (foldl (lambda (acc p) (an-add-new acc (simplify (list '+ (list '* (caddr p) n) (cadddr p) j))))
                                            '() an-raw-pws)))
                     (z1 (zj 1)) (z2 (zj 2))
                     (mult (+ 1 (min 1 (length an-logs)))))
                ; (q·n + k + 1) — со степенью до 2 при логарифмах (∫xⁿ log x), (q·n + k + 2) — первой
                (set! an-z (append (if (= mult 2) (append z1 z1) z1) z2))
                (if (> (length an-z) 6) (an-bad! "слишком много знаменателей показателя")))))))
  (if (pair? an-raw-trig)
      (let ((b (car an-raw-trig)))
        (if (every? (lambda (u) (equal? u b)) an-raw-trig)
            (set! an-trig (list b 'an-sn 'an-cs))
            (an-bad! "разные аргументы тригонометрии"))))
  (set! an-bricks (append (map cadr an-exp-classes) (map cadr an-logs) (map cadr an-specs)
                          (if an-pw (list 'an-pn) '()) (if an-rad (list 'an-s) '()) (if an-trig (list 'an-sn 'an-cs) '())
                          (map caddr an-rads2)))
  (set! an-kinds (append (map (lambda (c) (cons (cadr c) 'signed)) an-exp-classes)
                         (map (lambda (c) (cons (cadr c) 'nonneg)) an-logs)
                         (map (lambda (c) (cons (cadr c) 'nonneg)) an-specs)
                         (if an-pw (list (cons 'an-pn 'signed)) '())
                         (if an-rad (list (cons 'an-s 'signed)) '())
                         (if an-trig (list (cons 'an-sn 'nonneg) (cons 'an-cs 'nonneg)) '())
                         ; радикал: показатели от −(наибольшая отрицательная степень в f) до Q−1, бюджет d не расходуется
                         (map (lambda (r) (cons (caddr r) (list 'rad (an-rad-emin (car r)) (- (cadr r) 1)))) an-rads2))))

; наименьший показатель радикала-символа в f: base^(p/q) -> p·Q/q; не больше 0
(define (an-rad-emin b)
  (let ((Q (foldl (lambda (acc p) (if (equal? (car p) b) (lcm acc (denom (cdr p))) acc)) 1 an-raw-rads)))
    (foldl (lambda (acc p) (if (equal? (car p) b) (min acc (* (cdr p) Q)) acc)) 0 an-raw-rads)))

; ---------- сырое -> символьное (кирпичики заменены символами) ----------
(define (an-sym e)
  (cond ((not (an-has-x? e)) e)
        ((symbol? e) e)
        ((not (op-expr? e)) e)
        (else
         (let ((h (car e)) (args (cdr e)))
           (cond ((equal? h '+) (cons '+ (map an-sym args)))
                 ((equal? h '*) (cons '* (map an-sym args)))
                 ((equal? h '^)
                  (let ((r (nth e 2)))
                    (cond ((integer? r) (list '^ (an-sym (nth e 1)) r))
                          ((and (an-rat? r) an-rad) (list '^ 'an-s (* r (cadr an-rad))))
                          ((an-rat? r) (let ((p (assoc (simplify (nth e 1)) an-rads2))) (list '^ (caddr p) (* r (cadr p)))))
                          (else (let ((sp (an-pw-split r)))
                                  (list '* (list '^ 'an-pn (/ (cadr sp) (caddr an-pw)))
                                        (list '^ (an-sym (nth e 1)) (caddr sp))))))))
                 ((equal? h 'exp)
                  (let* ((u (simplify (car args)))
                         (c (car (filter (lambda (c) (an-rat? (an-ratio u (car c)))) an-exp-classes))))
                    (list '^ (cadr c) (an-ratio u (car c)))))
                 ((equal? h 'log) (cadr (assoc (simplify (car args)) an-logs)))
                 ((member? h '(sin cos))
                  (if (equal? h 'sin) 'an-sn 'an-cs))
                 ((equal? h 'tan) (list '* 'an-sn (list '^ 'an-cs -1)))
                 ((equal? h 'cot) (list '* 'an-cs (list '^ 'an-sn -1)))
                 ((equal? h 'sec) (list '^ 'an-cs -1))
                 ((equal? h 'csc) (list '^ 'an-sn -1))
                 (else (cadr (assoc (list h (simplify (car args))) an-specs))))))))

(define (an-rad2-of t)
  (let ((hit (filter (lambda (r) (equal? (caddr r) t)) an-rads2))) (and (pair? hit) (car hit))))

; D (d/dx) кирпичика-символа в символьной форме
(define (an-d e)
  (cons '+ (cons (diff an-x e)
                 (map (lambda (t) (list '* (diff t e) (an-D t)))
                      (filter (lambda (t) (contains-sym? e t)) an-bricks)))))

(define (an-D t)
  (let ((ec (filter (lambda (c) (equal? (cadr c) t)) an-exp-classes)))
    (cond ((pair? ec) (list '* (diff an-x (car (car ec))) t))
          ((assoc t (map (lambda (c) (list (cadr c) (car c))) an-logs))
           (let ((u (an-sym (car (car (filter (lambda (c) (equal? (cadr c) t)) an-logs))))))
             (list '* (an-d u) (list '^ u -1))))
          ((equal? t 'an-pn)
           (list '* (* (cadr an-pw) (caddr an-pw)) (diff an-x (car an-pw)) (list '^ (car an-pw) -1) t))
          ((equal? t 'an-s)
           (let ((u (car an-rad)))
             (list '* (/ 1 (cadr an-rad)) (diff an-x u) (list '^ u -1) t)))
          ((equal? t 'an-sn) (list '* (diff an-x (car an-trig)) 'an-cs))
          ((equal? t 'an-cs) (list '* -1 (diff an-x (car an-trig)) 'an-sn))
          ((an-rad2-of t)
           (let* ((r (an-rad2-of t)) (u (an-sym (car r))))
             (list '* (/ 1 (cadr r)) (an-d u) (list '^ u -1) t)))
          (else (an-sym (caddr (car (filter (lambda (c) (equal? (cadr c) t)) an-specs))))))))

; ---------- кандидаты логарифмов для радикалов ----------
(define (an-isqrt n)
  (if (< n 2) n
      (let loop ((r n)) (let ((nr (quotient (+ r (quotient n r)) 2))) (if (>= nr r) r (loop nr))))))

; рациональный квадратный корень или #f
(define (an-rsqrt q)
  (and (an-rat? q) (>= q 0)
       (let ((a (an-isqrt (numer q))) (b (an-isqrt (denom q))))
         (and (= (* a a) (numer q)) (= (* b b) (denom q)) (/ a b)))))

; log(s ± r) и log(αx + β + s) для s = u^(1/2): производные — классика псевдоэллиптических/гиперболических ответов
(define (an-rad-logs1 u dfac)
  (let* ((s (list '^ u 1/2))
         (usym (an-sym u))
         (pure (and (an-poly? u) (null? (int-symbols u an-x)))))
    (append
     (if (and pure (= (an-xdeg u) 2))
         (let* ((a (simplify (/ (diff an-x (diff an-x u)) 2))) (b (simplify (subst (list (list an-x 0)) (diff an-x u))))
                (al (an-rsqrt a)))
           (if (and al (> al 0)) (list (simplify (list '+ (list '* al an-x) (/ b (* 2 al)) s))) '()))
         '())
     (if pure
         (append-map
          (lambda (fm)
            (let ((v (car fm)))
              (if (and (an-poly? v) (null? (int-symbols v an-x)) (= (an-xdeg v) 1))
                  (let* ((c1 (simplify (diff an-x v))) (c0 (simplify (subst (list (list an-x 0)) v)))
                         (x0 (/ (- c0) c1)) (ur (simplify (subst (list (list an-x x0)) u))) (r (an-rsqrt ur)))
                    (cond ((not (an-rat? ur)) '())
                          ((= ur 0) (list u))
                          (r (list (simplify (list '+ s (- r))) (simplify (list '+ s r))))
                          (else '())))
                  '())))
          dfac)
         '())
     (append-map
      (lambda (c)
        (if (contains-sym? usym (cadr c))
            (let* ((ur (try (simplify (subst (list (list (cadr c) 0)) usym)) (lambda (e) #f))) (r (and ur (an-rsqrt ur))))
              (if (and r (> r 0)) (list (simplify (list '+ s (- r))) (simplify (list '+ s r))) '()))
            '()))
      an-exp-classes))))

(define (an-rad-logs dfac)
  (append-map (lambda (r) (if (= (cadr r) 2) (an-rad-logs1 (car r) dfac) '()))
              (append (if an-rad (list an-rad) '()) an-rads2)))

; ---------- знаменатели ----------
(define (an-denoms e)
  (cond ((not (op-expr? e)) '())
        ((and (equal? (car e) '^) (integer? (nth e 2)) (< (nth e 2) 0) (an-has-x? (nth e 1)))
         (cons (cons (nth e 1) (- (nth e 2))) (an-denoms (nth e 1))))
        (else (append-map an-denoms (cdr e)))))

; множители многочлена по x без параметров: ((множитель . кратность) …)
(define (an-nonneg? e)
  (cond ((not (op-expr? e)) #t)
        ((equal? (car e) '^) (and (integer? (nth e 2)) (>= (nth e 2) 0) (an-nonneg? (nth e 1))))
        (else (every? an-nonneg? (cdr e)))))

; кирпичики-символы -> сырые выражения
(define (an-back e) (foldl (lambda (acc t) (replace-expr acc t (an-brick-pow t 1))) e an-bricks))

; разложение многочлена от x и кирпичиков (без параметров) над ℚ: кирпичики — переменные
(define (an-factors base)
  (let ((s (an-sym base)))
    (if (and (null? (int-symbols base an-x)) (not (contains-sym? base 'pi)) (an-poly? s) (an-nonneg? s))
        (let ((fa (try (factor s) (lambda (err) s))))
          (let loop ((ts (if (and (op-expr? fa) (equal? (car fa) '*)) (cdr fa) (list fa))) (acc '()))
            (cond ((null? ts) (reverse acc))
                  ((not (an-has-xt? (car ts))) (loop (cdr ts) acc))
                  ((and (op-expr? (car ts)) (equal? (car (car ts)) '^) (integer? (nth (car ts) 2)) (> (nth (car ts) 2) 0))
                   (loop (cdr ts) (cons (cons (simplify (an-back (nth (car ts) 1))) (nth (car ts) 2)) acc)))
                  (else (loop (cdr ts) (cons (cons (simplify (an-back (car ts))) 1) acc))))))
        (list (cons base 1)))))

; содержит x или символ кирпичика
(define (an-has-xt? e) (or (an-has-x? e) (any? (lambda (t) (contains-sym? e t)) an-bricks)))

(define (an-fix e)
  (cond ((not (op-expr? e)) e)
        ((and (equal? (car e) 'sqrt) (= (length e) 2)) (list '^ (an-fix (cadr e)) 1/2))
        (else (cons (car e) (map an-fix (cdr e))))))

; ((множитель . степень) …): максимум по одинаковым
(define (an-denom-factors f)
  (let ((acc '()))
    (for-each
     (lambda (bm)
       (for-each
        (lambda (fm)
          (let* ((b (simplify (car fm))) (m (* (cdr bm) (cdr fm))) (old (assoc b acc)))
            (if old
                (if (> m (cdr old)) (set! acc (map (lambda (p) (if (equal? (car p) b) (cons b m) p)) acc)))
                (set! acc (append acc (list (cons b m)))))))
        (an-factors (car bm))))
     (an-denoms f))
    acc))

(define (an-xdeg e)
  (cond ((equal? e an-x) 1)
        ((not (op-expr? e)) 0)
        ((equal? (car e) '+) (foldl (lambda (a u) (max a (an-xdeg u))) 0 (cdr e)))
        ((equal? (car e) '*) (foldl (lambda (a u) (+ a (an-xdeg u))) 0 (cdr e)))
        ((and (equal? (car e) '^) (integer? (nth e 2)) (> (nth e 2) 0)) (* (nth e 2) (an-xdeg (nth e 1))))
        (else 0)))

; ---------- веса (Б1) ----------
(define an-wcons '())
(define an-wfail #f)

(define (wf-add1 a v c)
  (cond ((null? a) (if (= c 0) '() (list (cons v c))))
        ((equal? (car (car a)) v)
         (let ((s (+ (cdr (car a)) c))) (if (= s 0) (cdr a) (cons (cons v s) (cdr a)))))
        (else (cons (car a) (wf-add1 (cdr a) v c)))))
(define (wf-add a b) (foldl (lambda (acc p) (wf-add1 acc (car p) (cdr p))) a b))
(define (wf-scale a k) (if (= k 0) '() (map (lambda (p) (cons (car p) (* k (cdr p)))) a)))
(define (wf-sub a b) (wf-add a (wf-scale b -1)))
(define (an-wcon! f) (if (pair? f) (set! an-wcons (cons f an-wcons))))

(define (an-wform e)
  (cond ((number? e) '())
        ((equal? e an-x) (list (cons an-x 1)))
        ((equal? e 'pi) (an-wcon! (list (cons 'pi 1))) '())
        ((symbol? e) (list (cons e 1)))
        ((not (op-expr? e)) (set! an-wfail #t) '())
        (else
         (let ((h (car e)) (args (cdr e)))
           (cond ((equal? h '+)
                  (let ((fs (map an-wform args)))
                    (for-each (lambda (g) (an-wcon! (wf-sub g (car fs)))) (cdr fs))
                    (car fs)))
                 ((equal? h '*) (foldl wf-add '() (map an-wform args)))
                 ((and (equal? h '^) (number? (nth e 2))) (wf-scale (an-wform (nth e 1)) (nth e 2)))
                 ((and (equal? h '^) an-pw (an-pw-split (nth e 2)))
                  (let ((sp (an-pw-split (nth e 2))))
                    (wf-add (list (cons 'an-pn (/ (cadr sp) (caddr an-pw)))) (wf-scale (an-wform (nth e 1)) (caddr sp)))))
                 ((equal? h 'log) (an-wform (car args)) '())
                 ((member? h '(exp sin cos tan cot sec csc erf erfc erfi Ei li Si Ci atan))
                  (an-wcon! (an-wform (car args))) '())
                 (else (set! an-wfail #t) '()))))))

(define (an-wvec f vars) (map (lambda (v) (let ((p (assoc v f))) (if p (cdr p) 0))) vars))
(define (an-vadd a b) (map2 + a b))
(define (an-index-of v lst) (let loop ((l lst) (i 0)) (cond ((null? l) #f) ((equal? (car l) v) i) (else (loop (cdr l) (+ i 1))))))

; базис (по порядку вставки) со столбцами-ведущими: ((столбец . строка) …); строка нормирована на 1 в ведущем столбце
(define (an-lead v) (let loop ((v v) (i 0)) (cond ((null? v) #f) ((= (car v) 0) (loop (cdr v) (+ i 1))) (else i))))
(define (an-reduce v basis)
  (foldl (lambda (acc b) (let ((c (nth acc (car b))))
                           (if (= c 0) acc (map2 (lambda (p q) (- p (* c q))) acc (cdr b)))))
         v basis))
(define (an-basis-of rows)
  (foldl (lambda (basis r)
           (let* ((v (an-reduce r basis)) (l (an-lead v)))
             (if l (append basis (list (cons l (map (lambda (q) (/ q (nth v l))) v)))) basis)))
         '() rows))

; ---------- арифметика точек ----------
(define (an-rand) (set! an-seed (modulo (+ (* an-seed 1103515245) 12345) 2147483648)) (quotient an-seed 65536))
(define (an-rq) (/ (+ 2 (modulo (an-rand) 37)) (+ 2 (modulo (an-rand) 7))))
(define (an-pow q n)
  (if (< n 0) (/ 1 (an-pow q (- n)))
      (let loop ((k n) (acc 1)) (if (= k 0) acc (loop (- k 1) (* acc q))))))
(define (an-ev e rules)
  (try (let ((v (subst rules e))) (if (an-rat? v) v #f)) (lambda (err) #f)))

; точка: (правила x0 значения-кирпичиков значения-параметров kp) либо #f
(define (an-point)
  (let* ((pvals (map (lambda (p) (an-rq)) an-params))
         (kp (an-rq))
         (prules (append (map2 list an-params pvals) (list (list 'an-kp kp)))))
    (let* ((s (if an-rad (an-rq) #f))
           (x0 (if an-rad
                   (let* ((u (car an-rad)) (a (an-ev (diff an-x u) prules)) (b (an-ev (subst (list (list an-x 0)) u) prules)))
                     (and a b (not (= a 0)) (/ (- (an-pow s (cadr an-rad)) b) a)))
                   (an-rq)))
           (tr (if an-trig
                   (let* ((u (an-rq)) (den (+ 1 (* u u))))
                     (list (/ (* 2 u) den) (/ (- 1 (* u u)) den)))
                   #f)))
      (and x0 (not (= x0 0))
           (or (not an-trig) (and (not (= (car tr) 0)) (not (= (cadr tr) 0))))
           (let* ((tv (map (lambda (t)
                             (cond ((equal? t 'an-s) s)
                                   ((equal? t 'an-sn) (car tr))
                                   ((equal? t 'an-cs) (cadr tr))
                                   (else (an-rq))))
                           an-bricks)))
             (list (append (list (list an-x x0)) (map2 list an-bricks tv) prules) x0 tv pvals kp))))))

; ---------- точки по модулю P (an-mod?): радикалы над F_P ----------
(define an-evm-bad #f)
(define (an-mpow b n)
  (let ((P an-mp))
    (if (< n 0)
        (if (= b 0) (begin (set! an-evm-bad #t) 0) (an-mpow (an-modinv b P) (- n)))
        (let loop ((k n) (acc 1) (bb (modulo b P)))
          (cond ((= k 0) acc)
                ((= (modulo k 2) 1) (loop (quotient k 2) (modulo (* acc bb) P) (modulo (* bb bb) P)))
                (else (loop (quotient k 2) acc (modulo (* bb bb) P))))))))

; значение выражения из +, *, ^ (целая степень), чисел и символов по модулю P; env — ((символ . значение) …)
(define (an-evm e env)
  (cond ((number? e) (if (an-rat? e) (an-modq e an-mp) (begin (set! an-evm-bad #t) 0)))
        ((symbol? e) (let ((p (assoc e env))) (if p (cdr p) (begin (set! an-evm-bad #t) 0))))
        ((not (op-expr? e)) (set! an-evm-bad #t) 0)
        ((equal? (car e) '+) (foldl (lambda (acc a) (modulo (+ acc (an-evm a env)) an-mp)) 0 (cdr e)))
        ((equal? (car e) '*) (foldl (lambda (acc a) (modulo (* acc (an-evm a env)) an-mp)) 1 (cdr e)))
        ((and (equal? (car e) '^) (integer? (nth e 2))) (an-mpow (an-evm (nth e 1) env) (nth e 2)))
        (else (set! an-evm-bad #t) 0)))

(define (an-evmv e env)
  (set! an-evm-bad #f)
  (let ((v (an-evm e env))) (if an-evm-bad #f v)))

(define (an-rm) (+ 1 (modulo (+ (* (an-rand) 32768) (an-rand)) (- an-mp 1))))

; корень степени Q (2^a·3^b) в F_P (P ≡ 11 mod 12) или #f
(define (an-mroot v Q)
  (cond ((= Q 1) v)
        ((= (modulo Q 2) 0)
         (let ((s (an-mpow v (quotient (+ an-mp 1) 4))))
           (and (= (modulo (* s s) an-mp) v) (an-mroot s (quotient Q 2)))))
        (else (an-mroot (an-mpow v (quotient (+ (* 2 (- an-mp 1)) 1) 3)) (quotient Q 3)))))

; точка по модулю P: (env x0 значения-кирпичиков значения-параметров kp) либо #f
(define (an-point-m)
  (let* ((pvals (map (lambda (p) (an-rm)) an-params))
         (kp (an-rm))
         (x0 (an-rm))
         (env0 (append (list (cons an-x x0) (cons 'an-kp kp)) (map2 cons an-params pvals)))
         (tr (if an-trig (let* ((u (an-rm)) (den (modulo (+ 1 (* u u)) an-mp)))
                           (and (not (= den 0))
                                (let ((dinv (an-modinv den an-mp)))
                                  (list (modulo (* 2 u dinv) an-mp) (modulo (* (- 1 (* u u)) dinv) an-mp)))))
                 #f)))
    (and (or (not an-trig) (and tr (not (= (car tr) 0)) (not (= (cadr tr) 0))))
         (let loop ((bs an-bricks) (env env0) (tv '()))
           (if (null? bs)
               (list env x0 (reverse tv) pvals kp)
               (let* ((t (car bs))
                      (r2 (an-rad2-of t))
                      (v (cond ((equal? t 'an-sn) (car tr))
                               ((equal? t 'an-cs) (cadr tr))
                               (r2 (let ((u (an-evmv (cdr (assoc t an-rusyms)) env))) (and u (not (= u 0)) (an-mroot u (cadr r2)))))
                               (else (an-rm)))))
                 (and v (loop (cdr bs) (cons (cons t v) env) (cons v tv)))))))))

(define (an-coef-m u x0 tv pv kp Dv Dval Dl lv)
  (let* ((P an-mp)
         (pa (foldl (lambda (acc pp) (modulo (* acc (an-mpow (car pp) (cdr pp))) P)) 1 (map2 cons pv (nth u 3))))
         (kpf (an-mpow kp (nth u 4))))
    (if (equal? (car u) 'log)
        (modulo (* pa kpf (nth lv (nth u 1))) P)
        (let* ((i (nth u 1)) (ev (nth u 2))
               (bm (modulo (* (an-mpow x0 i) (foldl (lambda (acc q) (modulo (* acc (an-mpow (car q) (cdr q))) P)) 1 (map2 cons tv ev))
                              pa (an-modinv Dval P) kpf) P))
               (lg (modulo (+ (* i (an-modinv x0 P)) (an-sum3m ev Dv tv) (- Dl)) P)))
          (modulo (* bm lg) P)))))

(define (an-sum3m ev Dv tv)
  (if (null? ev) 0 (modulo (+ (* (car ev) (car Dv) (an-modinv (car tv) an-mp)) (an-sum3m (cdr ev) (cdr Dv) (cdr tv))) an-mp)))

; ---------- неизвестные ----------
(define (an-evecs ranges d)
  (if (null? ranges)
      (list '())
      (let ((rad? (pair? (car ranges))))
        (append-map (lambda (e)
                      (map (lambda (rest) (cons e rest)) (an-evecs (cdr ranges) (if rad? d (- d (abs e))))))
                    (cond (rad? (map (lambda (i) (+ i (cadr (car ranges)))) (range (+ 1 (- (caddr (car ranges)) (cadr (car ranges)))))))
                          ((equal? (car ranges) 'signed) (map (lambda (i) (- i d)) (range (+ 1 (* 2 d)))))
                          (else (range (+ d 1))))))))

(define (an-alphas ranges)
  (if (null? ranges)
      (list '())
      (append-map (lambda (a) (map (lambda (r) (cons a r)) (an-alphas (cdr ranges))))
                  (map (lambda (i) (+ i (car (car ranges)))) (range (+ 1 (- (cdr (car ranges)) (car (car ranges)))))))))

; ---------- главный перебор ----------
(define (an-out-of-time?) (> (clock-us) an-deadline))

; Гаусс — Жордан над ℚ (P = 0) или над ℤ/P (P простое < 2³¹; строки уже по модулю P).
; Результат: список значений (свободные неизвестные 0), #f — несовместна, 'timeout — бюджет.
(define (an-modinv a P)
  (let loop ((r0 P) (r1 (modulo a P)) (s0 0) (s1 1))
    (if (= r1 0)
        (modulo s0 P)
        (let ((q (quotient r0 r1)))
          (loop r1 (- r0 (* q r1)) s1 (- s0 (* q s1)))))))

(define (an-modq q P)
  (modulo (* (modulo (numer q) P) (an-modinv (denom q) P)) P))

; восстановление рационального числа по модулю P (Ванг); #f — не вышло
(define an-prime 2147483647)
(define an-bound 32767)
(define (an-ratrec a P)
  (let loop ((r0 P) (r1 a) (s0 0) (s1 1))
    (if (> r1 an-bound)
        (let ((q (quotient r0 r1)))
          (loop r1 (- r0 (* q r1)) s1 (- s0 (* q s1))))
        (let ((d (if (< s1 0) (- s1) s1)) (nn (if (< s1 0) (- r1) r1)))
          (and (not (= d 0)) (<= d an-bound) (= (gcd (abs nn) d) 1) (/ nn d))))))

(define (an-gauss rows n P)
  (let ((m (list->vector (map list->vector rows))))
    (let ((nr (vlength m)))
      (let loop ((col 0) (r 0) (piv '()))
        (cond ((an-out-of-time?) 'timeout)
              ((or (= col n) (= r nr))
               (if (let chk ((i r)) (cond ((>= i nr) #f) ((not (= (vref (vref m i) n) 0)) #t) (else (chk (+ i 1)))))
                   #f
                   (let ((sol (make-vector n 0)))
                     (for-each (lambda (p) (vset! sol (car p) (vref (vref m (cdr p)) n))) piv)
                     (vector->list sol))))
              (else
               (let ((p (an-find-pivot m r nr col)))
                 (if (not p)
                     (loop (+ col 1) r piv)
                     (begin
                       (an-eliminate! m p r nr col n P)
                       (loop (+ col 1) (+ r 1) (cons (cons col r) piv)))))))))))

(define (an-find-pivot m r nr col)
  (let find ((i r))
    (cond ((>= i nr) #f)
          ((not (= (vref (vref m i) col) 0)) i)
          (else (find (+ i 1))))))

; ведущая строка p переставляется на место r, нормируется и вычитается из всех остальных
(define (an-eliminate! m p r nr col n P)
  (let ((tmp (vref m p)))
    (vset! m p (vref m r))
    (vset! m r tmp))
  (let* ((row (vref m r)) (inv (if (= P 0) (/ 1 (vref row col)) (an-modinv (vref row col) P))))
    (let nl ((j col))
      (if (<= j n)
          (begin (vset! row j (if (= P 0) (* (vref row j) inv) (modulo (* (vref row j) inv) P))) (nl (+ j 1)))))
    (let el ((i 0))
      (if (< i nr)
          (begin
            (if (not (= i r))
                (let* ((ri (vref m i)) (f (vref ri col)))
                  (if (not (= f 0))
                      (let ul ((j col))
                        (if (<= j n)
                            (begin (vset! ri j (if (= P 0)
                                                   (- (vref ri j) (* f (vref row j)))
                                                   (modulo (- (vref ri j) (* f (vref row j))) P)))
                                   (ul (+ j 1))))))))
            (el (+ i 1)))))))

; одна попытка при степени d: F или #f; пишет статистику
(define (an-try-d f0 f d X dfac lbases wD Wf rad-w basis vars B)
  (let* ((ranges (map (lambda (t) (cdr (assoc t an-kinds))) an-bricks))
         (evecs (an-evecs ranges d))
         (k (length an-params))
         (alphas (an-alphas (map (lambda (p) (if (and an-pw (equal? p (cadr an-pw))) (cons 0 (length an-z)) (cons (- B) B))) an-params)))
         (avecs (map (lambda (a) (append (cons 0 a) (if an-pw '(0) '()))) alphas))
         (pn-pos (if an-pw (an-index-of 'an-pn an-bricks) #f))
         (aps (map2 cons alphas avecs))
         (kpas (if an-kp-used '(-1 0 1) '(0)))
         (rad-pos (map (lambda (r) (cons (an-index-of (car r) an-bricks) (cdr r))) rad-w))
         (bf (wf-sub (wf-scale (wf-add wD Wf) -1) (list (cons an-x 1))))
         (ex (list (cons an-x 1))))
    (let* ((cores '()))
      ; (i evec вектор-веса-ядра)
      (for-each
       (lambda (i)
         (for-each
          (lambda (ev)
            (let* ((wcore (wf-add (wf-add (wf-add bf (wf-scale ex i)) (foldl (lambda (acc rp) (if (= (nth ev (car rp)) 0) acc (wf-add acc (wf-scale (cdr rp) (nth ev (car rp)))))) '() rad-pos))
                                  (if (and pn-pos (not (= (nth ev pn-pos) 0))) (list (cons 'an-pn (nth ev pn-pos))) '())))
                   (cv (an-wvec wcore vars)))
              (set! cores (cons (list i ev cv) cores))))
          evecs))
       (range (+ X 1)))
      (set! cores (reverse cores))
      (let* ((use-w (and an-use-weights (not an-wfail) (< (length basis) (length vars))))
             (unf-count (* (+ (* (length cores) (length avecs)) (* (length lbases) (length avecs))) (length kpas)))
             (mono-unknowns
              (append-map
               (lambda (c)
                 (append-map
                  (lambda (ap)
                    (if (or (not use-w) (every? (lambda (q) (= q 0)) (an-reduce (an-vadd (nth c 2) (cdr ap)) basis)))
                        (map (lambda (kpa) (list 'mono (car c) (cadr c) (car ap) kpa)) kpas)
                        '()))
                  aps))
               cores))
             (log-unknowns
              (append-map
               (lambda (j)
                 (append-map
                  (lambda (ap)
                    (if (or (not use-w) (every? (lambda (q) (= q 0)) (an-reduce (an-vadd (an-wvec (wf-sub (list (cons an-x 0)) (wf-add Wf ex)) vars) (cdr ap)) basis)))
                        (map (lambda (kpa) (list 'log j '() (car ap) kpa)) kpas)
                        '()))
                  aps))
               (range (length lbases))))
             (unknowns (append mono-unknowns log-unknowns))
             (nu (length unknowns)))
        (set! an-stats (append an-stats (list (list d unf-count nu use-w))))
        (cond ((= nu 0) #f)
              ((> nu an-max-unknowns) (an-bad! "слишком много неизвестных") #f)
              (else (an-solve-d f0 f unknowns nu dfac lbases)))))))

; строки системы и решение; unknowns: ('mono i evec alpha kpa) | ('log j () alpha kpa)
(define (an-solve-d f0 f unknowns nu dfac lbases)
  (let* ((fsym (an-sym f))
         (Dexprs (map an-D an-bricks))
         (Dsym (cons '* (append an-z (map (lambda (fm) (list '^ (an-sym (car fm)) (cdr fm))) dfac))))
         (Dlog (cons '+ (map (lambda (fm) (list '* (cdr fm) (an-d (an-sym (car fm))) (list '^ (an-sym (car fm)) -1))) dfac)))
         (lsyms (map (lambda (v) (an-sym v)) lbases))
         (ldexprs (map (lambda (v) (list '* (an-d v) (list '^ v -1))) lsyms))
         (npts (+ nu 5))
         (PP (if an-mod? an-mp an-prime)))
    (set! an-rusyms (map (lambda (r) (cons (caddr r) (an-sym (car r)))) an-rads2))
    (let loop ((pts 0) (tries 0) (rows '()))
      (cond ((an-out-of-time?) (an-bad! "бюджет") #f)
            ((> tries (* (if an-mod? 60 4) npts)) (an-bad! "точки не вычисляются") #f)
            ((= pts npts)
             (let* ((t1 (clock-us))
                    (prow (if an-mod? rows (map (lambda (row) (map (lambda (q) (an-modq q an-prime)) row)) rows)))
                    (sol-p (an-gauss prow nu PP))
                    (t2 (clock-us)))
               (set! an-stats (append an-stats (list (list 'gauss-ms (quotient (- t2 t1) 1000)))))
               (cond ((equal? sol-p 'timeout) (an-bad! "бюджет") #f)
                     ((not sol-p) #f)
                     (else
                      (let ((sol (map (lambda (a) (if (= a 0) 0 (an-ratrec a PP))) sol-p)))
                        (cond ((every? (lambda (q) q) sol) (an-assemble f0 f unknowns sol dfac lbases))
                              ((and (<= nu 40) (not an-mod?))
                               (let ((ex (an-gauss rows nu 0)))
                                 (and ex (not (equal? ex 'timeout)) (an-assemble f0 f unknowns ex dfac lbases))))
                              (else (an-bad! "коэффициенты не восстановлены") #f)))))))
            (else
             (let ((pt (if an-mod? (an-point-m) (an-point))))
               (if (not pt)
                   (loop pts (+ tries 1) rows)
                   (let* ((rules (car pt)) (x0 (cadr pt)) (tv (caddr pt)) (pv (cadddr pt)) (kp (car (cddddr pt)))
                          (ev (if an-mod? (lambda (e) (an-evmv e rules)) (lambda (e) (an-ev e rules))))
                          (fv (ev fsym))
                          (Dv (map ev Dexprs))
                          (Dval (ev Dsym))
                          (Dl (ev Dlog))
                          (lv (map ev ldexprs)))
                     (if (not (and fv Dval Dl (not (= Dval 0)) (every? (lambda (q) q) Dv) (every? (lambda (q) q) lv)))
                         (loop pts (+ tries 1) rows)
                         (let ((row (map (lambda (u) (if an-mod? (an-coef-m u x0 tv pv kp Dv Dval Dl lv) (an-coef u x0 tv pv kp Dv Dval Dl lv))) unknowns)))
                           (loop (+ pts 1) tries (cons (append row (list fv)) rows))))))))))))

(define (an-coef u x0 tv pv kp Dv Dval Dl lv)
  (let ((pa (foldl (lambda (acc pp) (* acc (an-pow (car pp) (cdr pp)))) 1 (map2 cons pv (nth u 3))))
        (kpf (an-pow kp (nth u 4))))
    (if (equal? (car u) 'log)
        (* pa kpf (nth lv (nth u 1)))
        (let* ((i (nth u 1)) (ev (nth u 2))
               (bm (* (an-pow x0 i) (foldl (lambda (acc q) (* acc (an-pow (car q) (cdr q)))) 1 (map2 cons tv ev)) (/ pa Dval) kpf))
               (lg (+ (/ i x0) (an-sum3 ev Dv tv) (- Dl))))
          (* bm lg)))))

(define (an-sum3 ev Dv tv)
  (if (null? ev) 0 (+ (* (car ev) (/ (car Dv) (car tv))) (an-sum3 (cdr ev) (cdr Dv) (cdr tv)))))

; ---------- сборка ответа ----------
(define (an-brick-pow t e)
  (if (= e 0)
      1
      (let ((ec (filter (lambda (c) (equal? (cadr c) t)) an-exp-classes))
            (lc (filter (lambda (c) (equal? (cadr c) t)) an-logs))
            (sc (filter (lambda (c) (equal? (cadr c) t)) an-specs)))
        (cond ((pair? ec) (list 'exp (list '* e (car (car ec)))))
              ((pair? lc) (list '^ (list 'log (car (car lc))) e))
              ((pair? sc) (list '^ (car (car sc)) e))
              ((equal? t 'an-pn) (list '^ (car an-pw) (list '* e (caddr an-pw) (cadr an-pw))))
              ((equal? t 'an-s) (list '^ (car an-rad) (/ e (cadr an-rad))))
              ((an-rad2-of t) (list '^ (car (an-rad2-of t)) (/ e (cadr (an-rad2-of t)))))
              ((equal? t 'an-sn) (list '^ (list 'sin (car an-trig)) e))
              (else (list '^ (list 'cos (car an-trig)) e))))))

; со степенью u^(q·n+k) знаменатели (n+1)(n+2) не сокращаются сами — together и выбор более короткой записи
(define (an-tidy F)
  (if (not an-pw)
      F
      (let ((G (try (simplify (together F)) (lambda (e) F))))
        (if (< (string-length (to-string G)) (string-length (to-string F))) G F))))

(define (an-assemble f0 f unknowns sol dfac lbases)
  (let* ((Draw (cons '* (append (map (lambda (z) (list '^ z -1)) an-z) (map (lambda (fm) (list '^ (car fm) (- (cdr fm)))) dfac))))
         (terms
          (filter (lambda (t) t)
                  (map2 (lambda (u c)
                          (if (= c 0)
                              #f
                              (let ((pa (cons '* (map (lambda (pp) (list '^ (car pp) (cdr pp))) (map2 cons an-params (nth u 3)))))
                                    (kpf (list '^ 'an-kp (nth u 4))))
                                (if (equal? (car u) 'log)
                                    (list '* c (list 'log (nth lbases (nth u 1))) pa kpf)
                                    (cons '* (cons c (cons (list '^ an-x (nth u 1))
                                                           (cons pa (cons kpf (cons Draw (map2 an-brick-pow an-bricks (nth u 2))))))))))))
                        unknowns sol))))
    (and (pair? terms)
         (let* ((F0 (simplify (cons '+ terms)))
                (F (an-tidy (simplify (replace-expr F0 'an-kp '(* 2 (^ pi -1/2)))))))
           (and (not (equal? F 0))
                (not (contains-sym? F 'an-kp))
                (or (int-check F f0 an-x) (int-check F f an-x))
                F)))))

; степень u^(n+k) с k ≤ −2: первообразная содержит u^(k+1) — основание добавляется в знаменатель D
(define (an-pw-dfac d0)
  (if (not an-pw)
      d0
      (let ((m (- -1 (foldl (lambda (a p) (min a (cadddr p))) 0 an-raw-pws))))
        (if (<= m 0)
            d0
            (foldl (lambda (acc fm)
                     (let* ((b (simplify (car fm))) (mm (* m (cdr fm))) (old (assoc b acc)))
                       (cond ((not old) (append acc (list (cons b mm))))
                             ((< (cdr old) mm) (map (lambda (p) (if (equal? (car p) b) (cons b mm) p)) acc))
                             (else acc))))
                   d0 (an-factors (car an-pw)))))))

; ---------- вход ----------
(define (an-run f0 x dmax tlim)
  (set! an-stats '())
  (an-reset!)
  (set! an-x x) (set! an-wcons '()) (set! an-wfail #f)
  (set! an-deadline (+ (clock-us) (* tlim 1000000)))
  (let ((f (simplify (an-fix (int-hyp f0)))))
    (cond ((not (an-has-x? f)) #f)
          ((contains-sym? f '%i) #f)
          (else
           (set! an-params (append (int-symbols f x) (if (contains-sym? f 'pi) (list 'pi) '())))
           (an-scan f)
           (if (or an-fail (> (length an-params) 3))
               #f
               (begin
                 (an-build-all)
                 (if an-fail
                     #f
                     (let* ((dfac (an-pw-dfac (an-denom-factors f)))
                            (lbases (let loop ((l (append (map car dfac) an-raw-lbase (an-rad-logs dfac))) (acc '()))
                                      (cond ((null? l) (reverse acc))
                                            ((member? (car l) acc) (loop (cdr l) acc))
                                            (else (loop (cdr l) (cons (car l) acc))))))
                            (X (+ 1 (an-xdeg f) (if an-pw (foldl (lambda (a p) (max a (+ 1 (cadddr p)))) 0 an-raw-pws) 0) (foldl (lambda (a fm) (+ a (* (cdr fm) (an-xdeg (car fm))))) 0 dfac)
                                 (foldl (lambda (a r) (+ a (an-xdeg (car r)))) 0 an-rads2)))
                            (vars (append (cons x an-params) (if an-pw (list 'an-pn) '())))
                            (Wf (begin (if an-pw (an-wcon! (list (cons (cadr an-pw) 1)))) (an-wform f)))
                            (wD (foldl (lambda (a fm) (wf-add a (wf-scale (an-wform (car fm)) (cdr fm)))) '() dfac))
                            (rad-w (append (if an-rad (list (cons 'an-s (wf-scale (an-wform (car an-rad)) (/ 1 (cadr an-rad))))) '())
                                           (map (lambda (r) (cons (caddr r) (wf-scale (an-wform (car r)) (/ 1 (cadr r))))) an-rads2)))
                            (basis (an-basis-of (map (lambda (c) (an-wvec c vars)) an-wcons)))
                            (B (if (and an-use-weights (not an-wfail) (pair? basis)) (if (< (length an-params) 3) 3 2) 1)))
                       (let loop ((d 1))
                         (cond ((> d dmax) #f)
                               (else
                                (let ((F (an-try-d f0 f d X dfac lbases wD Wf rad-w basis vars B)))
                                  (cond (F F)
                                        (an-fail #f)
                                        ((an-out-of-time?) #f)
                                        (else (loop (+ d 1))))))))))))))))

; ---------- подъём числовых констант в параметры (INT.ANSATZ.2) ----------
; f без параметров: eˣ·sin x → e^(la·x)·sin(lb·x), 1/(x⁴+1) → 1/(x⁴+lc). Параметрическая задача решается с весовым
; фильтром (параметр получает вес из однородности — неизвестных меньше), затем значения подставляются и ответ проверяется
; int-check на исходном f. Поднимаются: коэффициент при x в линейном аргументе exp (классы по рациональному отношению —
; связи между экспонентами сохраняются), аргумент sin/cos/tan/… (если везде одинаков) и свободный член многочлена
; степени ≥ 2 в основании степени. Не более 3 параметров.
; по умолчанию выключено (замер на 6 910 «трудных» задачах: 0 новых ответов, +9 % времени); включение: (int-ansatz f x d tlim #t)
(define int-ansatz-lift-enabled #f)
(define lf-classes '())   ; ((c0 символ) …)
(define lf-subs '())      ; ((символ значение) …)
(define lf-trig #f)       ; (c d символ) | 'bad
(define lf-names '(la lb lc))

(define (lf-new! val)
  (if (>= (length lf-subs) 3)
      (begin (set! an-fail "подъём: больше 3 параметров") 'none)
      (let ((s (nth lf-names (length lf-subs))))
        (set! lf-subs (append lf-subs (list (list s val))))
        s)))

; (c . d) для линейного по x аргумента с рациональным c ≠ 0 и x-свободным d
(define (lf-lin u)
  (let ((c (simplify (diff an-x u))))
    (and (an-rat? c) (not (= c 0))
         (let ((d (simplify (subst (list (list an-x 0)) u))))
           (and (not (an-has-x? d)) (cons c d))))))

(define (lf-exp c d)
  (let ((hit (filter (lambda (k) (an-rat? (/ c (car k)))) lf-classes)))
    (if (pair? hit)
        (list 'exp (list '+ (list '* (/ c (car (car hit))) (cadr (car hit)) an-x) d))
        (let ((s (lf-new! c)))
          (if (equal? s 'none)
              #f
              (begin (set! lf-classes (append lf-classes (list (list c s))))
                     (list 'exp (list '+ (list '* s an-x) d))))))))

(define (lf-trig-arg h c d)
  (cond ((equal? lf-trig 'bad) #f)
        ((not lf-trig)
         (let ((s (lf-new! c)))
           (if (equal? s 'none) #f
               (begin (set! lf-trig (list c d s)) (list h (list '+ (list '* s an-x) d))))))
        ((and (equal? c (car lf-trig)) (equal? d (cadr lf-trig))) (list h (list '+ (list '* (caddr lf-trig) an-x) d)))
        (else (set! lf-trig 'bad) #f)))

(define (lf-walk e)
  (cond ((not (op-expr? e)) e)
        ((not (an-has-x? e)) e)
        ((equal? (car e) 'exp)
         (let ((lc (lf-lin (cadr e))))
           (or (and lc (lf-exp (car lc) (cdr lc))) (cons 'exp (map lf-walk (cdr e))))))
        ((member? (car e) '(sin cos tan cot sec csc))
         (let ((lc (lf-lin (cadr e))))
           (or (and lc (lf-trig-arg (car e) (car lc) (cdr lc))) (cons (car e) (map lf-walk (cdr e))))))
        ((and (equal? (car e) '^) (an-poly? (nth e 1)) (>= (an-xdeg (nth e 1)) 2))
         (let ((c0 (simplify (subst (list (list an-x 0)) (nth e 1)))))
           (if (and (an-rat? c0) (not (= c0 0)))
               (let ((s (lf-new! c0)))
                 (if (equal? s 'none) e
                     (list '^ (list '+ (list '* -1 c0) (nth e 1) s) (lf-walk (nth e 2)))))
               (cons '^ (map lf-walk (cdr e))))))
        (else (cons (car e) (map lf-walk (cdr e))))))

; (f′ . подстановка) или #f
(define (lf-run f)
  (set! lf-classes '()) (set! lf-subs '()) (set! lf-trig #f)
  (let ((g (lf-walk f)))
    (and (pair? lf-subs) (not (equal? lf-trig 'bad))
         (cons (simplify g) (map (lambda (p) (list (car p) (cadr p))) lf-subs)))))

(define (an-lifted f0 x dmax tlim)
  (set! an-x x)
  (let* ((f (simplify (an-fix (int-hyp f0)))) (lf (and (null? (int-symbols f x)) (not (contains-sym? f 'pi)) (lf-run f))))
    (and lf
         (let* ((st an-stats)
                (F (an-run (car lf) x dmax tlim))
                (st2 an-stats))
           (set! an-stats (append st (list (list 'lift (map car (cdr lf)))) st2))
           (and F
                (let ((F2 (try (simplify (subst (cdr lf) F)) (lambda (err) #f))))
                  (and F2 (not (equal? F2 0)) (int-check F2 f0 x) F2)))))))

; условия на показатель: знаменатель (q·n + k + j) в ответе при его корне — особая точка F (u^(n+1)/(n+1) при n = −1 -> log)
(define (an-singular? e)
  (cond ((not (op-expr? e)) #f)
        ((and (equal? (car e) '^) (equal? (nth e 1) 0) (number? (nth e 2)) (< (nth e 2) 0)) #t)
        (else (any? an-singular? (cdr e)))))

(define (an-record-conds F)
  (let ((n (cadr an-pw)))
    (for-each
     (lambda (z)
       (let* ((q (diff n z)) (c (simplify (subst (list (list n 0)) z)))
              (v (try (simplify (subst (list (list n (- (/ c q)))) F)) (lambda (e) 'err))))
         (if (or (equal? v 'err) (an-singular? v))
             (record-condition (list '/= z 0) "анзац: показатель степени — ответ верен, пока знаменатель не обращается в 0 (иначе логарифм или другая форма)"))))
     an-z)))

; ---------- комплексный анзац ℚ(i): гауссовы показатели (INT.ANSATZ.3) ----------
; f = Σ P_k(x)·exp(a x² + b x + c), a ∈ ℚ, b, c ∈ ℚ(i), P_k ∈ ℚ(i)[x]; sin/cos линейных и квадратичных аргументов переписываются
; через exp(±i·u). Для каждой тройки (a b c): ∫ P e^(a x²+b x) = R(x) e^(a x²+b x) + γ ∫ e^(a x²+b x), R — многочлен (треугольная
; система над ℚ(i)), ∫ e^(a x²+b x) = e^(−b²/4a) √π/(2√|a|) · erf(√−a (x + b/2a)) при a < 0, erfi(√a …) при a > 0.
; Ответ вещественен на вещественной оси: для каждой тройки (a b c) есть сопряжённая с сопряжёнными коэффициентами (проверяется).
; Комплексные числа — пары (re . im) рациональных; многочлены — списки (степень . число) по убыванию степени.
(define (cx+ a b) (cons (+ (car a) (car b)) (+ (cdr a) (cdr b))))
(define (cx* a b) (cons (- (* (car a) (car b)) (* (cdr a) (cdr b))) (+ (* (car a) (cdr b)) (* (cdr a) (car b)))))
(define (cx-neg a) (cons (- (car a)) (- (cdr a))))
(define (cx-inv a) (let ((n (+ (* (car a) (car a)) (* (cdr a) (cdr a))))) (cons (/ (car a) n) (/ (- (cdr a)) n))))
(define (cx-conj a) (cons (car a) (- (cdr a))))
(define (cx0? a) (and (= (car a) 0) (= (cdr a) 0)))
(define cx-zero (cons 0 0))
(define cx-one (cons 1 0))
(define cx-i (cons 0 1))
(define (cx-expr a)
  (cond ((= (cdr a) 0) (car a))
        ((= (car a) 0) (list '* (cdr a) '%i))
        (else (list '+ (car a) (list '* (cdr a) '%i)))))

(define (gp-add p q)   ; p, q — alist (deg . cx); результат без нулей, по убыванию степени
  (let ((acc '()))
    (for-each (lambda (t)
                (let ((old (assoc (car t) acc)))
                  (set! acc (if old (map (lambda (u) (if (= (car u) (car t)) (cons (car u) (cx+ (cdr u) (cdr t))) u)) acc) (cons t acc)))))
              (append p q))
    (sort (filter (lambda (t) (not (cx0? (cdr t)))) acc) (lambda (a b) (> (car a) (car b))))))
(define (gp-mul p q)
  (foldl (lambda (acc t) (gp-add acc (map (lambda (u) (cons (+ (car t) (car u)) (cx* (cdr t) (cdr u)))) q))) '() p))
(define (gp-scale p c) (filter (lambda (t) (not (cx0? (cdr t)))) (map (lambda (t) (cons (car t) (cx* (cdr t) c))) p)))
(define (gp-coef p k) (let ((t (assoc k p))) (if t (cdr t) cx-zero)))
(define (gp-deg p) (if (null? p) -1 (car (car p))))

; gsum: alist ((a b c) . poly)
(define (gs-add s t)
  (let ((acc '()))
    (for-each (lambda (e)
                (let ((old (assoc (car e) acc)))
                  (set! acc (if old (map (lambda (u) (if (equal? (car u) (car e)) (cons (car u) (gp-add (cdr u) (cdr e))) u)) acc) (append acc (list e))))))
              (append s t))
    (filter (lambda (e) (pair? (cdr e))) acc)))
(define (gs-mul s t)
  (foldl (lambda (acc e)
           (gs-add acc (map (lambda (g) (cons (list (+ (car (car e)) (car (car g)))
                                                    (cx+ (cadr (car e)) (cadr (car g)))
                                                    (cx+ (caddr (car e)) (caddr (car g))))
                                              (gp-mul (cdr e) (cdr g))))
                            t)))
         '() s))
(define gs-key0 (list 0 cx-zero cx-zero))
(define (gs-const c) (if (cx0? c) '() (list (cons gs-key0 (list (cons 0 c))))))
(define (gs-scale s c) (filter (lambda (e) (pair? (cdr e))) (map (lambda (e) (cons (car e) (gp-scale (cdr e) c))) s)))
; константа (cx) — если s = const
(define (gs-as-const s)
  (cond ((null? s) cx-zero)
        ((and (= (length s) 1) (equal? (car (car s)) gs-key0) (every? (lambda (t) (= (car t) 0)) (cdr (car s))))
         (gp-coef (cdr (car s)) 0))
        (else #f)))

(define gx-bad #f)
(define (gx-parse e)
  (cond ((an-rat? e) (gs-const (cons e 0)))
        ((equal? e an-x) (list (cons gs-key0 (list (cons 1 cx-one)))))
        ((equal? e '%i) (gs-const cx-i))
        ((not (op-expr? e)) (set! gx-bad #t) '())
        ((equal? (car e) '+) (foldl gs-add '() (map gx-parse (cdr e))))
        ((equal? (car e) '*) (foldl gs-mul (gs-const cx-one) (map gx-parse (cdr e))))
        ((and (equal? (car e) '^) (integer? (nth e 2)))
         (let ((b (gx-parse (nth e 1))) (n (nth e 2)))
           (cond ((>= n 0) (let loop ((k n) (acc (gs-const cx-one))) (if (= k 0) acc (loop (- k 1) (gs-mul acc b)))))
                 ((gs-as-const b) (let ((c (cx-inv (gs-as-const b)))) (let loop ((k (- n)) (acc (gs-const cx-one))) (if (= k 0) acc (loop (- k 1) (gs-scale acc c))))))
                 (else (set! gx-bad #t) '()))))
        ((equal? (car e) 'exp) (gx-exp (gx-parse (cadr e))))
        ((member? (car e) '(sin cos))
         (let* ((w (gx-parse (cadr e))) (wp (gx-exp (gs-scale w cx-i))) (wm (gx-exp (gs-scale w (cx-neg cx-i)))))
           (if (equal? (car e) 'sin)
               (gs-scale (gs-add wp (gs-scale wm (cons -1 0))) (cons 0 -1/2))
               (gs-scale (gs-add wp wm) (cons 1/2 0)))))
        (else (set! gx-bad #t) '())))

; exp от многочлена степени ≤ 2 (gsum без экспонент) -> gsum
(define (gx-exp w)
  (if (or gx-bad (any? (lambda (e) (not (equal? (car e) gs-key0))) w))
      (begin (set! gx-bad #t) '())
      (let* ((p (if (null? w) '() (cdr (car w)))) (c0 (gp-coef p 0)) (c1 (gp-coef p 1)) (c2 (gp-coef p 2)))
        (if (or (> (gp-deg p) 2) (not (= (cdr c2) 0)))
            (begin (set! gx-bad #t) '())
            (list (cons (list (car c2) c1 c0) (list (cons 0 cx-one))))))))

; R, γ для ∫ P e^(a x²+b x): (R γ) или #f
(define (gx-hermite p a b)
  (let* ((n (gp-deg p)) (acx (cons a 0)))
    (cond ((< n 0) (list '() cx-zero))
          ((not (= a 0))
           (let ((inv2a (cx-inv (cx* (cons 2 0) acx))) (r (make-vector (+ n 3) cx-zero)))
             (let loop ((k n))
               (if (>= k 1)
                   (begin (vset! r (- k 1) (cx* (cx+ (gp-coef p k) (cx-neg (cx+ (cx* (cons (+ k 1) 0) (vref r (+ k 1))) (cx* b (vref r k))))) inv2a))
                          (loop (- k 1)))))
             (list (let build ((k 0) (acc '())) (if (> k n) (gp-add acc '()) (build (+ k 1) (gp-add acc (if (cx0? (vref r k)) '() (list (cons k (vref r k))))))))
                   (cx+ (gp-coef p 0) (cx-neg (cx+ (vref r 1) (cx* b (vref r 0))))))))
          ((cx0? b) #f)
          (else
           (let ((ib (cx-inv b)) (r (make-vector (+ n 3) cx-zero)))
             (let loop ((k n))
               (if (>= k 0)
                   (begin (vset! r k (cx* (cx+ (gp-coef p k) (cx-neg (cx* (cons (+ k 1) 0) (vref r (+ k 1))))) ib))
                          (loop (- k 1)))))
             (list (let build ((k 0) (acc '())) (if (> k n) acc (build (+ k 1) (gp-add acc (if (cx0? (vref r k)) '() (list (cons k (vref r k))))))))
                   cx-zero))))))

(define (gp-expr p) (cons '+ (map (lambda (t) (list '* (cx-expr (cdr t)) (list '^ an-x (car t)))) p)))

(define (gx-group-expr key p)
  (let* ((a (car key)) (b (cadr key)) (c0 (caddr key))
         (ex (list 'exp (list '+ (list '* a (list '^ an-x 2)) (list '* (cx-expr b) an-x))))
         (c0e (if (cx0? c0) 1 (list 'exp (cx-expr c0)))))
    (cond ((and (= a 0) (cx0? b))
           (list '* c0e (cons '+ (map (lambda (t) (list '* (cx-expr (cdr t)) (/ 1 (+ (car t) 1)) (list '^ an-x (+ (car t) 1)))) p))))
          (else
           (let ((h (gx-hermite p a b)))
             (and h
                  (let* ((R (car h)) (g (cadr h))
                         (rt (list '* (gp-expr R) ex)))
                    (if (cx0? g)
                        (list '* c0e rt)
                        (let* ((sq (list '^ (abs a) 1/2))
                               (y (list '+ an-x (cx-expr (cx* b (cx-inv (cons (* 2 a) 0))))))
                               (sh (cx-expr (cx-neg (cx* (cx* b b) (cx-inv (cons (* 4 a) 0))))))
                               (er (if (< a 0)
                                       (list 'erf (list '* sq y))
                                       (list 'erfi (list '* sq y)))))
                          (list '* c0e (list '+ rt (list '* (cx-expr g) (list 'exp sh) (list '* (list '^ 'pi 1/2) 1/2 (list '^ sq -1)) er))))))))))))

; сопряжённость: для каждой группы есть сопряжённая с сопряжёнными коэффициентами
(define (gx-real? gs)
  (every? (lambda (e)
            (let* ((k (car e)) (ck (list (car k) (cx-conj (cadr k)) (cx-conj (caddr k)))) (o (assoc ck gs)))
              (and o (equal? (cdr o) (map (lambda (t) (cons (car t) (cx-conj (cdr t)))) (cdr e))))))
          gs))

(define (an-gaussian f0 x)
  (set! an-x x)
  (set! gx-bad #f)
  (let ((f (simplify (an-fix f0))))
    (and (not (contains-sym? f '%i))
         (let ((gs (gx-parse (expand f))))
           (and (not gx-bad) (pair? gs)
                (any? (lambda (e) (not (= (car (car e)) 0))) gs)
                (gx-real? gs)
                (let ((parts (map (lambda (e) (gx-group-expr (car e) (cdr e))) gs)))
                  (and (every? (lambda (p) p) parts)
                       (let ((F (simplify (cons '+ parts))))
                         (and (or (int-check F f0 x) (int-check F f x)) F)))))))))

; (int-ansatz f x [d-max]) → F (F′ = f, проверено int-check) или #f (нет решения при d ≤ d-max / не поддерживается / бюджет)
; необязательные: d-max, бюджет в секундах (по умолчанию int-ansatz-d-max, int-ansatz-time-limit), подъём констант (#t)
; причина отказа — в (int-ansatz-stats): последний элемент (fail "…")
(define (int-ansatz f x &rest more)
  (let* ((dmax (if (pair? more) (car more) int-ansatz-d-max))
         (tlim (if (and (pair? more) (pair? (cdr more))) (cadr more) int-ansatz-time-limit))
         (rg (begin (set! an-stats '()) (try (an-gaussian f x) (lambda (e) #f))))
         (r0 (or rg (try (an-run f x dmax tlim) (lambda (e) (an-bad! (string-append "ошибка: " (to-string e))) #f))))
         (lift? (and (pair? more) (pair? (cdr more)) (pair? (cddr more)) (caddr more)))
         (r (or r0 (and (or int-ansatz-lift-enabled lift?) (an-lifted f x dmax tlim)))))
    (if (and r0 an-pw (not rg)) (an-record-conds r0))
    (if (not r)
        (set! an-stats (append an-stats (list (list 'fail (or an-fail "нет решения при d ≤ d-max"))))))
    r))


; rubi/utils-s.lisp — RUBI.STUBS.
(module rubi)
; ======================================================================================================
; RUBI.STUBS: девять утилит, бывших заглушками (всегда #f), — перенос по IntegrationUtilityFunctions.m
; (Rubi 4.17.3.0). Строки исходника — в комментариях. Вспомогательные имена — rubi-s-*.
; Тождества порта: головы выражений строчные (sin, sinh, ...); число-атом — рациональное; E — символ E;
; комплексное число (Head===Complex) — %i, (* r %i), (+ r %i), (+ r (* s %i)); ActivateTrig — тождество
; (инертных голов нет), поэтому ветка FunctionOfQ «Not[InertTrigFreeQ[u]]» пропущена (иначе — бесконечный цикл).
; ======================================================================================================
(define (rubi-s-simp e) (try (simplify e) (lambda (err) e)))
(define (rubi-s-evenq n) (and (integer? n) (even? n)))
(define (rubi-s-oddq n) (and (integer? n) (not (even? n))))
(define (rubi-s-in? h lst) (if (member? h lst) #t #f))
; Catch[Scan[If[Not[f[#]],Throw[False]]&,u];True]
(define (rubi-s-scan-all? f u) (if (pair? u) (every? f (cdr u)) #t))
; Map[f,u] с пересборкой узла: сумма/произведение — арифметикой (сворачивает числа), степень — simplify
(define (rubi-s-rebuild head args)
  (cond ((equal? head '+) (apply + args))
        ((equal? head '*) (apply * args))
        ((equal? head '^) (rubi-s-simp (cons '^ args)))
        (else (cons head args))))
(define (rubi-s-map f u) (rubi-s-rebuild (car u) (map f (cdr u))))
; Log[b]: Log[E] = 1 (simplify этого не делает)
(define (rubi-s-log b) (if (equal? b 'E) 1 (list 'log b)))

; IntegerQuotientQ/OddQuotientQ/EvenQuotientQ (IUF.m:4910-4922); первая уже есть выше
(define (rubi-s-odd-quotient-q u v) (rubi-s-oddq (rubi-s-simp (list '/ u v))))
(define (rubi-s-even-quotient-q u v) (rubi-s-evenq (rubi-s-simp (list '/ u v))))

; LeadFactor/RemainingFactors/LeadBase/LeadDegree (IUF.m:1281-1327; комплексные числа порта не разбираются)
(define (rubi-s-lead-factor u) (if (rubi-productq u) (rubi-s-lead-factor (cadr u)) u))
(define (rubi-s-remaining-factors u)
  (if (rubi-productq u) (* (rubi-s-remaining-factors (cadr u)) (rubi-rest-product u)) 1))
(define (rubi-s-lead-base u)
  (let ((v (rubi-s-lead-factor u))) (if (rubi-powerq v) (cadr v) v)))
(define (rubi-s-lead-degree u)
  (let ((v (rubi-s-lead-factor u))) (if (rubi-powerq v) (caddr v) 1)))

; Drop[u,2] для произведения: произведение без двух первых множителей
(define (rubi-s-drop2 u)
  (let ((r (cdddr u))) (cond ((null? r) 1) ((null? (cdr r)) (car r)) (else (cons '* r)))))

; FindTrigFactor[func1,func2,u,v,flag] (IUF.m:4896-4907)
(define (rubi-s-find-trig-factor f1 f2 u v flag)
  (if (equal? u 1)
      #f
      (let ((lb (rubi-s-lead-base u)) (ld (rubi-s-lead-degree u)))
        (if (and (pair? lb) (rubi-s-in? (car lb) (list f1 f2)) (rubi-s-oddq ld)
                 (rubi-integer-quotient-q (cadr lb) v)
                 (or flag (rubi-neq (cadr lb) v)))
            (list (cadr lb) (rubi-s-remaining-factors u))
            (let ((lst (rubi-s-find-trig-factor f1 f2 (rubi-s-remaining-factors u) v flag)))
              (if lst (list (car lst) (* (rubi-s-lead-factor u) (cadr lst))) #f))))))

; Семейства голов: тригонометрические и гиперболические (в IUF.m тексты предикатов совпадают с точностью до имён)
(define rubi-s-trig-h '(sin cos tan cot sec csc))
(define rubi-s-hyp-h '(sinh cosh tanh coth sech csch))
(define (rubi-s-fam-q h u) (and (pair? u) (rubi-s-in? (car u) h)))

; Pure function of Sin/Cos/Tan/Cot[v] (IUF.m:4523-4565, гиперболические 4712-4753): allowed — головы, допустимые при аргументе v
(define (rubi-s-pure-fn-q h allowed u v x)
  (cond ((not (pair? u)) (not (equal? u x)))
        ((rubi-calculus-q u) #f)
        ((and (rubi-s-fam-q h u) (rubi-eqq (cadr u) v)) (rubi-s-in? (car u) allowed))
        (else (rubi-s-scan-all? (lambda (e) (rubi-s-pure-fn-q h allowed e v x)) u))))

; FunctionOfSinQ (IUF.m:4572-4605) / FunctionOfSinhQ (4761-4794)
(define (rubi-s-fn-of-sin-q h u v x)
  (let ((sn (nth h 0)) (cs (nth h 1)) (tn (nth h 2)) (ct (nth h 3)) (sc (nth h 4)) (cc (nth h 5)))
    (define (again w) (rubi-s-fn-of-sin-q h w v x))
    (cond ((not (pair? u)) (not (equal? u x)))
          ((rubi-calculus-q u) #f)
          ((and (rubi-s-fam-q h u) (rubi-integer-quotient-q (cadr u) v))
           (if (rubi-s-odd-quotient-q (cadr u) v)
               (rubi-s-in? (car u) (list sn cc))   ; m нечётно: Sin[m v]^n — функция от Sin[v]
               (rubi-s-in? (car u) (list cs sc)))) ; m чётно: Cos[m v]^n — функция от Sin[v]
          ((and (rubi-integer-power-q u) (rubi-s-fam-q h (cadr u)) (rubi-integer-quotient-q (cadr (cadr u)) v))
           (if (rubi-s-evenq (caddr u)) #t (again (cadr u))))
          ((rubi-productq u)
           (if (and (pair? (cdr u)) (pair? (cddr u))
                    (let ((f1 (cadr u)) (f2 (caddr u)))
                      ; Cos[v/2]*Sin[v/2] (порядок множителей в порте свой — принимаются оба)
                      (and (rubi-s-fam-q h f1) (rubi-s-fam-q h f2)
                           (or (and (equal? (car f1) cs) (equal? (car f2) sn))
                               (and (equal? (car f1) sn) (equal? (car f2) cs)))
                           (rubi-eqq (cadr f1) (list '/ v 2)) (rubi-eqq (cadr f2) (list '/ v 2)))))
               (again (rubi-s-drop2 u))
               (let ((l1 (rubi-s-find-trig-factor sn cc u v #f)))
                 (if (and l1 (rubi-s-even-quotient-q (car l1) v))
                     (again (* (list cs v) (cadr l1)))
                     (let ((l2 (rubi-s-find-trig-factor cs sc u v #f)))
                       (if (and l2 (rubi-s-odd-quotient-q (car l2) v))
                           (again (* (list cs v) (cadr l2)))
                           (let ((l3 (rubi-s-find-trig-factor tn ct u v #t)))
                             (if l3
                                 (again (* (list cs v) (cadr l3)))
                                 (rubi-s-scan-all? again u)))))))))
          (else (rubi-s-scan-all? again u)))))

; FunctionOfCosQ (IUF.m:4609-4633) / FunctionOfCoshQ (4798-4822)
(define (rubi-s-fn-of-cos-q h u v x)
  (let ((sn (nth h 0)) (cs (nth h 1)) (tn (nth h 2)) (ct (nth h 3)) (sc (nth h 4)) (cc (nth h 5)))
    (define (again w) (rubi-s-fn-of-cos-q h w v x))
    (cond ((not (pair? u)) (not (equal? u x)))
          ((rubi-calculus-q u) #f)
          ((and (rubi-s-fam-q h u) (rubi-integer-quotient-q (cadr u) v))
           (rubi-s-in? (car u) (list cs sc)))
          ((and (rubi-integer-power-q u) (rubi-s-fam-q h (cadr u)) (rubi-integer-quotient-q (cadr (cadr u)) v))
           (if (rubi-s-evenq (caddr u)) #t (again (cadr u))))
          ((rubi-productq u)
           (let ((l1 (rubi-s-find-trig-factor sn cc u v #f)))
             (if l1
                 (again (* (list sn v) (cadr l1)))
                 (let ((l2 (rubi-s-find-trig-factor tn ct u v #t)))
                   (if l2
                       (again (* (list sn v) (cadr l2)))
                       (rubi-s-scan-all? again u))))))
          (else (rubi-s-scan-all? again u)))))

; OddTrigPowerQ (IUF.m:4655-4669) / OddHyperbolicPowerQ (4844-4858)
(define (rubi-s-odd-trig-power-q h u v x)
  (cond ((and (pair? u) (rubi-s-in? (car u) (list (nth h 0) (nth h 1) (nth h 4) (nth h 5))))
         (rubi-s-odd-quotient-q (cadr u) v))
        ((rubi-powerq u) (and (rubi-s-oddq (caddr u)) (rubi-s-odd-trig-power-q h (cadr u) v x)))
        ((rubi-productq u)
         (if (not (rubi-eqq (rubi-free-factors u x) 1))
             (rubi-s-odd-trig-power-q h (rubi-nonfree-factors u x) v x)
             (let ((lst (filter (lambda (e) (not (rubi-s-fn-of-tan-q h e v x))) (cdr u))))
               (cond ((null? lst) #t)
                     (else (and (null? (cdr lst)) (rubi-s-odd-trig-power-q h (car lst) v x)))))))
        ((rubi-sumq u) (every? (lambda (e) (rubi-s-odd-trig-power-q h e v x)) (cdr u)))
        (else #f)))

; FunctionOfTanQ (IUF.m:4637-4653) / FunctionOfTanhQ (4826-4842)
(define (rubi-s-fn-of-tan-q h u v x)
  (let ((tn (nth h 2)) (cs (nth h 1)))
    (define (again w) (rubi-s-fn-of-tan-q h w v x))
    (cond ((not (pair? u)) (not (equal? u x)))
          ((rubi-calculus-q u) #f)
          ((and (rubi-s-fam-q h u) (rubi-integer-quotient-q (cadr u) v))
           (or (rubi-s-in? (car u) (list tn (nth h 3))) (rubi-s-even-quotient-q (cadr u) v)))
          ((and (rubi-powerq u) (rubi-s-evenq (caddr u)) (rubi-s-fam-q h (cadr u))
                (rubi-integer-quotient-q (cadr (cadr u)) v))
           #t)
          ((and (rubi-powerq u) (rubi-s-evenq (caddr u)) (rubi-sumq (cadr u)))
           (again (expand (list '^ (cadr u) 2))))
          ((rubi-productq u)
           (let ((lst (filter (lambda (e) (not (again e))) (cdr u))))
             (if (null? lst)
                 #t
                 (and (pair? (cdr lst)) (null? (cddr lst))
                      (rubi-s-odd-trig-power-q h (car lst) v x)
                      (rubi-s-odd-trig-power-q h (cadr lst) v x)))))
          (else (rubi-s-scan-all? again u)))))

; Номер головы в семействе (sin cos tan cot sec csc) или #f
(define (rubi-s-head-index h hd)
  (let loop ((l h) (i 0))
    (cond ((null? l) #f) ((equal? (car l) hd) i) (else (loop (cdr l) (+ i 1))))))

; FunctionOfExpnQ[u,v,x] (IUF.m:4486-4516): степень, в которой u — функция от v, или #f
(define (rubi-s-fn-of-expn-q u v x)
  (cond ((equal? u v) 1)
        ((not (pair? u)) (if (equal? u x) #f 0))
        ((rubi-calculus-q u) #f)
        ((and (rubi-powerq u) (rubi-freeq (caddr u) x))
         (cond ((rubi-eqq (cadr u) v) (if (integer? (caddr u)) (caddr u) 1))
               ((and (rubi-powerq v) (rubi-freeq (caddr v) x) (rubi-eqq (cadr u) (cadr v)))
                (if (rubi-rationalq (caddr v))
                    (if (and (rubi-rationalq (caddr u)) (integer? (/ (caddr u) (caddr v)))
                             (or (> (caddr v) 0) (< (caddr u) 0)))
                        (/ (caddr u) (caddr v))
                        #f)
                    (let ((q (rubi-s-simp (list '/ (caddr u) (caddr v)))))
                      (if (integer? q) q #f))))
               (else (rubi-s-fn-of-expn-q (cadr u) v x))))
        ((and (rubi-productq u) (not (rubi-eqq (rubi-free-factors u x) 1)))
         (rubi-s-fn-of-expn-q (rubi-nonfree-factors u x) v x))
        ((and (rubi-productq u) (rubi-productq v))
         (let ((deg1 (rubi-s-fn-of-expn-q (cadr u) (cadr v) x)))
           (if (not deg1)
               #f
               (let ((deg2 (rubi-s-fn-of-expn-q (rubi-rest-product u) (rubi-rest-product v) x)))
                 (if (and deg2 (equal? deg1 deg2)
                          (rubi-freeq (rubi-s-simp (list '/ u (list '^ v deg1))) x))
                     deg1
                     #f)))))
        (else
         (let ((lst (map (lambda (e) (rubi-s-fn-of-expn-q e v x)) (cdr u))))
           (if (member? #f lst)
               #f
               (foldl (lambda (g d) (rubi-gcd g d)) (car lst) (cdr lst)))))))

; FunctionOfQ[v,u,x,PureFlag] (IUF.m:4443-4483): u — функция от v
(define (rubi-functionofq v u x &rest more)
  (let ((pure (and (pair? more) (equal? (car more) #t))))
    (cond ((rubi-freeq u x) #f)
          ((not (pair? v)) #t)
          ((and (rubi-productq v) (not (rubi-eqq (rubi-free-factors v x) 1)))
           (rubi-functionofq (rubi-nonfree-factors v x) u x pure))
          (else
           (let* ((hd (car v))
                  (fam (cond ((rubi-s-in? hd rubi-s-trig-h) rubi-s-trig-h)
                             ((rubi-s-in? hd rubi-s-hyp-h) rubi-s-hyp-h)
                             (else #f)))
                  (i (and fam (rubi-s-head-index fam hd)))
                  (w (and fam (cadr v))))
             (cond ((not fam) (if (rubi-s-fn-of-expn-q u v x) #t #f))
                   (pure
                    (cond ((or (= i 0) (= i 5)) (rubi-s-pure-fn-q fam (list (nth fam 0) (nth fam 5)) u w x))
                          ((or (= i 1) (= i 4)) (rubi-s-pure-fn-q fam (list (nth fam 1) (nth fam 4)) u w x))
                          ((= i 2) (rubi-s-pure-fn-q fam (list (nth fam 2) (nth fam 3)) u w x))
                          (else (rubi-s-pure-fn-q fam (list (nth fam 3)) u w x))))
                   ((or (= i 0) (= i 5)) (rubi-s-fn-of-sin-q fam u w x))
                   ((or (= i 1) (= i 4)) (rubi-s-fn-of-cos-q fam u w x))
                   (else (rubi-s-fn-of-tan-q fam u w x))))))))

; ---------- FunctionOfExponential (IUF.m:4263-4350) ----------
; Текучие переменные $base$, $expon$, $exponFlag$ — глобальные, сбрасываются на входе каждой из трёх утилит.
(define *rubi-fe-base* 'null)
(define *rubi-fe-expon* 'null)
(define *rubi-fe-flag* #f)
(define (rubi-s-fe-reset)
  (set! *rubi-fe-base* 'null) (set! *rubi-fe-expon* 'null) (set! *rubi-fe-flag* #f))

; целый корень k-й степени из n или #f
(define (rubi-s-int-root n k)
  (let ((r (try (floor (+ 0.5 (eval-num (list '^ n (/ 1 k))))) (lambda (err) #f))))
    (and r (integer? r) (equal? (^ r k) n) r)))
(define (rubi-s-ilog2 n) (let loop ((m n) (c 0)) (if (< m 2) c (loop (quotient m 2) (+ c 1)))))
; n >= 2 целое: (g . k), n = g^k, k наибольшее
(define (rubi-s-primitive-root n)
  (let loop ((k (rubi-s-ilog2 n)))
    (if (< k 2)
        (cons n 1)
        (let ((r (rubi-s-int-root n k)))
          (if r (cons r k) (loop (- k 1)))))))
; b = корень^степень: (корень . степень); для log-отношения: Log[b] = степень*Log[корень]
(define (rubi-s-log-decomp b)
  (cond ((and (integer? b) (>= b 2)) (rubi-s-primitive-root b))
        ((and (rubi-fractionq b) (equal? (numer b) 1) (>= (denom b) 2))
         (let ((p (rubi-s-primitive-root (denom b)))) (cons (car p) (- 0 (cdr p)))))
        ((and (rubi-powerq b) (not (integer? (cadr b))) (rubi-freeq (caddr b) 'x))
         (let ((d (rubi-s-log-decomp (cadr b))))
           (cons (car d) (rubi-s-simp (list '* (cdr d) (caddr b))))))
        ((and (rubi-powerq b) (integer? (cadr b)) (>= (cadr b) 2))
         (let ((d (rubi-s-primitive-root (cadr b))))
           (cons (car d) (rubi-s-simp (list '* (cdr d) (caddr b))))))
        (else (cons b 1))))
; FullSimplify[Log[b1]/Log[b0]] (b1, b0 свободны от x): общий корень — отношение степеней, иначе символьное частное
(define (rubi-s-log-quot b1 b0)
  (let ((d1 (rubi-s-log-decomp b1)) (d0 (rubi-s-log-decomp b0)))
    (if (and (equal? (car d1) (car d0)) (not (rubi-eqq (cdr d0) 0)))
        (rubi-s-simp (list '* (cdr d1) (list '^ (cdr d0) -1)))
        (rubi-s-simp (list '* (rubi-s-log b1) (list '^ (rubi-s-log b0) -1))))))

; FunctionOfExponentialTestAux (IUF.m:4322-4350)
(define (rubi-s-fe-test-aux base expon x)
  (if (equal? *rubi-fe-base* 'null)
      (begin (set! *rubi-fe-base* base) (set! *rubi-fe-expon* expon) #t)
      (let* ((c1 (rubi-coefficient expon x 1))
             (c1p (rubi-coefficient *rubi-fe-expon* x 1))
             (lq (rubi-s-log-quot base *rubi-fe-base*))
             (tmp (if (rubi-zero? c1p) #f (rubi-s-simp (list '* lq c1 (list '^ c1p -1))))))
        (if (not (and tmp (rubi-rationalq tmp)))
            #f
            (let* ((c0 (rubi-coefficient expon x 0))
                   (c0p (rubi-coefficient *rubi-fe-expon* x 0))
                   (branch1 (or (rubi-eqq c0p 0)
                                (rubi-neq tmp (rubi-s-simp (list '* lq c0 (list '^ c0p -1)))))))
              ; ( If[IGtQ[base,0] && IGtQ[$base$,0] && base<$base$, $base$=base; $expon$=expon; tmp=1/tmp] )
              (if (and (rubi-igtq base 0) (rubi-igtq *rubi-fe-base* 0) (< base *rubi-fe-base*))
                  (begin (set! *rubi-fe-base* base) (set! *rubi-fe-expon* expon) (set! tmp (/ 1 tmp))))
              (if branch1
                  (set! *rubi-fe-expon* (* (rubi-coefficient *rubi-fe-expon* x 1) x (/ 1 (denom tmp))))
                  (set! *rubi-fe-expon* (* (/ 1 (denom tmp)) *rubi-fe-expon*)))
              (if (and (< tmp 0) (rubi-negq (rubi-coefficient *rubi-fe-expon* x 1)))
                  (set! *rubi-fe-expon* (* -1 *rubi-fe-expon*)))
              #t)))))

; FunctionOfExponentialTest (IUF.m:4307-4319)
(define (rubi-s-fe-test u x)
  (cond ((rubi-freeq u x) #t)
        ((or (equal? u x) (rubi-calculus-q u)) #f)
        ((and (rubi-powerq u) (rubi-freeq (cadr u) x) (rubi-linearq (caddr u) x))
         (set! *rubi-fe-flag* #t)
         (rubi-s-fe-test-aux (cadr u) (caddr u) x))
        ((and (rubi-hyperbolic-q u) (rubi-linearq (cadr u) x))
         (rubi-s-fe-test-aux 'E (cadr u) x))
        ((and (rubi-powerq u) (rubi-freeq (cadr u) x) (rubi-sumq (caddr u)))
         (and (rubi-s-fe-test (list '^ (cadr u) (cadr (caddr u))) x)
              (rubi-s-fe-test (list '^ (cadr u) (rubi-rest-sum (caddr u))) x)))
        (else (every? (lambda (e) (rubi-s-fe-test e x)) (cdr u)))))

(define (rubi-function-of-exponential-q u x)
  (rubi-s-fe-reset)
  (and (rubi-s-fe-test u x) *rubi-fe-flag* #t))
(define (rubi-function-of-exponential u x)
  (rubi-s-fe-reset)
  (rubi-s-fe-test u x)
  (if (equal? *rubi-fe-base* 'null) #f (rubi-s-simp (list '^ *rubi-fe-base* *rubi-fe-expon*))))

; x^FullSimplify[Log[b]*c1/(Log[$base$]*c1($expon$)) ] — показатель замены F^v -> x
(define (rubi-s-fe-exponent b c1 x)
  (rubi-s-simp (list '* (rubi-s-log-quot b *rubi-fe-base*) c1
                     (list '^ (rubi-coefficient *rubi-fe-expon* x 1) -1))))
; FunctionOfExponentialFunctionAux (IUF.m:4284-4303)
(define (rubi-s-fe-aux u x)
  (cond ((not (pair? u)) u)
        ((and (rubi-powerq u) (rubi-freeq (cadr u) x) (rubi-linearq (caddr u) x))
         (let ((ex (rubi-s-simp (list '^ x (rubi-s-fe-exponent (cadr u) (rubi-coefficient (caddr u) x 1) x)))))
           (if (rubi-eqq (rubi-coefficient *rubi-fe-expon* x 0) 0)
               (* (rubi-s-simp (list '^ (cadr u) (rubi-coefficient (caddr u) x 0))) ex)
               ex)))
        ((and (rubi-hyperbolic-q u) (rubi-linearq (cadr u) x))
         (let* ((tmp (rubi-s-simp (list '^ x (rubi-s-simp (list '* (rubi-coefficient (cadr u) x 1)
                                                               (list '^ (list '* (rubi-s-log *rubi-fe-base*)
                                                                              (rubi-coefficient *rubi-fe-expon* x 1)) -1))))))
                (it (list '^ tmp -1)) (h (car u)))
           (rubi-s-simp
            (cond ((equal? h 'sinh) (list '+ (list '* 1/2 tmp) (list '* -1/2 it)))
                  ((equal? h 'cosh) (list '+ (list '* 1/2 tmp) (list '* 1/2 it)))
                  ((equal? h 'tanh) (list '* (list '+ tmp (list '* -1 it)) (list '^ (list '+ tmp it) -1)))
                  ((equal? h 'coth) (list '* (list '+ tmp it) (list '^ (list '+ tmp (list '* -1 it)) -1)))
                  ((equal? h 'sech) (list '* 2 (list '^ (list '+ tmp it) -1)))
                  (else (list '* 2 (list '^ (list '+ tmp (list '* -1 it)) -1)))))))
        ((and (rubi-powerq u) (rubi-freeq (cadr u) x) (rubi-sumq (caddr u)))
         (* (rubi-s-fe-aux (list '^ (cadr u) (cadr (caddr u))) x)
            (rubi-s-fe-aux (list '^ (cadr u) (rubi-rest-sum (caddr u))) x)))
        (else (rubi-s-map (lambda (e) (rubi-s-fe-aux e x)) u))))
(define (rubi-function-of-exponential-function u x)
  (rubi-s-fe-reset)
  (rubi-s-fe-test u x)
  (rubi-simplify-integrand (rubi-s-fe-aux u x) x))

; ---------- FunctionOfLinear (IUF.m:4169-4227) ----------
; MinimumDegree (IUF.m:3138-3152); OrderedQ в порте нечем — при несравнимых степенях берётся первая
(define (rubi-s-min-degree d1 d2)
  (cond ((rubi-rationalq d1) (if (rubi-rationalq d2) (if (< d2 d1) d2 d1) d1))
        ((rubi-rationalq d2) d2)
        (else (let ((d (rubi-s-simp (list '+ d1 (list '* -1 d2)))))
                (if (rubi-rationalq d) (if (> d 0) d2 d1) d1)))))
; MonomialFactor[u,x] (IUF.m:3112-3135): (n v), x^n*v = u
(define (rubi-s-monomial-factor u x)
  (cond ((not (pair? u)) (if (equal? u x) (list 1 1) (list 0 u)))
        ((rubi-powerq u)
         (if (integer? (caddr u))
             (let ((lst (rubi-s-monomial-factor (cadr u) x)))
               (list (* (car lst) (caddr u)) (rubi-s-simp (list '^ (cadr lst) (caddr u)))))
             (if (and (equal? (cadr u) x) (rubi-freeq (caddr u) x))
                 (list (caddr u) 1)
                 (list 0 u))))
        ((rubi-productq u)
         (let ((l1 (rubi-s-monomial-factor (cadr u) x))
               (l2 (rubi-s-monomial-factor (rubi-rest-product u) x)))
           (list (+ (car l1) (car l2)) (* (cadr l1) (cadr l2)))))
        ((rubi-sumq u)
         (let* ((lst (map (lambda (tm) (rubi-s-monomial-factor tm x)) (cdr u)))
                (deg (foldl (lambda (d p) (rubi-s-min-degree d (car p))) (car (car lst)) (cdr lst))))
           (if (or (rubi-eqq deg 0) (and (rubi-rationalq deg) (< deg 0)))
               (list 0 u)
               (list deg (apply + (map (lambda (p)
                                         (* (rubi-s-simp (list '^ x (rubi-s-simp (list '+ (car p) (list '* -1 deg))))) (cadr p)))
                                       lst))))))
        (else (list 0 u))))

; CommonFactors[{b,c}] (IUF.m:3025-3073) для двух членов: (общий b/общий c/общий). По множителям (основание, степень),
; а не по порядку Mathematica; клаузы Log[целое] и «основания -b, b» не переносились (дают менее полное, но верное разложение).
(define (rubi-s-base-degree f) (if (rubi-powerq f) (cons (cadr f) (caddr f)) (cons f 1)))
(define (rubi-s-term-parts tm)
  (let loop ((l (if (rubi-productq tm) (cdr tm) (list tm))) (num 1) (bs '()))
    (cond ((null? l) (list num (reverse bs)))
          ((rubi-rationalq (car l)) (loop (cdr l) (* num (car l)) bs))
          (else (loop (cdr l) num (cons (rubi-s-base-degree (car l)) bs))))))
; Smallest[num1,num2] (IUF.m:3092-3099)
(define (rubi-s-smallest d1 d2)
  (if (> d1 0) (if (> d2 0) (min d1 d2) 0) (if (> d2 0) 0 (max d1 d2))))
(define (rubi-s-common-factors2 b c)
  (let* ((pb (rubi-s-term-parts b)) (pc (rubi-s-term-parts c))
         (num (rubi-gcd (car pb) (car pc))))
    (let loop ((l (cadr pb)) (rc (cadr pc)) (common (list num)) (qb (list (/ (car pb) num))) (qc (list (/ (car pc) num))))
      (if (null? l)
          (list (apply * common)
                (apply * (append qb (map (lambda (p) (rubi-s-simp (list '^ (car p) (cdr p)))) rc)))
                (apply * qc))
          (let* ((bp (car l)) (m (assoc (car bp) rc)))
            (if (and m (rubi-rationalq (cdr bp)) (rubi-rationalq (cdr m)))
                (let ((s (rubi-s-smallest (cdr bp) (cdr m))))
                  (loop (cdr l) (rubi-delete-one m rc)
                        (if (equal? s 0) common (cons (rubi-s-simp (list '^ (car bp) s)) common))
                        (cons (rubi-s-simp (list '^ (car bp) (- (cdr bp) s))) qb)
                        (cons (rubi-s-simp (list '^ (car bp) (- (cdr m) s))) qc)))
                (loop (cdr l) rc common
                      (cons (rubi-s-simp (list '^ (car bp) (cdr bp))) qb) qc)))))))
; результат CommonFactors2: (общий, частное для b, частное для c), как lst[[1]], lst[[2]], lst[[3]] в IUF.m

; FunctionOfLinear[u,x,a,b,flag] (IUF.m:4176-4203): (a b) или #f
(define (rubi-s-fol u a b x flag)
  (cond ((rubi-freeq u x) (list a b))
        ((rubi-calculus-q u) #f)
        ((rubi-linearq u x)
         (let ((c0 (rubi-coefficient u x 0)) (c1 (rubi-coefficient u x 1)))
           (if (not a)
               (list c0 c1)
               (let ((lst (rubi-s-common-factors2 b c1)))
                 (cond ((and (rubi-eqq c0 0) (not flag)) (list 0 (car lst)))
                       ((rubi-eqq (list '- (list '* b c0) (list '* a c1)) 0)
                        (list (rubi-s-simp (list '* a (list '^ (cadr lst) -1))) (car lst)))
                       (else (list 0 1)))))))
        ((and (rubi-powerq u) (rubi-freeq (cadr u) x))
         (rubi-s-fol (* (rubi-s-log (cadr u)) (caddr u)) a b x #f))
        ((and (rubi-productq u) (not (rubi-eqq (car (rubi-s-monomial-factor u x)) 0))) #f)
        (else
         (let loop ((l (cdr u)) (lst (list a b)))
           (cond ((not lst) #f)
                 ((null? l) lst)
                 (else (loop (cdr l) (rubi-s-fol (car l) (car lst) (cadr lst) x (rubi-sumq u)))))))))
; DivideDegreesOfFactors (IUF.m:4224-4227)
(define (rubi-s-divide-degrees u n)
  (let ((f (lambda (tm) (rubi-s-simp (list '^ (rubi-s-lead-base tm) (list '/ (rubi-s-lead-degree tm) n))))))
    (if (rubi-productq u) (apply * (map f (cdr u))) (f u))))
; FunctionOfLinearSubst (IUF.m:4206-4220)
(define (rubi-s-fol-subst u a b x)
  (cond ((rubi-freeq u x) u)
        ((rubi-linearq u x)
         (let* ((t1 (rubi-coefficient u x 1))
                (tmp (if (equal? t1 b) 1 (rubi-s-simp (list '* t1 (list '^ b -1))))))
           (rubi-s-simp (list '+ (rubi-coefficient u x 0) (list '* -1 a tmp) (list '* tmp x)))))
        ((and (rubi-powerq u) (rubi-freeq (cadr u) x))
         (list '^ 'E (rubi-s-simp (rubi-s-fol-subst (* (rubi-s-log (cadr u)) (caddr u)) a b x))))
        (else
         (let ((mf (and (rubi-productq u) (rubi-s-monomial-factor u x))))
           (if (and mf (not (rubi-eqq (car mf) 0)))
               (let ((lf (rubi-s-lead-factor (cadr mf))))
                 (if (and (rubi-rationalq lf) (< lf 0))
                     (* -1 (rubi-s-simp (list '^ (rubi-s-fol-subst (* (rubi-s-divide-degrees (* -1 (cadr mf)) (car mf)) x) a b x) (car mf))))
                     (rubi-s-simp (list '^ (rubi-s-fol-subst (* (rubi-s-divide-degrees (cadr mf) (car mf)) x) a b x) (car mf)))))
               (rubi-s-map (lambda (e) (rubi-s-fol-subst e a b x)) u))))))
(define (rubi-function-of-linear u x)
  (let ((lst (rubi-s-fol u #f #f x #f)))
    (if (or (not lst) (not (car lst)) (and (equal? (car lst) 0) (equal? (cadr lst) 1)))
        #f
        (list (rubi-s-fol-subst u (car lst) (cadr lst) x) (car lst) (cadr lst)))))

; ---------- PowerVariableExpn (IUF.m:4976-5006) ----------
(define (rubi-s-pvd u m c x)
  (cond ((rubi-freeq u x) (list m c))
        ((or (not (pair? u)) (rubi-calculus-q u)) #f)
        ((and (rubi-powerq u) (rubi-freeq (rubi-s-simp (list '/ (cadr u) x)) x))
         (let ((c1 (rubi-s-simp (list '/ (cadr u) x))))
           (cond ((or (rubi-eqq m 0) (and (equal? m (caddr u)) (equal? c c1))) (list (caddr u) c1))
                 ((and (integer? (caddr u)) (integer? m) (> (gcd m (caddr u)) 1) (equal? c c1))
                  (list (gcd m (caddr u)) c))
                 (else #f))))
        (else (let loop ((l (cdr u)) (lst (list m c)))
                (cond ((not lst) #f)
                      ((null? l) lst)
                      (else (loop (cdr l) (rubi-s-pvd (car l) (car lst) (cadr lst) x))))))))
(define (rubi-s-pv-subst u m x)
  (cond ((or (rubi-freeq u x) (not (pair? u)) (rubi-calculus-q u)) u)
        ((and (rubi-powerq u) (rubi-freeq (rubi-s-simp (list '/ (cadr u) x)) x))
         (rubi-s-simp (list '^ x (rubi-s-simp (list '/ (caddr u) m)))))
        (else (rubi-s-map (lambda (e) (rubi-s-pv-subst e m x)) u))))
(define (rubi-power-variable-expn u m x)
  (if (integer? m)
      (let ((lst (rubi-s-pvd u m 1 x)))
        (if (not lst)
            #f
            (list (* (rubi-s-simp (list '^ x (rubi-s-simp (list '/ m (car lst))))) (rubi-s-pv-subst u (car lst) x))
                  (car lst) (cadr lst))))
      #f))

; ---------- NiceSqrtQ, FractionalPowerFactorQ (IUF.m:651-669) ----------
; Complex-атом Mathematica в записи порта
(define (rubi-s-complex-const? u)
  (cond ((equal? u '%i) #t)
        ((and (rubi-productq u) (= (length (cdr u)) 2) (rubi-rationalq (cadr u)) (equal? (caddr u) '%i)) #t)
        ((and (rubi-sumq u) (= (length (cdr u)) 2) (rubi-rationalq (cadr u))
              (rubi-s-complex-const? (caddr u))
              (not (rubi-sumq (caddr u))))
         #t)
        (else #f)))
(define (rubi-fractional-power-factor-q u &rest more)
  (cond ((rubi-s-complex-const? u) #t)
        ((not (pair? u)) #f)
        ((rubi-powerq u) (rubi-fractionq (caddr u)))
        ((rubi-productq u)
         (or (rubi-fractional-power-factor-q (cadr u))
             (rubi-fractional-power-factor-q (rubi-rest-product u))))
        (else #f)))
(define (rubi-nice-sqrt-q u &rest more)
  (if (rubi-rationalq u)
      (> u 0)
      (let ((r (try (rubi-rt u 2) (lambda (err) #f))))
        (and r (not (rubi-fractional-power-factor-q r))))))

; ---------- FunctionOfSquareRootOfQuadratic (IUF.m:5071-5128) ----------
; MatchQ[u, x^m_.*(a_+b_.*x^n_.)^p_ /; FreeQ[{a,b,m,n,p},x]] — разбор структуры, не образцом
(define (rubi-s-xpow-q f x) (or (equal? f x) (and (rubi-powerq f) (equal? (cadr f) x) (rubi-freeq (caddr f) x))))
(define (rubi-s-binom-pow-q f x)
  (and (rubi-powerq f) (rubi-freeq (caddr f) x)
       (let ((b (cadr f))) (and (rubi-sumq b) (= (length (cdr b)) 2) (rubi-binomial-q b x)))))
(define (rubi-s-xmbp-q u x)
  (and (rubi-productq u) (= (length (cdr u)) 2)
       (let ((f1 (cadr u)) (f2 (caddr u)))
         (or (and (rubi-s-xpow-q f1 x) (rubi-s-binom-pow-q f2 x))
             (and (rubi-s-xpow-q f2 x) (rubi-s-binom-pow-q f1 x))))))
(define (rubi-s-sqrt-of-quadratic-q f x)
  (and (rubi-fractionq (caddr f)) (equal? (denom (caddr f)) 2)
       (rubi-polynomialq (cadr f) x) (equal? (rubi-expon (cadr f) x) 2)))
; FunctionOfSquareRootOfQuadratic[u,v,x] (IUF.m:5102-5115): (v) или #f
(define (rubi-s-fsrq3 u v x)
  (cond ((or (not (pair? u)) (rubi-freeq u x)) (list v))
        ((and (rubi-powerq u) (rubi-freeq (caddr u) x))
         (if (rubi-s-sqrt-of-quadratic-q u x)
             (if (or (not v) (equal? (cadr u) v)) (list (cadr u)) #f)
             (rubi-s-fsrq3 (cadr u) v x)))
        ((or (rubi-productq u) (rubi-sumq u))
         (let loop ((l (cdr u)) (lst (list v)))
           (cond ((null? l) lst)
                 (else (let ((r (rubi-s-fsrq3 (car l) (car lst) x)))
                         (if r (loop (cdr l) r) #f))))))
        (else #f)))
; SquareRootOfQuadraticSubst[u,vv,xx,x] (IUF.m:5119-5128)
(define (rubi-s-srq-subst u vv xx x)
  (cond ((or (not (pair? u)) (rubi-freeq u x)) (if (equal? u x) xx u))
        ((and (rubi-powerq u) (rubi-freeq (caddr u) x))
         (if (rubi-s-sqrt-of-quadratic-q u x)
             (rubi-s-simp (list '^ vv (numer (caddr u))))
             (rubi-s-simp (list '^ (rubi-s-srq-subst (cadr u) vv xx x) (caddr u)))))
        (else (rubi-s-map (lambda (e) (rubi-s-srq-subst e vv xx x)) u))))
; Simplify рациональной функции: together, затем simplify
(define (rubi-s-simp-rat e)
  (rubi-s-simp (try (together e) (lambda (err) e))))
(define (rubi-function-of-square-root-of-quadratic u x)
  (if (rubi-s-xmbp-q u x)
      #f
      (let ((tmp0 (rubi-s-fsrq3 u #f x)))
        (if (or (not tmp0) (not (car tmp0)))
            #f
            (let* ((tmp (car tmp0))
                   (a (rubi-coefficient tmp x 0)) (b (rubi-coefficient tmp x 1)) (c (rubi-coefficient tmp x 2))
                   (sq (list '^ tmp 1/2)))
              (cond
                ((or (and (rubi-eqq a 0) (rubi-eqq b 0))
                     (rubi-eqq (list '- (list '^ b 2) (list '* 4 a c)) 0))
                 #f)
                ((rubi-posq c)
                 (let* ((s (rubi-rt c 2))
                        (q (list '+ (list '* a s) (list '* b x) (list '* s (list '^ x 2))))
                        (r (list '+ b (list '* 2 s x))))
                   (list (rubi-s-simp-rat
                          (list '* (rubi-s-srq-subst u (list '* q (list '^ r -1))
                                                     (list '* (list '+ (list '* -1 a) (list '^ x 2)) (list '^ r -1)) x)
                                q (list '^ r -2)))
                         (rubi-s-simp (list '+ (list '* s x) sq))
                         2)))
                ((rubi-posq a)
                 (let* ((s (rubi-rt a 2))
                        (q (list '+ (list '* c s) (list '* -1 b x) (list '* s (list '^ x 2))))
                        (r (list '+ c (list '* -1 (list '^ x 2)))))
                   (list (rubi-s-simp-rat
                          (list '* (rubi-s-srq-subst u (list '* q (list '^ r -1))
                                                     (list '* (list '+ (list '* -1 b) (list '* 2 s x)) (list '^ r -1)) x)
                                q (list '^ r -2)))
                         (rubi-s-simp-rat (list '* (list '+ (list '* -1 s) sq) (list '^ x -1)))
                         1)))
                (else
                 (let* ((s (rubi-rt (list '+ (list '^ b 2) (list '* -4 a c)) 2))
                        (r (list '+ c (list '* -1 (list '^ x 2)))))
                   (list (rubi-s-simp-rat
                          (list '* -1 s
                                (rubi-s-srq-subst u (list '* -1 s x (list '^ r -1))
                                                  (list '* -1 (list '+ (list '* b c) (list '* c s) (list '* (list '+ (list '* -1 b) s) (list '^ x 2)))
                                                        (list '^ (list '* 2 c r) -1))
                                                  x)
                                x (list '^ r -2)))
                         (rubi-s-simp-rat (list '* 2 c sq (list '^ (list '+ b (list '* -1 s) (list '* 2 c x)) -1)))
                         3)))))))))

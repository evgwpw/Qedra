; repr.lisp — представления конечных групп (шаг REP)
; Группа — как в group.lisp: (образующие степень), перестановки — векторы образов (произведение p·q: сначала p).
; Классы сопряжённости — перечнем элементов (группы до нескольких тысяч элементов).
; Таблица характеров — метод Диксона — Шнайдера: матрицы классовых сумм, общие собственные векторы
; по модулю простого p ≡ 1 (mod e) (e — экспонента группы), степень χ(1) из χ(1)² = |G| / Σ ω_k ω_k' / |C_k|,
; подъём в ℂ по кратностям собственных значений n_j = (1/m) Σ_t χ(g^t) ζ^(−jt) ∈ [0, χ(1)].
; Значения — точные элементы Q(ζ_e): список целых коэффициентов при 1, ζ, …, ζ^(φ(e)−1) по модулю Φ_e.
; Сертификат — не доверяет построению: соотношения ортогональности и алгебра классов Бернсайда в точной арифметике.
(module repr
  (export group-elements conjugacy-classes class-power-map quaternion-group
          character-table char-table? char-table-group char-table-exponent char-table-classes
          char-table-rows char-table-degrees char-table-with-rows char-table->exprs
          char-value->expr char-coerce
          char-inner char-decompose char-tensor char-dual char-sym2 char-alt2
          char-permutation char-regular char-from-matrices character-table-check))

; ---------- целые числа ----------

(define (rp-pow-mod a e p)
  (let loop ((b (modulo a p)) (e e) (r 1))
    (cond ((= e 0) r)
          ((= (modulo e 2) 1) (loop (modulo (* b b) p) (quotient e 2) (modulo (* r b) p)))
          (else (loop (modulo (* b b) p) (quotient e 2) r)))))
(define (rp-inv-mod a p) (rp-pow-mod a (- p 2) p))

; разложение: ((p . степень) …) по возрастанию p
(define (rp-factor n)
  (let loop ((n n) (d 2) (acc '()))
    (cond ((= n 1) (reverse acc))
          ((> (* d d) n) (reverse (cons (cons n 1) acc)))
          ((= (modulo n d) 0)
           (let cnt ((m n) (e 0))
             (if (= (modulo m d) 0)
                 (cnt (quotient m d) (+ e 1))
                 (loop m (+ d 1) (cons (cons d e) acc)))))
          (else (loop n (+ d 1) acc)))))
(define (rp-prime-factors n) (map car (rp-factor n)))

(define (rp-list< a b)
  (cond ((null? a) (not (null? b)))
        ((null? b) #f)
        ((< (car a) (car b)) #t)
        ((> (car a) (car b)) #f)
        (else (rp-list< (cdr a) (cdr b)))))

; ---------- многочлены (коэффициенты по возрастанию степени) и круговые многочлены ----------

(define (rp-zeros n) (map (lambda (i) 0) (range n)))
(define (rp-pad l n) (if (< (length l) n) (append l (rp-zeros (- n (length l)))) l))

(define (rp-poly-mul a b)
  (let ((r (make-vector (+ (length a) (length b) -1) 0)))
    (for-each (lambda (i)
                (let ((ai (nth a i)))
                  (if (not (= ai 0))
                      (for-each (lambda (j) (vset! r (+ i j) (+ (vref r (+ i j)) (* ai (nth b j)))))
                                (range (length b))))))
              (range (length a)))
    (vector->list r)))

; деление на монический b: (частное остаток), остаток — ровно deg b коэффициентов
(define (rp-polydiv a b)
  (let ((da (- (length a) 1)) (db (- (length b) 1)))
    (if (< da db)
        (list '(0) (rp-pad a db))
        (let ((r (list->vector a)) (q (make-vector (+ (- da db) 1) 0)))
          (let loop ((i (- da db)))
            (if (>= i 0)
                (let ((c (vref r (+ i db))))
                  (vset! q i c)
                  (for-each (lambda (j) (vset! r (+ i j) (- (vref r (+ i j)) (* c (nth b j)))))
                            (range (+ db 1)))
                  (loop (- i 1)))
                #f))
          (list (vector->list q) (take (vector->list r) db))))))

(define rp-cyc-cache (make-hash))
(define (rp-divisors n) (filter (lambda (d) (= (modulo n d) 0)) (map (lambda (i) (+ i 1)) (range n))))
; Φ_n = (x^n − 1) / Π_{d | n, d < n} Φ_d
(define (rp-cyclo-poly n)
  (let ((c (hash-ref rp-cyc-cache n #f)))
    (if c
        c
        (let ((q (foldl (lambda (acc d) (car (rp-polydiv acc (rp-cyclo-poly d))))
                        (cons -1 (append (rp-zeros (- n 1)) (list 1)))
                        (filter (lambda (d) (< d n)) (rp-divisors n)))))
          (hash-set! rp-cyc-cache n q)
          q))))
(define (rp-phi N) (- (length (rp-cyclo-poly N)) 1))

; ---------- элементы Q(ζ_N): список коэффициентов длины φ(N) ----------

(define (rp-reduce N p)
  (rp-pad (cadr (rp-polydiv p (rp-cyclo-poly N))) (rp-phi N)))
(define (rp-cconst N q) (rp-pad (list q) (rp-phi N)))
(define (rp-czeta N j) (rp-reduce N (append (rp-zeros (modulo j N)) (list 1))))
(define (rp-cadd a b) (map2 + a b))
(define (rp-csub a b) (map2 - a b))
(define (rp-cscale q a) (map (lambda (x) (* q x)) a))
(define (rp-cmul N a b) (rp-reduce N (rp-poly-mul a b)))
(define (rp-csum N l) (foldl rp-cadd (rp-cconst N 0) l))
(define (rp-czero? a) (every? (lambda (x) (= x 0)) a))
; рациональное значение или #f
(define (rp-crat a) (if (every? (lambda (x) (= x 0)) (cdr a)) (car a) #f))
; автоморфизм ζ → ζ^a
(define (rp-cgalois N a c)
  (let ((v (make-vector N 0)))
    (for-each (lambda (i)
                (let ((k (modulo (* i a) N)))
                  (vset! v k (+ (vref v k) (nth c i)))))
              (range (length c)))
    (rp-reduce N (vector->list v))))
(define (rp-cconj N c) (rp-cgalois N (- N 1) c))

(define rp-trig-cache (make-hash))
(define (rp-cos-sin N i)
  (let ((key (list N i)))
    (let ((c (hash-ref rp-trig-cache key #f)))
      (if c
          c
          (let ((v (if (= i 0)
                       (list 1.0 0.0)
                       (let ((ang (list '* 2 'pi (/ i N))))
                         (list (* 1.0 (eval-num (list 'cos ang))) (* 1.0 (eval-num (list 'sin ang))))))))
            (hash-set! rp-trig-cache key v)
            v)))))
; численное значение (re im)
(define (rp-cnum N c)
  (let loop ((i 0) (cs c) (re 0.0) (im 0.0))
    (if (null? cs)
        (list re im)
        (let ((t (rp-cos-sin N i)))
          (loop (+ i 1) (cdr cs) (+ re (* (car cs) (car t))) (+ im (* (car cs) (cadr t))))))))
(define (rp-map3 f a b c)
  (map (lambda (i) (f (nth a i) (nth b i) (nth c i))) (range (length a))))
(define (rp-round x) (floor (+ (* 1000000 x) 0.5)))

; ---------- корни и значения: выражение ↔ элемент Q(ζ_N) ----------

(define (rp-need N m what)
  (if (= (modulo N m) 0)
      #t
      (error (string-append "repr: значение вне Q(ζ_" (to-string N) "): нужен корень из единицы порядка " (to-string m) " для " what))))

; сумма Гаусса простого нечётного p: √p (p ≡ 1 mod 4) или i√p (p ≡ 3 mod 4)
(define (rp-gauss N p)
  (rp-need N p "суммы Гаусса")
  (let ((v (make-vector N 0)) (step (quotient N p)))
    (for-each (lambda (a0)
                (let* ((a (+ a0 1))
                       (leg (if (= (rp-pow-mod a (quotient (- p 1) 2) p) 1) 1 -1))
                       (k (modulo (* a step) N)))
                  (vset! v k (+ (vref v k) leg))))
              (range (- p 1)))
    (rp-reduce N (vector->list v))))

; √D для рационального D ≠ 0 (положительная ветвь: √(−1) = i)
(define (rp-sqrt-cyc N D)
  (let* ((neg (< D 0))
         (A (abs-rat D))
         (M (* (numer A) (denom A)))
         (fs (rp-factor M))
         (s 1) (c 0) (acc (rp-cconst N 1)))
    (for-each
      (lambda (pe)
        (let ((p (car pe)) (e (cdr pe)))
          (set! s (* s (^ p (quotient e 2))))
          (if (= (modulo e 2) 1)
              (cond ((= p 2)
                     (rp-need N 8 "√2")
                     (set! acc (rp-cmul N acc (rp-cadd (rp-czeta N (quotient N 8)) (rp-czeta N (- N (quotient N 8)))))))
                    (else
                     (set! acc (rp-cmul N acc (rp-gauss N p)))
                     (if (= (modulo p 4) 3) (set! c (- c 1))))))))
      fs)
    (if neg (set! c (+ c 1)))
    (let ((cc (modulo c 4)))
      (let loop ((k 0))
        (if (< k cc)
            (begin (rp-need N 4 "i")
                   (set! acc (rp-cmul N acc (rp-czeta N (quotient N 4))))
                   (loop (+ k 1)))
            #f)))
    (rp-cscale (/ s (denom A)) acc)))
(define (abs-rat x) (if (< x 0) (- x) x))

; алгебраическое число квадратичной степени из записи root(a b c, lo, hi)
(define (rp-alg->cyc N x)
  (let* ((str (to-string x))
         (i0 (string-index str "("))
         (i1 (string-index str ","))
         (cs (map string->number (string-split (substring str (+ i0 1) i1) " "))))
    (if (not (= (length cs) 3))
        (error "repr: поддерживаются только квадратичные иррациональности" x)
        (let* ((a (car cs)) (b (cadr cs)) (c (caddr cs))
               (disc (- (* b b) (* 4 a c)))
               (xv (eval-num x))
               (sd (eval-num (list 'sqrt disc)))
               (plus (/ (+ (- b) sd) (* 2 a)))
               (minus (/ (- (- b) sd) (* 2 a)))
               (sgn (if (< (abs-rat (- xv plus)) (abs-rat (- xv minus))) 1 -1)))
          (rp-cscale (/ 1 (* 2 a))
                     (rp-cadd (rp-cconst N (- b)) (rp-cscale sgn (rp-sqrt-cyc N disc))))))))

; r, если arg = r·%i·pi; иначе #f
(define (rp-exp-angle arg)
  (if (and (pair? arg) (equal? (car arg) '*))
      (let loop ((fs (cdr arg)) (r 1) (ni 0) (np 0))
        (cond ((null? fs) (if (and (= ni 1) (= np 1)) r #f))
              ((equal? (car fs) '%i) (loop (cdr fs) r (+ ni 1) np))
              ((equal? (car fs) 'pi) (loop (cdr fs) r ni (+ np 1)))
              ((or (integer? (car fs)) (equal? (type-of (car fs)) 'rational)) (loop (cdr fs) (* r (car fs)) ni np))
              (else #f)))
      #f))

(define (rp-expr->cyc N e)
  (let ((ty (type-of e)))
    (cond ((or (equal? ty 'integer) (equal? ty 'rational)) (rp-cconst N e))
          ((equal? ty 'float)
           (if (= e (floor e))
               (rp-cconst N (floor e))
               (error "repr: ожидаются точные значения, получено число с плавающей точкой" e)))
          ((equal? ty 'algebraic) (rp-alg->cyc N e))
          ((equal? e '%i) (rp-need N 4 "i") (rp-czeta N (quotient N 4)))
          ((pair? e) (rp-list->cyc N e))
          (else (error "repr: значение не разобрано" e)))))

(define (rp-list->cyc N e)
  (let ((h (car e)) (args (cdr e)))
    (cond ((equal? h '+) (foldl (lambda (acc a) (rp-cadd acc (rp-expr->cyc N a))) (rp-cconst N 0) args))
          ((equal? h '*) (foldl (lambda (acc a) (rp-cmul N acc (rp-expr->cyc N a))) (rp-cconst N 1) args))
          ((equal? h '-)
           (if (null? (cdr args))
               (rp-cscale -1 (rp-expr->cyc N (car args)))
               (rp-csub (rp-expr->cyc N (car args))
                        (foldl (lambda (acc a) (rp-cadd acc (rp-expr->cyc N a))) (rp-cconst N 0) (cdr args)))))
          ((equal? h '/)
           (let ((b (cadr args)))
             (if (and (number? b) (not (= b 0)) (member? (type-of b) '(integer rational)))
                 (rp-cscale (/ 1 b) (rp-expr->cyc N (car args)))
                 (error "repr: делитель должен быть ненулевым рациональным числом" e))))
          ((and (equal? h '^) (equal? (cadr args) 1/2)
                (member? (type-of (car args)) '(integer rational)) (not (= (car args) 0)))
           (rp-sqrt-cyc N (car args)))
          ((equal? h '^)
           (let ((k (cadr args)))
             (if (and (integer? k) (>= k 0))
                 (let ((b (rp-expr->cyc N (car args))))
                   (let loop ((i 0) (r (rp-cconst N 1)))
                     (if (= i k) r (loop (+ i 1) (rp-cmul N r b)))))
                 (error "repr: показатель должен быть целым неотрицательным" e))))
          ((equal? h 'exp)
           (let ((r (rp-exp-angle (car args))))
             (if (not r)
                 (error "repr: exp допустим только как exp(r·%i·pi)" e)
                 (let ((j (* r (/ N 2))))
                   (if (integer? j)
                       (rp-czeta N (modulo j N))
                       (error "repr: корень из единицы вне Q(ζ_N)" e))))))
          ((equal? h 'sqrt)
           (let ((d (car args)))
             (if (and (member? (type-of d) '(integer rational)) (not (= d 0)))
                 (rp-sqrt-cyc N d)
                 (error "repr: sqrt допустим только от ненулевого рационального" e))))
          (else (error "repr: значение не разобрано" e)))))

; значение символа/числа/списка коэффициентов → элемент Q(ζ_N)
(define (rp-coerce N x)
  (if (and (pair? x) (= (length x) (rp-phi N)) (every? (lambda (v) (member? (type-of v) '(integer rational))) x))
      x
      (rp-expr->cyc N x)))

; элемент Q(ζ_N) → выражение: рациональное; ±ζ^j; квадратичная иррациональность (a + b√D); иначе Σ cᵢ ζ^i
(define (rp-units N) (filter (lambda (a) (= (gcd a N) 1)) (map (lambda (i) (+ i 1)) (range N))))

(define (rp-root-expr j N)
  (let ((r (/ (* 2 j) N)))   ; ζ^j = exp(iπ r)
    (cond ((= r 0) 1)
          ((= r 1) -1)
          ((= r 1/2) '%i)
          ((= r 3/2) (list '* -1 '%i))
          (else (simplify (list 'exp (list '* r '%i 'pi)))))))

(define (rp-single-root N c)
  (let loop ((j 0) (sgn 1))
    (cond ((= j N) (if (= sgn 1) (loop 0 -1) #f))
          ((equal? c (rp-cscale sgn (rp-czeta N j)))
           (if (= sgn 1) (rp-root-expr j N) (simplify (list '* -1 (rp-root-expr j N)))))
          (else (loop (+ j 1) sgn)))))

(define (rp-quadratic N c)
  (let ((imgs (foldl (lambda (acc a)
                       (let ((g (rp-cgalois N a c))) (if (member? g acc) acc (append acc (list g)))))
                     '() (rp-units N))))
    (if (not (= (length imgs) 2))
        #f
        (let* ((z (car imgs)) (z2 (cadr imgs))
               (t (rp-crat (rp-cadd z z2)))
               (n (rp-crat (rp-cmul N z z2))))
          (if (not (and t n))
              #f
              (let* ((disc (- (* t t) (* 4 n)))
                     (zn (rp-cnum N c))
                     (sd (eval-num (list 'sqrt (abs-rat disc))))
                     (sgn (if (> disc 0)
                              (if (< (abs-rat (- (car zn) (/ (+ t sd) 2))) (abs-rat (- (car zn) (/ (- t sd) 2)))) 1 -1)
                              (if (> (cadr zn) 0) 1 -1))))
                (* 1/2 (+ t (* sgn (sqrt disc))))))))))

(define (rp-sum-expr N c)
  (simplify
    (cons '+ (filter (lambda (x) x)
                     (map (lambda (i)
                            (let ((q (nth c i)))
                              (cond ((= q 0) #f)
                                    ((= i 0) q)
                                    (else (list '* q (rp-root-expr i N))))))
                          (range (length c)))))))

(define (char-value->expr N c)
  (let ((q (rp-crat c)))
    (if q
        q
        (let ((r (rp-single-root N c)))
          (if r
              r
              (let ((u (rp-quadratic N c)))
                (if u u (rp-sum-expr N c))))))))

; ---------- элементы группы и классы сопряжённости ----------

(define (rp-key p) (vector->list p))
(define (rp-gens G)
  (let ((n (cadr G)))
    (map (lambda (g) (perm-mul g (perm-id n))) (car G))))

; все элементы (обход в ширину от тождества); больше 5000 — ошибка
(define (group-elements G)
  (let* ((n (cadr G)) (gens (rp-gens G)) (id (perm-id n)) (seen (make-hash)) (cnt 1))
    (hash-set! seen (rp-key id) #t)
    (let loop ((frontier (list id)) (acc (list id)))
      (if (null? frontier)
          (reverse acc)
          (let ((new '()))
            (for-each
              (lambda (x)
                (for-each
                  (lambda (g)
                    (let* ((y (perm-mul x g)) (k (rp-key y)))
                      (if (not (hash-has? seen k))
                          (begin (hash-set! seen k #t)
                                 (set! cnt (+ cnt 1))
                                 (if (> cnt 5000) (error "repr: группа слишком велика (> 5000 элементов)"))
                                 (set! new (cons y new))))))
                  gens))
              frontier)
            (loop (reverse new) (append new acc)))))))

(define (rp-perm-pow p k)
  (let ((n (length p)))
    (let loop ((i 0) (r (perm-id n)))
      (if (= i k) r (loop (+ i 1) (perm-mul r p))))))

; (элементы классы индекс): класс — (rep размер порядок), порядок классов: (порядок элемента, размер, rep)
(define (rp-classes G)
  (let* ((gens (rp-gens G)) (pairs (map2 cons gens (map perm-inv gens)))
         (elems (group-elements G)) (seen (make-hash)) (found '()))
    (for-each
      (lambda (x)
        (if (not (hash-has? seen (rp-key x)))
            (let ((members (list x)))
              (hash-set! seen (rp-key x) #t)
              (let loop ((frontier (list x)))
                (if (not (null? frontier))
                    (let ((new '()))
                      (for-each
                        (lambda (y)
                          (for-each
                            (lambda (pr)
                              (let* ((z (perm-mul (perm-mul (cdr pr) y) (car pr))) (k (rp-key z)))
                                (if (not (hash-has? seen k))
                                    (begin (hash-set! seen k #t) (set! new (cons z new))))))
                            pairs))
                        frontier)
                      (set! members (append new members))
                      (loop (reverse new)))
                    #f))
              (let ((rep (foldl (lambda (m y) (if (rp-list< (rp-key y) (rp-key m)) y m)) x members)))
                (set! found (cons (list rep (length members) (perm-order rep) members) found))))))
      elems)
    (let* ((sorted (sort found (lambda (a b)
                                 (cond ((< (nth a 2) (nth b 2)) #t)
                                       ((> (nth a 2) (nth b 2)) #f)
                                       ((< (nth a 1) (nth b 1)) #t)
                                       ((> (nth a 1) (nth b 1)) #f)
                                       (else (rp-list< (rp-key (car a)) (rp-key (car b))))))))
           (idx (make-hash)))
      (for-each (lambda (i)
                  (for-each (lambda (m) (hash-set! idx (rp-key m) i)) (nth (nth sorted i) 3)))
                (range (length sorted)))
      (list elems (map (lambda (c) (list (car c) (cadr c) (caddr c))) sorted) idx))))

; классы: список (представитель размер порядок порядок-централизатора)
(define (conjugacy-classes G)
  (let* ((cl (rp-classes G)) (ord (length (car cl))))
    (map (lambda (c) (list (car c) (cadr c) (caddr c) (quotient ord (cadr c)))) (cadr cl))))

; индексы (с 0) классов g^k для представителя g каждого класса (k целое, в т. ч. отрицательное)
(define (class-power-map G k)
  (let ((idx (nth (rp-classes G) 2)))
    (map (lambda (c)
           (let ((p (if (< k 0) (rp-perm-pow (perm-inv (car c)) (- k)) (rp-perm-pow (car c) k))))
             (hash-ref idx (rp-key p) #f)))
         (cadr (rp-classes G)))))

; Q8 как подгруппа S8 (левое регулярное действие): 1 −1 i −i j −j k −k = точки 1…8
(define (quaternion-group)
  (list (list (perm-from-cycles '((1 3 2 4) (5 7 6 8)))
              (perm-from-cycles '((1 5 2 6) (3 8 4 7))))
        8))

; ---------- Диксон — Шнайдер ----------

(define (rp-exponent classes) (foldl lcm 1 (map (lambda (c) (nth c 2)) classes)))

(define (rp-choose-prime e order)
  (let loop ((t 1))
    (let ((p (+ 1 (* e t))))
      (if (and (prime? p) (> (* p p) (* 4 order)) (not (= (modulo order p) 0)))
          p
          (loop (+ t 1))))))

(define (rp-root-of-unity e p)
  (let ((qs (rp-prime-factors e)))
    (let loop ((a 2))
      (let ((z (rp-pow-mod a (quotient (- p 1) e) p)))
        (if (every? (lambda (q) (not (= (rp-pow-mod z (quotient e q) p) 1))) qs)
            z
            (loop (+ a 1)))))))

; cnt[i][j][k] = #{x ∈ C_i : x⁻¹ z_k ∈ C_j}, z_k — представитель C_k
(define (rp-structure-constants elems classes idx)
  (let* ((k (length classes))
         (cnt (list->vector (map (lambda (i) (list->vector (map (lambda (j) (make-vector k 0)) (range k)))) (range k))))
         (pairs (map (lambda (x) (cons (perm-inv x) (hash-ref idx (rp-key x) #f))) elems)))
    (for-each
      (lambda (kk)
        (let ((z (car (nth classes kk))))
          (for-each
            (lambda (pr)
              (let* ((i (cdr pr)) (j (hash-ref idx (rp-key (perm-mul (car pr) z)) #f))
                     (v (vref (vref cnt i) j)))
                (vset! v kk (+ (vref v kk) 1))))
            pairs)))
      (range k))
    cnt))

(define (rp-class-matrix cnt j k)
  (map (lambda (i) (vector->list (vref (vref cnt i) j))) (range k)))

(define (rp-matvec A v p)
  (map (lambda (row) (modulo (apply + (map2 * row v)) p)) A))
(define (rp-lincomb cs S p)
  (let ((len (length (car S))))
    (map (lambda (r) (modulo (apply + (map2 (lambda (c b) (* c (nth b r))) cs S)) p)) (range len))))

; базис ядра матрицы (список строк, ncols столбцов) по модулю p
(define (rp-nullspace M ncols p)
  (let* ((rows (list->vector (map list->vector M))) (nr (vlength rows)) (pivots '()) (r 0))
    (let col-loop ((c 0))
      (if (and (< c ncols) (< r nr))
          (let ((pr (let find ((i r))
                      (cond ((>= i nr) #f)
                            ((not (= (vref (vref rows i) c) 0)) i)
                            (else (find (+ i 1)))))))
            (if pr
                (let ((tmp (vref rows r)))
                  (vset! rows r (vref rows pr))
                  (vset! rows pr tmp)
                  (let ((inv (rp-inv-mod (vref (vref rows r) c) p)) (row (vref rows r)))
                    (for-each (lambda (j) (vset! row j (modulo (* inv (vref row j)) p))) (range ncols))
                    (for-each
                      (lambda (i)
                        (if (not (= i r))
                            (let ((f (vref (vref rows i) c)))
                              (if (not (= f 0))
                                  (let ((ri (vref rows i)))
                                    (for-each (lambda (j) (vset! ri j (modulo (- (vref ri j) (* f (vref row j))) p)))
                                              (range ncols)))))))
                      (range nr)))
                  (set! pivots (append pivots (list (cons c r))))
                  (set! r (+ r 1))))
            (col-loop (+ c 1)))
          #f))
    (let ((pcols (map car pivots)))
      (map (lambda (f)
             (map (lambda (c)
                    (cond ((= c f) 1)
                          ((member? c pcols)
                           (modulo (- 0 (vref (vref rows (cdr (assoc c pivots))) f)) p))
                          (else 0)))
                  (range ncols)))
           (filter (lambda (c) (not (member? c pcols))) (range ncols))))))

; разделение подпространства S (базис — список векторов) собственными подпространствами A
(define (rp-split-space S A p)
  (let* ((d (length S)) (k (length (car S)))
         (ab (map (lambda (b) (rp-matvec A b p)) S)))
    (let loop ((lam 0) (found 0) (out '()))
      (if (or (= lam p) (= found d))
          (reverse out)
          (let* ((cols (map2 (lambda (a b) (map2 (lambda (x y) (modulo (- x (* lam y)) p)) a b)) ab S))
                 (M (map (lambda (r) (map (lambda (c) (nth c r)) cols)) (range k)))
                 (ns (rp-nullspace M d p)))
            (if (null? ns)
                (loop (+ lam 1) found out)
                (loop (+ lam 1) (+ found (length ns))
                      (cons (map (lambda (c) (rp-lincomb c S p)) ns) out))))))))

; общие собственные векторы матриц классовых сумм: список ω (по модулю p), ω[0] = 1
(define (rp-dixon-vectors cnt k p)
  (let ((whole (map (lambda (i) (map (lambda (j) (if (= i j) 1 0)) (range k))) (range k))))
    (let loop ((spaces (list whole)) (j 1))
      (cond ((every? (lambda (s) (= (length s) 1)) spaces)
             (if (= (length spaces) k)
                 (map (lambda (s) (let ((v (car s))) (map (lambda (x) (modulo (* x (rp-inv-mod (car v) p)) p)) v))) spaces)
                 (error "repr: число общих собственных векторов не равно числу классов")))
            ((>= j k) (error "repr: не удалось разделить общие собственные векторы"))
            (else
             (let ((A (rp-class-matrix cnt j k)))
               (loop (append-map (lambda (s) (if (= (length s) 1) (list s) (rp-split-space s A p))) spaces)
                     (+ j 1))))))))

; кратности собственных значений → элемент Q(ζ_e) для класса kk
(define (rp-lift-class chi pw m e z d p)
  (let* ((zm (rp-pow-mod z (quotient e m) p)) (invm (rp-inv-mod m p))
         (ns (map (lambda (j)
                    (modulo (* invm (apply + (map (lambda (t)
                                                    (* (nth chi (nth pw t)) (rp-pow-mod zm (modulo (- 0 (* j t)) m) p)))
                                                  (range m))))
                            p))
                  (range m))))
    (if (not (and (every? (lambda (n) (<= n d)) ns) (= (apply + ns) d)))
        (error "repr: кратности собственных значений вне [0, χ(1)]"))
    (let ((v (make-vector e 0)) (step (quotient e m)))
      (for-each (lambda (j) (vset! v (* j step) (nth ns j))) (range m))
      (rp-reduce e (vector->list v)))))

(define (rp-row-key N row)
  (apply append (map (lambda (c) (let ((x (rp-cnum N c))) (list (rp-round (car x)) (rp-round (cadr x))))) row)))
(define (rp-sort-rows N rows)
  (map caddr
       (sort (map (lambda (r) (list (rp-crat (car r)) (rp-row-key N r) r)) rows)
             (lambda (a b)
               (cond ((< (car a) (car b)) #t)
                     ((> (car a) (car b)) #f)
                     (else (rp-list< (nth b 1) (nth a 1))))))))

; таблица: (char-table G e классы строки pow2); строки — списки элементов Q(ζ_e) по классам
(define (character-table G)
  (let* ((cl (rp-classes G)) (elems (car cl)) (classes (cadr cl)) (idx (nth cl 2))
         (order (length elems)) (k (length classes)) (e (rp-exponent classes))
         (p (rp-choose-prime e order)) (z (rp-root-of-unity e p))
         (cnt (rp-structure-constants elems classes idx))
         (sizes (map (lambda (c) (nth c 1)) classes))
         (inv-idx (map (lambda (c) (hash-ref idx (rp-key (perm-inv (car c))) #f)) classes))
         (pw (map (lambda (c)
                    (let loop ((t 0) (q (perm-id (cadr G))) (acc '()))
                      (if (= t (nth c 2))
                          (reverse acc)
                          (loop (+ t 1) (perm-mul q (car c)) (cons (hash-ref idx (rp-key q) #f) acc)))))
                  classes))
         (omegas (if (= k 1) (list (list 1)) (rp-dixon-vectors cnt k p)))
         (rows
           (map (lambda (om)
                  (let* ((s (modulo (apply + (map (lambda (kk)
                                                    (* (nth om kk) (nth om (nth inv-idx kk)) (rp-inv-mod (nth sizes kk) p)))
                                                  (range k)))
                                    p))
                         (d2 (modulo (* order (rp-inv-mod s p)) p))
                         (d (let find ((d 1))
                              (cond ((> (* d d) order) (error "repr: не найдена степень характера"))
                                    ((= (modulo (* d d) p) d2) d)
                                    (else (find (+ d 1))))))
                         (chi (map (lambda (kk) (modulo (* d (nth om kk) (rp-inv-mod (nth sizes kk) p)) p)) (range k))))
                    (map (lambda (kk) (rp-lift-class chi (nth pw kk) (nth (nth classes kk) 2) e z d p)) (range k))))
                omegas))
         (pow2 (map (lambda (c) (hash-ref idx (rp-key (rp-perm-pow (car c) 2)) #f)) classes)))
    (list 'char-table G e
          (map (lambda (c) (list (car c) (cadr c) (caddr c) (quotient order (cadr c)))) classes)
          (rp-sort-rows e rows)
          pow2)))

(define (char-table? t) (and (pair? t) (equal? (car t) 'char-table)))
(define (char-table-group t) (nth t 1))
(define (char-table-exponent t) (nth t 2))
(define (char-table-classes t) (nth t 3))
(define (char-table-rows t) (nth t 4))
(define (char-table-degrees t) (map (lambda (r) (rp-crat (car r))) (nth t 4)))
(define (char-table-with-rows t rows) (list 'char-table (nth t 1) (nth t 2) (nth t 3) rows (nth t 5)))
(define (char-table->exprs t)
  (map (lambda (r) (map (lambda (c) (char-value->expr (nth t 2) c)) r)) (nth t 4)))

; ---------- действия над характерами ----------

(define (rp-order t) (apply + (map (lambda (c) (nth c 1)) (nth t 3))))
(define (char-coerce t chi)
  (if (not (= (length chi) (length (nth t 3))))
      (error "repr: длина характера не равна числу классов сопряжённости")
      (map (lambda (x) (rp-coerce (nth t 2) x)) chi)))

; Σ |C| χ(g) conj ψ(g) / |G| — рациональное либо unknown
(define (rp-inner-cyc t a b)
  (let ((N (nth t 2)))
    (rp-csum N (rp-map3 (lambda (c x y) (rp-cscale (nth c 1) (rp-cmul N x (rp-cconj N y)))) (nth t 3) a b))))
(define (char-inner t chi psi)
  (let* ((N (nth t 2))
         (s (rp-inner-cyc t (char-coerce t chi) (char-coerce t psi)))
         (q (rp-crat s)))
    (if q (/ q (rp-order t)) 'unknown)))

; кратности неприводимых (в порядке строк таблицы) или unknown, если не целые
(define (char-decompose t chi)
  (let* ((N (nth t 2)) (c (char-coerce t chi))
         (ms (map (lambda (r) (let ((s (rp-inner-cyc t c r))) (let ((q (rp-crat s))) (if q (/ q (rp-order t)) #f))))
                  (nth t 4))))
    (if (and (every? (lambda (m) (and m (integer? m))) ms) (rp-decomp-ok? t c ms))
        ms
        'unknown)))
(define (rp-decomp-ok? t c ms)
  (let ((N (nth t 2)))
    (equal? c
            (map (lambda (kk)
                   (rp-csum N (map2 (lambda (m r) (rp-cscale m (nth r kk))) ms (nth t 4))))
                 (range (length c))))))

(define (char-tensor t chi psi)
  (let ((N (nth t 2)))
    (map2 (lambda (x y) (rp-cmul N x y)) (char-coerce t chi) (char-coerce t psi))))
(define (char-dual t chi)
  (let ((N (nth t 2))) (map (lambda (x) (rp-cconj N x)) (char-coerce t chi))))
; (χ² ± χ(g²)) / 2
(define (rp-square-part t chi sign)
  (let* ((N (nth t 2)) (c (char-coerce t chi)))
    (map2 (lambda (x i2)
            (rp-cscale 1/2 (rp-cadd (rp-cmul N x x) (rp-cscale sign (nth c i2)))))
          c (nth t 5))))
(define (char-sym2 t chi) (rp-square-part t chi 1))
(define (char-alt2 t chi) (rp-square-part t chi -1))

; перестановочный характер: число неподвижных точек представителя
(define (char-permutation t)
  (let ((N (nth t 2)))
    (map (lambda (c)
           (rp-cconst N (length (filter (lambda (i) (= (vref (car c) i) i)) (range (length (car c)))))))
         (nth t 3))))
; регулярный характер
(define (char-regular t)
  (let ((N (nth t 2)))
    (cons (rp-cconst N (rp-order t)) (map (lambda (c) (rp-cconst N 0)) (cdr (nth t 3))))))

; ---------- представление матрицами образующих ----------

(define (rp-norm e) (if (number? e) e (simplify (expand e))))
(define (rp-mat-mul A B)
  (let ((cols (map (lambda (j) (map (lambda (row) (nth row j)) B)) (range (length (car B))))))
    (map (lambda (row)
           (map (lambda (col) (rp-norm (apply + (map2 * row col)))) cols))
         A)))
; равенство элементов: разность упрощается в 0, либо оба значения — элементы Q(ζ_N) и совпадают
(define (rp-entry-equal? N a b)
  (or (equal? (rp-norm (- a b)) 0)
      (try (equal? (rp-expr->cyc N a) (rp-expr->cyc N b)) (lambda (err) #f))))
(define (rp-mat-equal? N A B)
  (every? (lambda (p) (every? (lambda (q) (rp-entry-equal? N (car q) (cdr q))) (map2 cons (car p) (cdr p))))
          (map2 cons A B)))
(define (rp-trace M) (apply + (map2 (lambda (row i) (nth row i)) M (range (length M)))))

; характер представления: образующим группы (в порядке G) сопоставлены матрицы; проверяется, что это гомоморфизм
(define (char-from-matrices t mats)
  (let* ((G (nth t 1)) (gens (rp-gens G)) (N (nth t 2)) (n (cadr G))
         (d (length (car mats)))
         (id (perm-id n)) (mats-of (make-hash)))
    (if (not (= (length mats) (length gens)))
        (error "repr: число матриц не равно числу образующих"))
    (if (not (every? (lambda (M) (and (= (length M) d) (every? (lambda (r) (= (length r) d)) M))) mats))
        (error "repr: матрицы образующих должны быть квадратными одного порядка"))
    (hash-set! mats-of (rp-key id)
               (map (lambda (i) (map (lambda (j) (if (= i j) 1 0)) (range d))) (range d)))
    (let loop ((frontier (list id)))
      (if (not (null? frontier))
          (let ((new '()))
            (for-each
              (lambda (x)
                (for-each
                  (lambda (gm)
                    (let* ((g (car gm)) (M (cdr gm))
                           (y (perm-mul x g)) (k (rp-key y))
                           (My (rp-mat-mul (hash-ref mats-of (rp-key x) #f) M)))
                      (if (hash-has? mats-of k)
                          (if (not (rp-mat-equal? N (hash-ref mats-of k #f) My))
                              (error "repr: матрицы не задают представление группы (нарушено соотношение)"))
                          (begin (hash-set! mats-of k My) (set! new (cons y new))))))
                  (map2 cons gens mats)))
              frontier)
            (loop (reverse new)))
          #f))
    (map (lambda (c) (rp-expr->cyc N (rp-trace (hash-ref mats-of (rp-key (car c)) #f)))) (nth t 3))))

; ---------- сертификат ----------

; (вердикт строки столбцы степени число алгебра-классов): вердикт exact | mismatch | unknown (значения не разобраны)
(define (character-table-check G tbl)
  (let* ((cl (rp-classes G)) (elems (car cl)) (classes (cadr cl)) (idx (nth cl 2))
         (order (length elems)) (k (length classes)) (e (rp-exponent classes))
         (rows0 (if (char-table? tbl) (nth tbl 4) tbl))
         (rows (try (map (lambda (r) (if (= (length r) k) (map (lambda (x) (rp-coerce e x)) r) #f)) rows0)
                    (lambda (err) 'unparsed))))
    (cond ((equal? rows 'unparsed) (list 'unknown #f #f #f #f #f))
          ((not (every? (lambda (r) r) rows)) (list 'mismatch #f #f #f #f #f))
          (else (rp-check-rows e order classes idx elems rows)))))

(define (rp-check-rows e order classes idx elems rows)
  (let* ((k (length classes)) (nr (length rows))
         (sizes (map (lambda (c) (nth c 1)) classes))
         (zero (rp-cconst e 0))
         (count-ok (= nr k))
         (inner (lambda (a b)
                  (rp-csum e (rp-map3 (lambda (s x y) (rp-cscale s (rp-cmul e x (rp-cconj e y)))) sizes a b))))
         (rows-ok (every? (lambda (i)
                            (every? (lambda (j)
                                      (equal? (inner (nth rows i) (nth rows j))
                                              (rp-cconst e (if (= i j) order 0))))
                                    (range nr)))
                          (range nr)))
         (cols-ok (every? (lambda (a)
                            (every? (lambda (b)
                                      (equal? (rp-csum e (map (lambda (r) (rp-cmul e (nth r a) (rp-cconj e (nth r b)))) rows))
                                              (rp-cconst e (if (= a b) (quotient order (nth sizes a)) 0))))
                                    (range k)))
                          (range k)))
         (degs (map (lambda (r) (rp-crat (car r))) rows))
         (deg-ok (and (every? (lambda (d) (and d (integer? d) (> d 0))) degs)
                      (= (apply + (map (lambda (d) (* d d)) degs)) order)))
         (alg-ok (and count-ok deg-ok (rp-class-algebra-ok? e elems classes idx rows))))
    (list (if (and count-ok rows-ok cols-ok deg-ok alg-ok) 'exact 'mismatch)
          rows-ok cols-ok deg-ok count-ok alg-ok)))

; ω_i ω_j = Σ_k a_ijk ω_k для каждой строки (ω_c = |C| χ(c) / χ(1)): строка — характер неприводимого представления
(define (rp-class-algebra-ok? e elems classes idx rows)
  (let* ((k (length classes)) (cnt (rp-structure-constants elems classes idx)))
    (every?
      (lambda (r)
        (let* ((d (rp-crat (car r)))
               (om (map2 (lambda (c x) (rp-cscale (/ (nth c 1) d) x)) classes r)))
          (every? (lambda (i)
                    (every? (lambda (j)
                              (equal? (rp-cmul e (nth om i) (nth om j))
                                      (rp-csum e (map (lambda (kk) (rp-cscale (vref (vref (vref cnt i) j) kk) (nth om kk)))
                                                      (range k)))))
                            (range k)))
                  (range k))))
      rows)))

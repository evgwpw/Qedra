; sos.lisp — неравенства многочленов: суммы квадратов (SOS), матрицы Грама, AM-GM, сертификаты (шаг SOS).
; Главное: (prove-nonneg p vars) → (proved cert) | (counterexample point value) | unknown;
; (prove-nonneg-on p x a b) — на отрезке [a, b]; (sos-check p vars cert) → #t/#f — независимая проверка (expand/точная арифметика).
; Сертификаты:
;   (sos (c q) ...)               p = Σ c·q², c > 0 рациональные;
;   (sos-on a b (i j (c q) ...) ...)   p = Σ (x−a)^i (b−x)^j · c·q² (на [a, b] множители ≥ 0);
;   (amgm (c e ((w a) ...)) ...)  отрицательный одночлен −c·x^e покрыт взвешенным AM-GM: Σ w = 1, Σ w·a = e, a чётные.
; Внутренние имена — sos-. Многочлен внутри — разреженный список ((показатели . коэффициент) ...).
; Gram: p = Σ_k g_k · m_kᵀ Q_k m_k, Q_k ⪰ 0 точно над ℚ: вещественные проекции (чередующиеся, double) ищут точку внутри
; конуса, затем округление до 2^-k, точная проекция на аффинное подпространство и точный LDLᵀ (все шаги — ℚ, double — только подсказка).
(module sos
  (export prove-nonneg prove-nonneg-on sos-check sos-decompose sos-amgm))

; ---------- разреженные многочлены ----------

(define (sos-zeros n) (if (= n 0) '() (cons 0 (sos-zeros (- n 1)))))
(define (sos-unit n i k) (map (lambda (j) (if (= j i) k 0)) (range n)))
(define (sos-range a b) (if (< a b) (drop (range b) a) '()))
(define (sos-index x l)
  (let loop ((l l) (i 0))
    (cond ((null? l) #f) ((equal? (car l) x) i) (else (loop (cdr l) (+ i 1))))))
(define (sos-float? c) (equal? (type-of c) 'float))
(define (sos-rat? c) (and (number? c) (not (sos-float? c))))
(define (sos-fabs x) (if (< x 0) (- 0 x) x))
(define (sos-max-list l) (foldl (lambda (a x) (if (> x a) x a)) (car l) (cdr l)))

(define (sos-padd-term p e c)
  (cond ((null? p) (if (= c 0) '() (list (cons e c))))
        ((equal? (car (car p)) e)
         (let ((s (+ (cdr (car p)) c)))
           (if (= s 0) (cdr p) (cons (cons e s) (cdr p)))))
        (else (cons (car p) (sos-padd-term (cdr p) e c)))))
(define (sos-padd a b) (foldl (lambda (acc t) (sos-padd-term acc (car t) (cdr t))) a b))
(define (sos-pscale p c) (if (= c 0) '() (map (lambda (t) (cons (car t) (* c (cdr t)))) p)))
(define (sos-pmul a b)
  (foldl (lambda (acc ta)
           (foldl (lambda (acc2 tb) (sos-padd-term acc2 (map2 + (car ta) (car tb)) (* (cdr ta) (cdr tb)))) acc b))
         '() a))
(define (sos-pone n) (list (cons (sos-zeros n) 1)))
(define (sos-ppow p k n) (if (= k 0) (sos-pone n) (sos-pmul p (sos-ppow p (- k 1) n))))

; выражение → разреженный многочлен по vars; не многочлен / float / посторонний символ → error
(define (sos-parse e vars)
  (sos-parse-n e vars (length vars)))
(define (sos-parse-n e vars n)
  (cond ((number? e)
         (cond ((sos-float? e) (error "sos: коэффициенты должны быть рациональными" e))
               ((= e 0) '())
               (else (list (cons (sos-zeros n) e)))))
        ((symbol? e)
         (let ((i (sos-index e vars)))
           (if i (list (cons (sos-unit n i 1) 1)) (error "sos: посторонний символ" e))))
        ((pair? e)
         (let ((h (car e)))
           (cond ((equal? h '+) (foldl (lambda (acc a) (sos-padd acc (sos-parse-n a vars n))) '() (cdr e)))
                 ((equal? h '*) (foldl (lambda (acc a) (sos-pmul acc (sos-parse-n a vars n))) (sos-pone n) (cdr e)))
                 ((equal? h '-)
                  (if (null? (cddr e))
                      (sos-pscale (sos-parse-n (cadr e) vars n) -1)
                      (sos-padd (sos-parse-n (cadr e) vars n)
                                (sos-pscale (foldl (lambda (acc a) (sos-padd acc (sos-parse-n a vars n))) '() (cddr e)) -1))))
                 ((equal? h '/)
                  (let ((d (caddr e)))
                    (if (and (sos-rat? d) (not (= d 0)))
                        (sos-pscale (sos-parse-n (cadr e) vars n) (/ 1 d))
                        (error "sos: деление на не число" e))))
                 ((equal? h '^)
                  (let ((k (caddr e)))
                    (if (and (integer? k) (>= k 0))
                        (sos-ppow (sos-parse-n (cadr e) vars n) k n)
                        (error "sos: степень не целая неотрицательная" e))))
                 (else (error "sos: не многочлен" e)))))
        (else (error "sos: не многочлен" e))))

(define (sos-ipow q k) (if (= k 0) 1 (* q (sos-ipow q (- k 1)))))
(define (sos-eval P pt)
  (foldl (lambda (acc t)
           (+ acc (* (cdr t) (foldl (lambda (a2 pe) (* a2 (sos-ipow (car pe) (cdr pe)))) 1 (map2 cons pt (car t))))))
         0 P))
(define (sos-deg P) (if (null? P) 0 (sos-max-list (map (lambda (t) (foldl + 0 (car t))) P))))

(define (sos-mono-expr e vars)
  (let ((fs (filter (lambda (x) x)
                    (map2 (lambda (v k) (cond ((= k 0) #f) ((= k 1) v) (else (list '^ v k)))) vars e))))
    (cond ((null? fs) 1) ((null? (cdr fs)) (car fs)) (else (simplify (cons '* fs))))))
(define (sos-lin-expr coefs exprs)
  (let ((ts (filter (lambda (x) x)
                    (map2 (lambda (c m) (if (= c 0) #f (if (equal? m 1) c (list '* c m)))) coefs exprs))))
    (if (null? ts) 0 (simplify (cons '+ ts)))))
(define (sos-p->expr P vars)
  (if (null? P) 0
      (simplify (cons '+ (map (lambda (t) (list '* (cdr t) (sos-mono-expr (car t) vars))) P)))))

(define (sos-rat-cert? c) (and (sos-rat? c) (> c 0)))

; ---------- точный LDLᵀ ----------

(define (sos-mref A i j) (nth (nth A i) j))
(define (sos-ldl Q)
  (sos-ldl-go Q (length Q) 0 '()))
(define (sos-ldl-go A n k acc)
  (if (= k n)
      (reverse acc)
      (let ((d (sos-mref A k k)))
        (cond ((< d 0) #f)
              ((= d 0)
               (if (every? (lambda (j) (= (sos-mref A k j) 0)) (sos-range k n))
                   (sos-ldl-go A n (+ k 1) acc)
                   #f))
              (else
               (let ((l (map (lambda (i) (if (< i k) 0 (/ (sos-mref A i k) d))) (range n))))
                 (sos-ldl-go (map2 (lambda (row li) (map2 (lambda (a lj) (- a (* d li lj))) row l)) A l)
                             n (+ k 1) (cons (cons d l) acc))))))))

; ---------- метод Якоби (double) ----------

(define (sos-offdiag A n)
  (foldl (lambda (s i) (foldl (lambda (s2 j) (let ((a (vref (vref A i) j))) (+ s2 (* a a)))) s (sos-range (+ i 1) n))) 0.0 (range n)))
(define (sos-rot! A V n p q)
  (let ((apq (vref (vref A p) q)))
    (if (> (sos-fabs apq) 1e-300)
        (let* ((app (vref (vref A p) p)) (aqq (vref (vref A q) q))
               (th (/ (- aqq app) (* 2.0 apq)))
               (tt (/ (if (< th 0.0) -1.0 1.0) (+ (sos-fabs th) (sqrt (+ (* th th) 1.0)))))
               (c (/ 1.0 (sqrt (+ (* tt tt) 1.0))))
               (s (* tt c)))
          (for-each (lambda (k)
                      (let* ((row (vref A k)) (akp (vref row p)) (akq (vref row q)))
                        (vset! row p (- (* c akp) (* s akq)))
                        (vset! row q (+ (* s akp) (* c akq)))))
                    (range n))
          (let ((rp (vref A p)) (rq (vref A q)))
            (for-each (lambda (k)
                        (let ((apk (vref rp k)) (aqk (vref rq k)))
                          (vset! rp k (- (* c apk) (* s aqk)))
                          (vset! rq k (+ (* s apk) (* c aqk)))))
                      (range n)))
          (for-each (lambda (k)
                      (let* ((row (vref V k)) (vkp (vref row p)) (vkq (vref row q)))
                        (vset! row p (- (* c vkp) (* s vkq)))
                        (vset! row q (+ (* s vkp) (* c vkq)))))
                    (range n)))
        0)))
(define (sos-identity-v n)
  (let ((V (make-vector n 0)))
    (for-each (lambda (i) (let ((r (make-vector n 0.0))) (vset! r i 1.0) (vset! V i r))) (range n))
    V))
; A: вектор векторов (портится); результат — V (столбцы — собственные векторы), собственные числа — диагональ A
(define (sos-jacobi! A n)
  (let ((V (sos-identity-v n)))
    (let sweep ((s 0))
      (if (and (< s 40) (> (sos-offdiag A n) 1e-26))
          (begin
            (for-each (lambda (p) (for-each (lambda (q) (sos-rot! A V n p q)) (sos-range (+ p 1) n))) (range n))
            (sweep (+ s 1)))
          V))))
(define (sos-copy-mat M) (list->vector (map (lambda (r) (list->vector (vector->list r))) (vector->list M))))
(define (sos-mat-lists M) (map vector->list (vector->list M)))

; ---------- Gram: постановка ----------
; blocks: список (g basis): g — разреженный множитель, basis — список показателей (одночленов).
; st — вектор: 0 vlist ((b i j) ...), 1 ents (вектор строк: список (v . a)), 2 rhs (вектор), 3 vcols (вектор: список (r . a)),
; 4 w (вектор весов), 5 G (вектор векторов, точная), 6 Gf (double), 7 diag?, 8 blocks, 9 sizes, 10 nrows

(define (sos-var-list sizes)
  (append-map (lambda (b)
                (let ((n (nth sizes b)))
                  (append-map (lambda (i) (map (lambda (j) (list b i j)) (sos-range i n))) (range n))))
              (range (length sizes))))

(define (sos-gram-setup P blocks)
  (let* ((sizes (map (lambda (b) (length (cadr b))) blocks))
         (bases (map (lambda (b) (list->vector (cadr b))) blocks))
         (vl (sos-var-list sizes))
         (nv (length vl))
         (h (make-hash)))
    (let fill ((l vl) (v 0))
      (if (not (null? l))
          (let* ((b (car (car l))) (i (cadr (car l))) (j (caddr (car l)))
                 (prod (sos-pmul (car (nth blocks b)) (sos-pmul (vref (nth bases b) i) (vref (nth bases b) j))))
                 (w (if (= i j) 1 2)))
            (for-each (lambda (tg)
                        (hash-set! h (car tg) (cons (cons v (* (cdr tg) w)) (hash-ref h (car tg) '()))))
                      prod)
            (fill (cdr l) (+ v 1)))
          0))
    (if (not (every? (lambda (t) (hash-has? h (car t))) P))
        #f
        (let* ((keys (hash-keys h))
               (nr (length keys))
               (ents (list->vector (map (lambda (k) (hash-ref h k '())) keys)))
               (rhs (list->vector (map (lambda (k) (let ((t (assoc k P))) (if t (cdr t) 0))) keys)))
               (w (list->vector (map (lambda (x) (if (= (cadr x) (caddr x)) 1 2)) vl)))
               (vcols (make-vector nv '()))
               (G (make-vector nr 0)))
          (for-each (lambda (r)
                      (for-each (lambda (va) (vset! vcols (car va) (cons (cons r (cdr va)) (vref vcols (car va)))))
                                (vref ents r))
                      (vset! G r (make-vector nr 0)))
                    (range nr))
          (for-each (lambda (v)
                      (let ((col (vref vcols v)) (wv (vref w v)))
                        (for-each (lambda (ra)
                                    (for-each (lambda (sb)
                                                (let ((row (vref G (car ra))))
                                                  (vset! row (car sb) (+ (vref row (car sb)) (/ (* (cdr ra) (cdr sb)) wv)))))
                                              col))
                                  col)))
                    (range nv))
          (let ((diag (every? (lambda (r) (every? (lambda (s) (or (= r s) (= (vref (vref G r) s) 0))) (range nr))) (range nr))))
            (vector (map (lambda (x) x) vl) ents rhs vcols w G
                    (list->vector (map (lambda (row) (list->vector (map (lambda (x) (* 1.0 x)) (vector->list row)))) (vector->list G)))
                    diag blocks sizes nr))))))

(define (sos-st-nv st) (vlength (vref st 4)))

; Гаусс: G — вектор векторов n×n, b — вектор; свободные неизвестные = 0. exact? — точная арифметика, иначе допуск 1e-11
(define (sos-gauss G b n exact?)
  (let ((M (list->vector (map (lambda (r) (list->vector (append (vector->list (vref G r)) (list (vref b r))))) (range n))))
        (zero? (lambda (x) (if exact? (= x 0) (< (sos-fabs x) 1e-11)))))
    (let loop ((c 0) (r 0) (pivs '()))
      (if (or (= c n) (= r n))
          ; обратный ход
          (let ((x (make-vector n (if exact? 0 0.0))))
            (for-each (lambda (pc)   ; pc = (row . col), по убыванию row
                        (let* ((row (vref M (car pc)))
                               (s (foldl (lambda (acc j) (+ acc (* (vref row j) (vref x j)))) 0 (sos-range (+ (cdr pc) 1) n))))
                          (vset! x (cdr pc) (/ (- (vref row n) s) (vref row (cdr pc))))))
                      pivs)
            x)
          (let ((best (let find ((i r) (bi #f) (bv 0))
                        (if (= i n) bi
                            (let ((a (sos-fabs (vref (vref M i) c))))
                              (if (and (not (zero? a)) (or (not bi) (and (not exact?) (> a bv))))
                                  (find (+ i 1) i a)
                                  (find (+ i 1) bi bv)))))))
            (if (not best)
                (loop (+ c 1) r pivs)
                (let ((tmp (vref M r)))
                  (vset! M r (vref M best))
                  (vset! M best tmp)
                  (let ((pr (vref M r)))
                    (for-each (lambda (i)
                                (let* ((row (vref M i)) (f (/ (vref row c) (vref pr c))))
                                  (if (not (zero? f))
                                      (for-each (lambda (j) (vset! row j (- (vref row j) (* f (vref pr j))))) (sos-range c (+ n 1)))
                                      0)))
                              (sos-range (+ r 1) n)))
                  (loop (+ c 1) (+ r 1) (cons (cons r c) pivs)))))))))

; проекция q (вектор) на {A q = b} в норме Фробениуса; exact? — рациональная арифметика
(define (sos-aff-proj st q exact?)
  (let* ((ents (vref st 1)) (rhs (vref st 2)) (vcols (vref st 3)) (w (vref st 4))
         (nr (vref st 10)) (nv (vlength w))
         (res (make-vector nr 0)))
    (for-each (lambda (r)
                (vset! res r (- (foldl (lambda (acc va) (+ acc (* (cdr va) (vref q (car va))))) 0 (vref ents r))
                                (vref rhs r))))
              (range nr))
    (let ((mu (if (vref st 7)
                  (let ((m (make-vector nr 0)) (G (if exact? (vref st 5) (vref st 6))))
                    (for-each (lambda (r)
                                (let ((g (vref (vref G r) r)))
                                  (vset! m r (if (= g 0) 0 (/ (vref res r) g)))))
                              (range nr))
                    m)
                  (sos-gauss (if exact? (vref st 5) (vref st 6)) res nr exact?)))
          (out (make-vector nv 0)))
      (for-each (lambda (v)
                  (vset! out v (- (vref q v)
                                  (/ (foldl (lambda (acc ra) (+ acc (* (cdr ra) (vref mu (car ra))))) 0 (vref vcols v))
                                     (vref w v)))))
                (range nv))
      out)))

; точная допустимость: A q = b
(define (sos-feasible? st q)
  (let ((ents (vref st 1)) (rhs (vref st 2)))
    (every? (lambda (r) (= (foldl (lambda (acc va) (+ acc (* (cdr va) (vref q (car va))))) 0 (vref ents r)) (vref rhs r)))
            (range (vref st 10)))))

; блоки матриц из вектора q: список векторов векторов
(define (sos-fill-mats st q zero)
  (let* ((sizes (vref st 9))
         (mats (map (lambda (n) (list->vector (map (lambda (i) (make-vector n zero)) (range n)))) sizes)))
    (let fill ((l (vref st 0)) (v 0))
      (if (not (null? l))
          (let ((b (car (car l))) (i (cadr (car l))) (j (caddr (car l))))
            (vset! (vref (nth mats b) i) j (vref q v))
            (vset! (vref (nth mats b) j) i (vref q v))
            (fill (cdr l) (+ v 1)))
          mats))))

; вектор q из матриц (верхний треугольник)
(define (sos-mats->q st mats)
  (list->vector (map (lambda (x) (vref (vref (nth mats (car x)) (cadr x)) (caddr x))) (vref st 0))))

; точная проверка: округление q до 2^-k, точная проекция, LDL всех блоков → список LDL по блокам или #f
(define (sos-round-vec q k)
  (let ((pw (sos-ipow 2 k)))
    (list->vector (map (lambda (x) (/ (floor (+ (* x pw) 0.5)) pw)) (vector->list q)))))
(define (sos-try-exact st qr)
  (let ((qe (sos-aff-proj st qr #t)))
    (if (sos-feasible? st qe)
        (let ((ls (map (lambda (M) (sos-ldl (sos-mat-lists M))) (sos-fill-mats st qe 0))))
          (if (every? (lambda (x) x) ls) ls #f))
        #f)))
(define (sos-try-q st qf ks)
  (cond ((null? ks) #f)
        (else (let ((r (sos-try-exact st (sos-round-vec qf (car ks)))))
                (if r r (sos-try-q st qf (cdr ks)))))))

; чередующиеся проекции на {λ_min ≥ eps} и аффинное подпространство; возвращает q (double) или #f
(define (sos-ap st q0 eps iters)
  (let loop ((q q0) (k 0))
    (let* ((mats (sos-fill-mats st q 0.0))
           (dec (map (lambda (M) (let* ((n (vlength M)) (A (sos-copy-mat M)) (V (sos-jacobi! A n))) (list A V n))) mats))
           (mn (sos-max-list (map (lambda (d) (- 0 (sos-min-diag (car d) (caddr d)))) dec))))
      (cond ((>= (- 0 mn) (* 0.5 eps)) (cons #t q))
            ((>= k iters) (cons #f q))
            (else
             (let* ((cm (map (lambda (d) (sos-cone-mat (car d) (cadr d) (caddr d) eps)) dec)))
               (loop (sos-aff-proj st (sos-mats->q st cm) #f) (+ k 1))))))))
(define (sos-min-diag A n)
  (foldl (lambda (m i) (let ((x (vref (vref A i) i))) (if (< x m) x m))) (vref (vref A 0) 0) (range n)))
(define (sos-cone-mat A V n eps)
  (let ((lam (map (lambda (i) (let ((x (vref (vref A i) i))) (if (< x eps) eps x))) (range n)))
        (M (list->vector (map (lambda (i) (make-vector n 0.0)) (range n)))))
    (for-each (lambda (i)
                (for-each (lambda (j)
                            (vset! (vref M i) j
                                   (foldl (lambda (s k) (+ s (* (nth lam k) (vref (vref V i) k) (vref (vref V j) k)))) 0.0 (range n))))
                          (range n)))
              (range n))
    M))

(define (sos-pmax P) (if (null? P) 1 (+ 1 (sos-max-list (map (lambda (t) (let ((c (cdr t))) (if (< c 0) (- 0 c) c))) P)))))

; поиск точного Грама: список LDL по блокам или #f
(define (sos-gram-search st P)
  (let* ((nv (sos-st-nv st))
         (scale (* 1.0 (sos-pmax P)))
         (q0 (sos-aff-proj st (make-vector nv 0.0) #f))
         (r0 (sos-try-q st q0 '(0 2 5 12))))
    (if r0
        r0
        (let ((qi (sos-aff-proj st (sos-mats->q st (map (lambda (n) (sos-scaled-id n scale)) (vref st 9))) #f)))
          (let ((r1 (sos-try-q st qi '(0 2 5 12))))
            (if r1
                r1
                (sos-ap-schedule st qi (list (* 0.1 scale) (* 0.01 scale) (* 0.001 scale)))))))))
(define (sos-scaled-id n s)
  (list->vector (map (lambda (i) (list->vector (map (lambda (j) (if (= i j) s 0.0)) (range n)))) (range n))))
(define (sos-ap-schedule st q0 epss)
  (if (null? epss)
      #f
      (let* ((res (sos-ap st q0 (car epss) 80)) (q (cdr res)))
        (let ((r (if (car res) (sos-try-q st q '(3 6 10 16 26)) #f)))
          (if r r (sos-ap-schedule st q (cdr epss)))))))

; LDL → члены (c q) по блокам; базис блока — список многочленов
(define (sos-ldl->terms ldls blocks vars)
  (map2 (lambda (ldl b)
          (let ((mons (map (lambda (m) (sos-p->expr m vars)) (cadr b))))
            (map (lambda (dl) (list (car dl) (sos-lin-expr (cdr dl) mons))) ldl)))
        ldls blocks))

; ---------- редукция грани: ядро численного решения → новый базис ----------

(define (sos-pick-pivot rows c tol)
  (let loop ((i 0) (l rows) (best #f) (bv 0))
    (if (null? l)
        best
        (let ((a (sos-fabs (nth (car l) c))))
          (cond ((= tol 0) (if (= a 0) (loop (+ i 1) (cdr l) best bv) i))
                ((and (> a tol) (> a bv)) (loop (+ i 1) (cdr l) i a))
                (else (loop (+ i 1) (cdr l) best bv)))))))
; приведённая ступенчатая форма: список (столбец-ведущий . строка); tol = 0 — точная арифметика
(define (sos-rref rows ncols tol)
  (let loop ((rows rows) (c 0) (done '()))
    (if (or (= c ncols) (null? rows))
        done
        (let ((pidx (sos-pick-pivot rows c tol)))
          (if (not pidx)
              (loop rows (+ c 1) done)
              (let* ((pv (nth rows pidx))
                     (pr (map (lambda (a) (/ a (nth pv c))) pv))
                     (others (append (take rows pidx) (drop rows (+ pidx 1))))
                     (sub (lambda (r) (let ((f (nth r c))) (map2 (lambda (a b) (- a (* f b))) r pr)))))
                (loop (map sub others) (+ c 1)
                      (cons (cons c pr) (map (lambda (d) (cons (car d) (sub (cdr d)))) done)))))))))
(define (sos-nullspace-exact rows ncols)
  (let* ((rr (sos-rref rows ncols 0))
         (pivs (map car rr)))
    (map (lambda (f)
           (map (lambda (i)
                  (cond ((= i f) 1)
                        ((member? i pivs) (- 0 (nth (cdr (assoc i rr)) f)))
                        (else 0)))
                (range ncols)))
         (filter (lambda (j) (not (member? j pivs))) (range ncols)))))
(define (sos-rationalize x)
  (let loop ((d 1))
    (let ((r (/ (floor (+ (* x d) 0.5)) d)))
      (if (or (> d 40) (< (sos-fabs (- x (* 1.0 r))) 0.004)) r (loop (+ d 1))))))
(define (sos-lincomb-poly coefs polys)
  (foldl (lambda (acc cp) (sos-padd acc (sos-pscale (cdr cp) (car cp)))) '() (map2 cons coefs polys)))

; новый базис (список многочленов) по ядру: собственные векторы Q* с λ < tau
(define (sos-kernel-basis A V n tau polys)
  (let* ((ks (filter (lambda (k) (< (vref (vref A k) k) tau)) (range n))))
    (if (or (null? ks) (= (length ks) n))
        #f
        (let* ((rows (map (lambda (k) (map (lambda (i) (vref (vref V i) k)) (range n))) ks))
               (rr (sos-rref rows n 1e-4))
               (kr (map (lambda (d) (map sos-rationalize (cdr d))) rr))
               (ns (sos-nullspace-exact kr n)))
          (if (or (null? ns) (>= (length ns) n))
              #f
              (map (lambda (v) (sos-lincomb-poly v polys)) ns))))))

(define (sos-try-kernels st P blocks vars depth)
  (let* ((nv (sos-st-nv st))
         (res (sos-ap st (sos-aff-proj st (make-vector nv 0.0) #f) 1e-9 400))
         (M (car (sos-fill-mats st (cdr res) 0.0)))   ; один блок
         (n (vlength M))
         (A (sos-copy-mat M))
         (V (sos-jacobi! A n))
         (lmax (sos-max-list (map (lambda (k) (vref (vref A k) k)) (range n)))))
    (let loop ((fs '(0.1 0.01 0.001)) (seen '()))
      (if (null? fs)
          #f
          (let ((nb (sos-kernel-basis A V n (* (car fs) lmax) (cadr (car blocks)))))
            (if (or (not nb) (member? nb seen))
                (loop (cdr fs) seen)
                (let ((r (sos-gram-rec P (list (list (car (car blocks)) nb)) vars (+ depth 1))))
                  (if r r (loop (cdr fs) (cons nb seen))))))))))

; P (разреженный) и блоки (g базис-многочленов) → члены по блокам или #f
(define (sos-gram-solve P blocks vars) (sos-gram-rec P blocks vars 0))
(define (sos-gram-rec P blocks vars depth)
  (let ((st (sos-gram-setup P blocks)))
    (if (not st)
        #f
        (let ((r (sos-gram-search st P)))
          (cond (r (sos-ldl->terms r blocks vars))
                ((or (>= depth 3) (not (= (length blocks) 1))) #f)
                (else (sos-try-kernels st P blocks vars depth)))))))

; ---------- проверка сертификатов ----------

(define (sos-sum-sq terms)
  (if (null? terms) 0 (cons '+ (map (lambda (t) (list '* (car t) (list '^ (cadr t) 2))) terms))))
(define (sos-terms-ok? terms)
  (and (list? terms)
       (every? (lambda (t) (and (list? t) (= (length t) 2) (sos-rat-cert? (car t)) (not (contains-sym? (cadr t) '%i)))) terms)))
(define (sos-zero-diff? p s)
  (equal? (simplify (expand (list '+ p (list '* -1 s)))) 0))
(define (sos-nat? k) (and (integer? k) (>= k 0)))

(define (sos-check-on p x a b blocks)
  (and (sos-rat? a) (sos-rat? b) (< a b) (list? blocks)
       (every? (lambda (bl) (and (list? bl) (>= (length bl) 2) (sos-nat? (car bl)) (sos-nat? (cadr bl))
                                 (sos-terms-ok? (cddr bl))))
               blocks)
       (sos-zero-diff?
        p
        (cons '+ (map (lambda (bl)
                        (list '* (list '^ (list '+ x (- 0 a)) (car bl)) (list '^ (list '+ b (list '* -1 x)) (cadr bl))
                              (sos-sum-sq (cddr bl))))
                      blocks)))))

(define (sos-all-even? e) (every? (lambda (k) (and (sos-nat? k) (= (modulo k 2) 0))) e))
(define (sos-vec-sum rows n)
  (foldl (lambda (acc r) (map2 + acc r)) (sos-zeros n) rows))

(define (sos-item-ok? it P n)
  (and (list? it) (= (length it) 3) (sos-rat-cert? (car it))
       (list? (cadr it)) (= (length (cadr it)) n) (every? sos-nat? (cadr it))
       (let ((t (assoc (cadr it) P)))
         (and t (= (cdr t) (- 0 (car it)))))
       (let ((ws (caddr it)))
         (and (list? ws) (not (null? ws))
              (every? (lambda (wa) (and (list? wa) (= (length wa) 2) (sos-rat-cert? (car wa))
                                        (list? (cadr wa)) (= (length (cadr wa)) n)
                                        (sos-all-even? (cadr wa))))
                      ws)
              (= (foldl + 0 (map car ws)) 1)
              (equal? (sos-vec-sum (map (lambda (wa) (map (lambda (k) (* (car wa) k)) (cadr wa))) ws) n)
                      (cadr it))))))

(define (sos-check-amgm P items n)
  (let ((neg (filter (lambda (t) (< (cdr t) 0)) P))
        (pos (filter (lambda (t) (> (cdr t) 0)) P)))
    (and (list? items)
         (every? (lambda (t) (sos-all-even? (car t))) pos)
         (= (length items) (length neg))
         (every? (lambda (it) (sos-item-ok? it P n)) items)
         (every? (lambda (t) (= (length (filter (lambda (it) (equal? (cadr it) (car t))) items)) 1)) neg)
         (let ((use (foldl (lambda (acc it)
                             (foldl (lambda (acc2 wa) (sos-padd-term acc2 (cadr wa) (* (car it) (car wa)))) acc (caddr it)))
                           '() items)))
           (every? (lambda (u) (let ((t (assoc (car u) P))) (and t (> (cdr t) 0) (<= (cdr u) (cdr t))))) use)))))

; (sos-check p vars cert) → #t/#f; vars — символ или список
(define (sos-check p vars cert)
  (let ((vs (if (symbol? vars) (list vars) vars)))
    (try
     (cond ((not (pair? cert)) #f)
           ((equal? (car cert) 'sos)
            (and (sos-terms-ok? (cdr cert)) (sos-zero-diff? p (sos-sum-sq (cdr cert)))))
           ((equal? (car cert) 'sos-on)
            (and (= (length vs) 1) (>= (length cert) 3)
                 (sos-check-on p (car vs) (cadr cert) (caddr cert) (cdr (cddr cert)))))
           ((equal? (car cert) 'amgm)
            (sos-check-amgm (sos-parse p vs) (cdr cert) (length vs)))
           (else #f))
     (lambda (e) #f))))

; ---------- AM-GM ----------

; LP: u_{t,a} ≥ 0 — доля положительного члена a, отданная отрицательному t. → сертификат (amgm ...) или #f
(define (sos-amgm-find P n)
  (let ((neg (filter (lambda (t) (< (cdr t) 0)) P))
        (pos (filter (lambda (t) (> (cdr t) 0)) P)))
    (cond ((not (every? (lambda (t) (sos-all-even? (car t))) pos)) #f)
          ((null? neg) '(amgm))
          ((null? pos) #f)
          (else (sos-amgm-lp neg pos n)))))
(define (sos-amgm-lp neg pos n)
  (let* ((nt (length neg)) (np (length pos)) (nvar (* nt np))
         (row (lambda (pairs)
                (let ((v (make-vector nvar 0)))
                  (for-each (lambda (p) (vset! v (car p) (cdr p))) pairs)
                  (vector->list v))))
         (rows
          (append
           (append-map
            (lambda (ti)
              (let ((c (- 0 (cdr (nth neg ti)))) (e (car (nth neg ti))))
                (cons (list (row (map (lambda (ai) (cons (+ (* ti np) ai) 1)) (range np))) '= c)
                      (map (lambda (d)
                             (list (row (map (lambda (ai) (cons (+ (* ti np) ai) (nth (car (nth pos ai)) d))) (range np)))
                                   '= (* c (nth e d))))
                           (range n)))))
            (range nt))
           (map (lambda (ai)
                  (list (row (map (lambda (ti) (cons (+ (* ti np) ai) 1)) (range nt))) '<= (cdr (nth pos ai))))
                (range np))))
         (ans (lp-solve 'max (sos-zeros nvar) rows)))
    (if (equal? (car ans) 'optimal)
        (let ((x (cadr ans)))
          (cons 'amgm
                (map (lambda (ti)
                       (let ((c (- 0 (cdr (nth neg ti)))))
                         (list c (car (nth neg ti))
                               (filter (lambda (y) y)
                                       (map (lambda (ai)
                                              (let ((u (nth x (+ (* ti np) ai))))
                                                (if (> u 0) (list (/ u c) (car (nth pos ai))) #f)))
                                            (range np))))))
                     (range nt))))
        #f)))

; ---------- одна переменная ----------

; factor → (k (f . m) ...)
(define (sos-fparse e)
  (let ((args (if (and (pair? e) (equal? (car e) '*)) (cdr e) (list e))))
    (foldl (lambda (acc a)
             (cond ((number? a) (cons (* (car acc) a) (cdr acc)))
                   ((and (pair? a) (equal? (car a) '^) (integer? (caddr a)))
                    (cons (car acc) (append (cdr acc) (list (cons (cadr a) (caddr a))))))
                   (else (cons (car acc) (append (cdr acc) (list (cons a 1)))))))
           (cons 1 '()) args)))
(define (sos-coefs e x) (coefficients (expand e) x))
(define (sos-horner cs q) (foldl (lambda (acc c) (+ (* acc q) c)) 0 (reverse cs)))
(define (sos-gap-points ivs)
  (if (null? ivs)
      (list 0)
      (append (list (- (iv-lo (car ivs)) 1))
              (map2 (lambda (a b) (/ (+ (iv-hi a) (iv-lo b)) 2)) (butlast ivs) (cdr ivs))
              (list (+ (iv-hi (last ivs)) 1)))))

; p ≥ 0 на ℝ? → #t или (точка значение), где p < 0 (между корнями знак постоянен: по точке на промежуток)
(define (sos-univ-test p x)
  (let ((cs (sos-coefs p x)))
    (if (or (null? cs) (null? (cdr cs)))
        (let ((c (if (null? cs) 0 (car cs)))) (if (< c 0) (list 0 c) #t))
        (let* ((fp (sos-fparse (factor p)))
               (s (expand (simplify (cons '* (map car (cdr fp))))))
               (ivs (sort (isolate-roots s x) (lambda (a b) (< (iv-lo a) (iv-lo b)))))
               (vals (map (lambda (q) (cons q (sos-horner cs q))) (sos-gap-points ivs)))
               (neg (filter (lambda (qv) (< (cdr qv) 0)) vals)))
          (if (null? neg) #t (list (car (car neg)) (cdr (car neg))))))))

(define (sos-basis-1d n) (map (lambda (k) (list (cons (list k) 1))) (range (+ n 1))))
(define (sos-prod-expr fs) (if (null? fs) 1 (simplify (cons '* fs))))
(define (sos-odd-deg? P) (= (modulo (sos-deg P) 2) 1))

; сертификат (sos ...) для p ≥ 0 на ℝ (знак уже проверен): p = k·A²·B, B без вещественных корней — Грам
(define (sos-univ-cert p x)
  (let* ((fp (sos-fparse (factor p))) (k (car fp)) (facs (cdr fp))
         (real? (lambda (fm) (not (null? (isolate-roots (car fm) x)))))
         (ra (filter real? facs))
         (rb (filter (lambda (fm) (not (real? fm))) facs)))
    (if (not (every? (lambda (fm) (= (modulo (cdr fm) 2) 0)) ra))
        #f
        (let* ((A (sos-prod-expr (map (lambda (fm) (list '^ (car fm) (/ (cdr fm) 2))) ra)))
               (R (expand (simplify (cons '* (cons k (map (lambda (fm) (list '^ (car fm) (cdr fm))) rb))))))
               (RP (sos-parse R (list x))))
          (cond ((null? RP) '(sos))
                ((sos-odd-deg? RP) #f)
                (else
                 (let ((terms (sos-gram-solve RP (list (list (sos-pone 1) (sos-basis-1d (quotient (sos-deg RP) 2)))) (list x))))
                   (if terms
                       (cons 'sos (map (lambda (t) (list (car t) (expand (list '* A (cadr t))))) (car terms)))
                       #f))))))))

(define (sos-prove-univ p x)
  (let ((t (sos-univ-test p x)))
    (if (pair? t)
        (list 'counterexample (list (list x (car t))) (cadr t))
        (let ((cert (sos-univ-cert p x)))
          (if (and cert (sos-check p (list x) cert)) (list 'proved cert) 'unknown)))))

; ---------- отрезок [a, b] ----------

; q(u) = (1+u²)^d · p(a + (b−a)·u²/(1+u²)) — многочлен от u (разреженный, 1 переменная); p ≥ 0 на [a,b) ⇔ q ≥ 0 на ℝ
(define (sos-interval-poly P a b)
  (let* ((d (sos-deg P))
         (U (list (cons (list 2) 1)))
         (lin (sos-padd (list (cons (list 0) a)) (sos-pscale U b)))
         (den (sos-padd (list (cons (list 0) 1)) U)))
    (foldl (lambda (acc t)
             (let ((i (car (car t))))
               (sos-padd acc (sos-pscale (sos-pmul (sos-ppow lin i 1) (sos-ppow den (- d i) 1)) (cdr t)))))
           '() P)))

; f линейный с f(r) = 0 → старший коэффициент, иначе #f
(define (sos-lin-root f x r)
  (let ((P (sos-parse f (list x))))
    (if (and (= (sos-deg P) 1) (= (sos-eval P (list r)) 0)) (car (reverse (sos-coefs f x))) #f)))

; разбор множителей p на [a, b]: (скаляр ma mb A-множители нечётные-множители)
(define (sos-on-split p x a b)
  (foldl (lambda (acc fm)
           (let* ((f (car fm)) (m (cdr fm))
                  (la (sos-lin-root f x a)) (lb (if la #f (sos-lin-root f x b))))
             (cond (la (list (* (car acc) (sos-ipow la m)) (+ (cadr acc) m) (caddr acc) (nth acc 3) (nth acc 4)))
                   (lb (list (* (car acc) (sos-ipow (- 0 lb) m)) (cadr acc) (+ (caddr acc) m) (nth acc 3) (nth acc 4)))
                   (else (list (car acc) (cadr acc) (caddr acc)
                               (if (>= m 2) (cons (list '^ f (quotient m 2)) (nth acc 3)) (nth acc 3))
                               (if (= (modulo m 2) 1) (cons f (nth acc 4)) (nth acc 4)))))))
         (list (car (sos-fparse (factor p))) 0 0 '() '())
         (cdr (sos-fparse (factor p)))))

(define (sos-on-cert p x a b)
  (let* ((st (sos-on-split p x a b))
         (ma (cadr st)) (mb (caddr st))
         (A (sos-prod-expr (nth st 3)))
         (s (expand (simplify (cons '* (cons (car st) (nth st 4))))))
         (SP (sos-parse s (list x)))
         (mid (/ (+ a b) 2)))
    (if (or (null? SP) (<= (sos-eval SP (list mid)) 0))
        #f
        (let* ((d (sos-deg SP)) (n (quotient d 2))
               (ga (sos-parse (list '+ x (- 0 a)) (list x)))
               (gb (sos-parse (list '+ b (list '* -1 x)) (list x)))
               (one (sos-pone 1))
               (spec (if (= (modulo d 2) 0)
                         (if (= n 0)
                             (list (list one (sos-basis-1d 0) 0 0))
                             (list (list one (sos-basis-1d n) 0 0) (list (sos-pmul ga gb) (sos-basis-1d (- n 1)) 1 1)))
                         (list (list ga (sos-basis-1d n) 1 0) (list gb (sos-basis-1d n) 0 1))))
               (terms (sos-gram-solve SP (map (lambda (sp) (list (car sp) (cadr sp))) spec) (list x))))
          (if terms
              (cons 'sos-on
                    (cons a (cons b
                                  (map2 (lambda (ts sp)
                                          (cons (+ ma (nth sp 2))
                                                (cons (+ mb (nth sp 3))
                                                      (map (lambda (t) (list (car t) (expand (list '* A (cadr t))))) ts))))
                                        terms spec))))
              #f)))))

(define (sos-prove-on p x a b)
  (if (not (and (sos-rat? a) (sos-rat? b) (< a b)))
      (error "prove-nonneg-on: концы должны быть рациональными, a < b")
      (let ((P (sos-parse p (list x))))
        (if (null? P)
            (list 'proved (list 'sos-on a b))
            (let* ((q (sos-interval-poly P a b))
                   (t (sos-univ-test (sos-p->expr q (list 'sosu)) 'sosu)))
              (if (pair? t)
                  (let* ((u (car t)) (x0 (+ a (/ (* (- b a) u u) (+ 1 (* u u))))) (v (sos-eval P (list x0))))
                    (if (< v 0) (list 'counterexample (list (list x x0)) v) 'unknown))
                  (let ((cert (sos-on-cert p x a b)))
                    (if (and cert (sos-check p (list x) cert)) (list 'proved cert) 'unknown))))))))

; ---------- несколько переменных ----------

(define (sos-grid vals n)
  (if (= n 0)
      (list '())
      (let ((rest (sos-grid vals (- n 1))))
        (append-map (lambda (v) (map (lambda (r) (cons v r)) rest)) vals))))
; точка с P < 0 на небольшой сетке → (точка . значение) или #f
(define (sos-sample-neg P n)
  (if (> n 6)
      #f
      (let ((vals (cond ((<= n 2) '(0 1 -1 2 -2 1/2 -1/2 3 -3 1/3))
                        ((= n 3) '(0 1 -1 2 -2 1/2))
                        ((= n 4) '(0 1 -1 2))
                        (else '(0 1 -1)))))
        (foldl (lambda (acc pt)
                 (let ((v (sos-eval P pt)))
                   (if (and (< v 0) (or (not acc) (< v (cdr acc)))) (cons pt v) acc)))
               #f (sos-grid vals n)))))

(define (sos-monos-upto n d)
  (if (= n 0)
      (list '())
      (append-map (lambda (k) (map (lambda (r) (cons k r)) (sos-monos-upto (- n 1) (- d k)))) (range (+ d 1)))))
(define (sos-ceil2 k) (quotient (+ k 1) 2))
(define (sos-min-list l) (foldl (lambda (a x) (if (< x a) x a)) (car l) (cdr l)))
; 2m ∈ выпуклая оболочка носителя? (LP над ℚ)
(define (sos-in-hull? e supp n)
  (let* ((ns (length supp))
         (rows (cons (list (map (lambda (s) 1) supp) '= 1)
                     (map (lambda (d) (list (map (lambda (s) (nth s d)) supp) '= (* 2 (nth e d)))) (range n))))
         (ans (lp-solve 'max (sos-zeros ns) rows)))
    (equal? (car ans) 'optimal)))
; базис из половинного многогранника Ньютона: коробка по степеням + LP
(define (sos-newton-basis P n)
  (let* ((supp (map car P))
         (D (sos-deg P))
         (mind (sos-min-list (map (lambda (e) (foldl + 0 e)) supp)))
         (los (map (lambda (d) (sos-ceil2 (sos-min-list (map (lambda (e) (nth e d)) supp)))) (range n)))
         (his (map (lambda (d) (quotient (sos-max-list (map (lambda (e) (nth e d)) supp)) 2)) (range n)))
         (cand (filter (lambda (m) (and (every? (lambda (k) k) (map2 (lambda (k lo) (>= k lo)) m los))
                                        (every? (lambda (k) k) (map2 (lambda (k hi) (<= k hi)) m his))
                                        (>= (foldl + 0 m) (sos-ceil2 mind))))
                       (sos-monos-upto n (quotient D 2)))))
    (if (= n 1) cand (filter (lambda (m) (sos-in-hull? m supp n)) cand))))


(define (sos-gram-multi P vars)
  (let ((n (length vars)))
    (if (sos-odd-deg? P)
        #f
        (let ((basis (map (lambda (e) (list (cons e 1))) (sos-newton-basis P n))))
          (if (null? basis)
              #f
              (let ((r (sos-gram-solve P (list (list (sos-pone n) basis)) vars)))
                (if r (car r) #f)))))))

(define (sos-gram-cert P vars)
  (let ((terms (sos-gram-multi P vars))) (if terms (cons 'sos terms) #f)))

(define (sos-prove-multi p vs how)
  (let* ((n (length vs)) (P (sos-parse p vs)))
    (if (null? P)
        (list 'proved '(sos))
        (let ((ce (if (equal? how 'all) (sos-sample-neg P n) #f)))
          (if ce
              (list 'counterexample (map2 list vs (car ce)) (cdr ce))
              (let ((a (if (or (equal? how 'all) (equal? how 'amgm)) (sos-amgm-find P n) #f)))
                (if (and a (sos-check p vs a))
                    (list 'proved a)
                    (let ((g (if (or (equal? how 'all) (equal? how 'gram)) (sos-gram-cert P vs) #f)))
                      (if (and g (sos-check p vs g)) (list 'proved g) 'unknown)))))))))

(define (sos-prove p vars how)
  (let ((vs (if (symbol? vars) (list vars) vars)))
    (cond ((null? vs) (error "prove-nonneg: нужна хотя бы одна переменная"))
          ((and (= (length vs) 1) (not (equal? how 'amgm))) (sos-prove-univ p (car vs)))
          (else (sos-prove-multi p vs how)))))

; шаги (ST.3г-2): метод, разложение, проверка подстановкой
(define (sos-note p vars r how)
  (if (step-log-enabled?)
      (cond ((and (pair? r) (equal? (car r) 'proved))
             (begin
               (record-step 'sos-method "Метод доказательства"
                            (string-append how ": разложение найдено") p (car r) 'main)
               (record-step 'sos-decomposition "Разложение в сумму квадратов"
                            "Σ cᵢ·qᵢ²: коэффициенты и многочлены qᵢ — в сертификате" p (cadr r) 'main)
               (record-step 'sos-check "Проверка разложения"
                            (if (sos-check p vars (cadr r))
                                "Σ развёрнута и сравнена с исходным: тождество"
                                "разложение не совпало с исходным")
                            (cadr r) (sos-check p vars (cadr r)) 'main)))
            ((and (pair? r) (equal? (car r) 'counterexample))
             (record-step 'sos-refuse "Доказательство не найдено"
                          "найдена точка с отрицательным значением" p r 'main))
            (else
             (record-step 'sos-refuse "Доказательство не найдено"
                          "ни матрица Грама, ни AM-GM не дали разложения" p r 'main))))
  #t)

; (prove-nonneg p vars) → (proved cert) | (counterexample ((x v) ...) значение) | unknown
(define (prove-nonneg p vars)
  (let ((r (call-quietly (lambda () (try (sos-prove p vars 'all) (lambda (e) 'unknown))))))
    (sos-note p vars r "матрица Грама / AM-GM")
    r))
; только матрица Грама / только AM-GM
(define (sos-decompose p vars)
  (let ((r (call-quietly (lambda () (try (sos-prove p vars 'gram) (lambda (e) 'unknown))))))
    (sos-note p vars r "матрица Грама")
    r))
(define (sos-amgm p vars) (try (sos-prove p vars 'amgm) (lambda (e) 'unknown)))
; (prove-nonneg-on p x a b): p ≥ 0 на [a, b] (рациональные концы)
(define (prove-nonneg-on p x a b) (try (sos-prove-on p x a b) (lambda (e) 'unknown)))
